@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixCollapsibleTrigger
@if (TriggerTemplate is not null)
{
    @TriggerTemplate(CreateTriggerContext())
}
else
{
    <button @ref="_element"
        @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
        @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
        @attributes="TriggerAttributes">
        @ChildContent
    </button>
}

@code {
    [Parameter] public RenderFragment<BradixTriggerContext>? TriggerTemplate { get; set; }
    [Parameter] public EventCallback<BradixActivationEventArgs> OnActivate { get; set; }

    private BradixTriggerContext CreateTriggerContext() => new(TriggerAttributes,
        EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick), CaptureTrigger, _element, EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown));

    private void CaptureTrigger(ElementReference element)
    {
        _element = element;
    }


    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _element;

    [CascadingParameter]
    internal BradixCollapsible Collapsible { get; set; } = null!;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public string? AriaDisabled { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    internal ElementReference Element => _element;

    private bool IsDisabled => Collapsible.Disabled || Disabled;

    private Dictionary<string, object> TriggerAttributes => BuildAttributes(
        ("type", "button"),
        ("id", Collapsible.TriggerId),
        ("aria-controls", Collapsible.ContentId),
        ("aria-expanded", Collapsible.IsOpen ? "true" : "false"),
        ("aria-disabled", AriaDisabled),
        ("data-state", BradixDataStates.Open(Collapsible.IsOpen)),
        ("data-disabled", IsDisabled ? string.Empty : null),
        ("disabled", IsDisabled ? BradixAttributeValues.True : null));

    internal ValueTask Focus()
    {
        return _element.FocusAsync();
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (IsDisabled) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(args);
        if (IsDisabled) return;

        if (OnActivate.HasDelegate)
        {
            var activation = new BradixActivationEventArgs(args);
            await OnActivate.InvokeAsync(activation);
            if (activation.DefaultPrevented) return;
        }
        if (IsDisabled) return;
        await Collapsible.Toggle();
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => OnKeyDown.InvokeAsync(args);
}
