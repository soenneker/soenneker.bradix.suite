@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixContentElement

@implements IBradixScrollAreaScrollbar

@inject IScrollAreaInterop ScrollAreaInterop

@if (ScrollArea.ShouldRenderScrollbar(Orientation.Value, ForceMount))
{
    <CascadingValue Value="this">
        <div @ref="_scrollbar"
             @onpointerenter="(_cachedHandlePointerEnterDelegate ??= HandlePointerEnter)"
             @onpointerleave="(_cachedHandlePointerLeaveDelegate ??= HandlePointerLeave)"
             @attributes="ScrollbarAttributes">
            @ChildContent
        </div>
    </CascadingValue>
}

@code {
    private string? _mergedStyleCache0;

    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerEnterDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerLeaveDelegate;

    private ElementReference _scrollbar;
    private ElementReference _thumb;
    private bool _hasThumb;
    private DotNetObjectReference<object>? _dotNetReference;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;
    private ValueAtomicBool _registrationDirty = new(true);
    private string? _contextOrientation;
    private string? _registeredOrientation;
    private string? _registeredDirection;

    [CascadingParameter]
    internal BradixScrollArea ScrollArea { get; set; } = null!;

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    [Parameter]
    public bool ForceMount { get; set; }

    protected override void OnParametersSet()
    {
        if (_contextOrientation is not null && _contextOrientation != Orientation.Value)
            ScrollArea.UnregisterScrollbar(_contextOrientation);

        _contextOrientation = Orientation.Value;
        ScrollArea.RegisterScrollbar(Orientation.Value, ForceMount);

        if (!string.Equals(_registeredOrientation, Orientation.Value, StringComparison.Ordinal) ||
            !string.Equals(_registeredDirection, ScrollArea.ResolvedDirection, StringComparison.Ordinal))
        {
            _registrationDirty.Value = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        string orientation = Orientation.Value;
        bool shouldRender = ScrollArea.ShouldRenderScrollbar(orientation, ForceMount);

        if (!shouldRender || !ScrollArea.HasViewport)
        {
            if (_registered.Value)
            {
                await ScrollAreaInterop.UnregisterScrollAreaScrollbar(_scrollbar);
                _registered.Value = false;
            }

            return;
        }

        if (_registered.Value && !_registrationDirty.Value)
            return;

        if (_dotNetReference is null)
            _dotNetReference = DotNetObjectReference.Create<object>(ScrollArea);

        await ScrollAreaInterop.RegisterScrollAreaScrollbar(_scrollbar, _thumb, ScrollArea.ViewportElement, orientation, ScrollArea.ResolvedDirection, _dotNetReference);
        if (_disposed.Read())
        {
            await ScrollAreaInterop.UnregisterScrollAreaScrollbar(_scrollbar);
            return;
        }
        _registered.Value = true;
        _registrationDirty.Value = false;
        _registeredOrientation = orientation;
        _registeredDirection = ScrollArea.ResolvedDirection;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_contextOrientation is not null)
            ScrollArea.UnregisterScrollbar(_contextOrientation);

        try
        {
            if (_registered.Value)
            {
                _registered.Value = false;
                await ScrollAreaInterop.UnregisterScrollAreaScrollbar(_scrollbar);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    internal void RegisterThumb(ElementReference thumb)
    {
        if (_hasThumb && _thumb.Equals(thumb))
            return;

        _thumb = thumb;
        _hasThumb = true;
        _registrationDirty.Value = true;
        _ = RequestRender();
    }

    private Task HandlePointerEnter(PointerEventArgs _)
    {
        return ScrollArea.HandleScrollbarPointerChanged(Orientation.Value, true);
    }

    private Task HandlePointerLeave(PointerEventArgs _)
    {
        return ScrollArea.HandleScrollbarPointerChanged(Orientation.Value, false);
    }

    private Dictionary<string, object> ScrollbarAttributes => BuildAttributes(
        ("data-orientation", Orientation.Value),
        ("data-state", ScrollArea.GetScrollbarState(Orientation.Value)),
        ("style", BuildScrollbarStyle()));

    private string BuildScrollbarStyle()
    {
        string baseStyle = ScrollArea.GetScrollbarStyle(Orientation.Value);

        return BradixStringCache.MergeStyle(baseStyle, Style, ref _mergedStyleCache0)!;
    }
}
