@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixContentElement

@implements IBradixScrollAreaViewport

@inject IScrollAreaInterop ScrollAreaInterop
<style nonce="@Nonce">
    [data-radix-scroll-area-viewport] { scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
    [data-radix-scroll-area-viewport]::-webkit-scrollbar { display: none; }
</style>
<div @ref="_viewport"
     @attributes="ViewportAttributes">
    <div @ref="_content" style="min-width: 100%; display: table;">
        @ChildContent
    </div>
</div>

@code {
    private string? _mergedStyleCache0;

    private ElementReference _viewport;
    private ElementReference _content;
    private DotNetObjectReference<object>? _dotNetReference;
    private bool _registered;
    private ValueAtomicBool _disposed;

    [Parameter]
    public string? Nonce { get; set; }

    [CascadingParameter]
    internal BradixScrollArea ScrollArea { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        ScrollArea.RegisterViewport(_viewport, _content);

        if (_registered)
            return;

        if (_dotNetReference is null)
            _dotNetReference = DotNetObjectReference.Create<object>(ScrollArea);

        await ScrollAreaInterop.RegisterScrollAreaViewport(_viewport, _content, _dotNetReference);
        if (_disposed.Read())
        {
            await ScrollAreaInterop.UnregisterScrollAreaViewport(_viewport);
            return;
        }
        _registered = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_registered)
            {
                _registered = false;
                await ScrollAreaInterop.UnregisterScrollAreaViewport(_viewport);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    private Dictionary<string, object> ViewportAttributes => BuildAttributes(
        ("tabindex", BradixAttributeValues.Zero),
        ("data-radix-scroll-area-viewport", string.Empty),
        ("class", Class),
        ("style", BuildViewportStyle()));

    private string BuildViewportStyle()
    {
        string baseStyle = (ScrollArea.ScrollbarXMounted, ScrollArea.ScrollbarYMounted) switch
        {
            (true, true) => "overflow-x: scroll; overflow-y: scroll;",
            (true, false) => "overflow-x: scroll; overflow-y: hidden;",
            (false, true) => "overflow-x: hidden; overflow-y: scroll;",
            _ => "overflow-x: hidden; overflow-y: hidden;"
        };

        return BradixStringCache.MergeStyle(baseStyle, Style, ref _mergedStyleCache0)!;
    }
}
