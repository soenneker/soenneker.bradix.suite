@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixNavigationMenuContent

@inject INavigationMenuInterop NavigationMenuInterop

@if (ShouldRenderContent)
{
    @if (ShouldUseViewport)
    {
        <BradixPortal ContainerSelector="@ViewportSelector">
            @ContentBody
        </BradixPortal>
    }
    else
    {
        @ContentBody
    }
}

@code {
    private Func<ElementReference, Task>? _cachedHandleElementCapturedDelegate;
    private Func<Task>? _cachedHandleExitCompleteDelegate;
    private System.Func<BradixEscapeKeyDownEventArgs, Task>? _cachedHandleEscapeKeyDownDelegate;
    private System.Func<BradixPointerDownOutsideEventArgs, Task>? _cachedHandlePointerDownOutsideDelegate;
    private System.Func<BradixFocusOutsideEventArgs, Task>? _cachedHandleFocusOutsideDelegate;

    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerEnterDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerLeaveDelegate;

    private string? _viewportSelector;
    private ElementReference _contentElement;
    private ElementReference _exitProxyElement;
    private ValueAtomicBool _registered;
    private bool _wasOpen;
    private ValueAtomicBool _isExiting;
    private ValueAtomicBool _focusBridgeRegistered;
    private ValueAtomicBool _disposed;

    [CascadingParameter]
    private BradixNavigationMenu? NavigationMenu { get; set; }

    [CascadingParameter]
    private BradixNavigationMenuItem? Item { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    private bool IsOpen => Item?.IsOpen == true;

    private bool ShouldRenderInline => NavigationMenu?.IsRootMenu != true || NavigationMenu.HasViewport != true;

    private bool ShouldUseViewport =>
        NavigationMenu?.IsRootMenu == true &&
        NavigationMenu.HasViewport &&
        !string.IsNullOrWhiteSpace(NavigationMenu.ViewportId);

    private bool ShouldRenderContent =>
        (ForceMount || IsOpen || _isExiting.Value) &&
        (!ShouldUseViewport || !string.IsNullOrWhiteSpace(ViewportSelector));

    private string? ViewportSelector => !string.IsNullOrWhiteSpace(NavigationMenu?.ViewportId)
        ? BradixStringCache.Concat("#", NavigationMenu.ViewportId, ref _viewportSelector)
        : null;

    private RenderFragment? _contentBody;

    private RenderFragment ContentBody => _contentBody ??= @<BradixDismissableLayer DeferPointerDownOutside="true" DisableOutsidePointerEvents="false"
                                DismissOnEscapeKeyDown="false"
                                DismissOnPointerDownOutside="false"
                                DismissOnFocusOutside="false"
                                OnEscapeKeyDownDetailed="(_cachedHandleEscapeKeyDownDelegate ??= HandleEscapeKeyDown)"
                                OnPointerDownOutsideDetailed="(_cachedHandlePointerDownOutsideDelegate ??= HandlePointerDownOutside)"
                                OnFocusOutsideDetailed="(_cachedHandleFocusOutsideDelegate ??= HandleFocusOutside)">
            <BradixPresence Present="ForceMount || IsOpen"
                            AdditionalAttributes="ContentAttributes"
                            OnElementReferenceCaptured="(_cachedHandleElementCapturedDelegate ??= HandleElementCaptured)"
                            OnExitComplete="(_cachedHandleExitCompleteDelegate ??= HandleExitComplete)"
                            OnPointerEnter="(_cachedHandlePointerEnterDelegate ??= HandlePointerEnter)"
                            OnPointerLeave="(_cachedHandlePointerLeaveDelegate ??= HandlePointerLeave)">
                <CascadingValue Name="BradixNavigationMenuInContent" Value="true" IsFixed="true">
                    @ChildContent
                </CascadingValue>
            </BradixPresence>
            <span @ref="_exitProxyElement"
                  aria-hidden="true"
                  tabindex="0"
                  style="position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;overflow:hidden;" />
        </BradixDismissableLayer>;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (_wasOpen && !IsOpen)
            _isExiting.Value = true;
        else if (IsOpen)
            _isExiting.Value = false;
        _wasOpen = IsOpen;
    }

    private Task HandleElementCaptured(ElementReference element)
    {
        _contentElement = element;
        return RequestRender();
    }

    private Task HandleExitComplete()
    {
        _isExiting.Value = false;
        return RequestRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        if (!ShouldRenderContent)
        {
            if (_registered.Value && Item is not null)
            {
                NavigationMenu?.UnregisterContent(Item.ResolvedValue);
                _registered.Value = false;
            }

            if (_focusBridgeRegistered.Value)
            {
                await NavigationMenuInterop.UnregisterNavigationMenuContentFocusBridge(_contentElement);
                _focusBridgeRegistered.Value = false;
            }

            _contentElement = default;
            return;
        }

        if (_contentElement.Context is null)
            return;

        if (_registered.Value is false && NavigationMenu is not null && Item is not null)
        {
            NavigationMenu.RegisterContent(Item.ResolvedValue, _contentElement);
            _registered.Value = true;
        }

        if (NavigationMenu is not null &&
            Item is not null &&
            NavigationMenu.TryGetFocusProxy(Item.ResolvedValue, out ElementReference startProxy) &&
            NavigationMenu.TryGetTrigger(Item.ResolvedValue, out IBradixNavigationMenuRegisteredTrigger trigger))
        {
            if (_focusBridgeRegistered.Value)
            {
                await NavigationMenuInterop.UpdateNavigationMenuContentFocusBridge(_contentElement, trigger.TriggerElement, startProxy, _exitProxyElement);
            }
            else
            {
                await NavigationMenuInterop.RegisterNavigationMenuContentFocusBridge(_contentElement, trigger.TriggerElement, startProxy, _exitProxyElement);
                if (_disposed.Read())
                {
                    await NavigationMenuInterop.UnregisterNavigationMenuContentFocusBridge(_contentElement);
                    return;
                }
                _focusBridgeRegistered.Value = true;
            }
        }
    }

    private IReadOnlyDictionary<string, object> ContentAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(8);

            if (!string.IsNullOrWhiteSpace(Item?.ContentId))
                attributes["id"] = Item.ContentId;

            if (!string.IsNullOrWhiteSpace(Class))
                attributes["class"] = Class;

            if (!string.IsNullOrWhiteSpace(Style))
                attributes["style"] = Style;

            attributes["data-state"] = IsOpen ? "open" : "closed";
            attributes["tabindex"] = BradixAttributeValues.MinusOne;
            attributes["data-orientation"] = NavigationMenu?.Orientation?.Value ?? Orientation.Horizontal.Value;
            attributes["aria-labelledby"] = Item?.TriggerId ?? string.Empty;

            if (ForceMount && !IsOpen)
            {
                attributes["hidden"] = BradixAttributeValues.True;
                attributes["aria-hidden"] = "true";
                attributes["inert"] = BradixAttributeValues.True;
            }

            string motion = ResolveMotion();
            if (!string.IsNullOrWhiteSpace(motion))
                attributes["data-motion"] = motion;

            return attributes;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value && Item is not null)
        {
            _registered.Value = false;
            NavigationMenu?.UnregisterContent(Item.ResolvedValue);
        }
        if (_focusBridgeRegistered.Value)
        {
            _focusBridgeRegistered.Value = false;
            await NavigationMenuInterop.UnregisterNavigationMenuContentFocusBridge(_contentElement);
        }
    }

    private async Task HandleEscapeKeyDown(BradixEscapeKeyDownEventArgs _)
    {
        if (NavigationMenu is not null && Item is not null)
        {
            NavigationMenu.MarkEscapeClosed(Item.ResolvedValue);
            await NavigationMenu.Dismiss(Item.ResolvedValue);
        }
    }

    private async Task HandlePointerDownOutside(BradixPointerDownOutsideEventArgs args)
    {
        if (NavigationMenu is null)
            return;

        if (!NavigationMenu.IsRootMenu ||
            NavigationMenu.ContainsRegisteredTriggerId(args.OriginalEvent.AncestorIds) ||
            NavigationMenu.ContainsViewportId(args.OriginalEvent.AncestorIds))
        {
            args.PreventDefault();
            return;
        }

        await NavigationMenu.Dismiss(args.OriginalEvent.ActiveElementInsideLayer && Item is not null ? Item.ResolvedValue : null);
    }

    private async Task HandleFocusOutside(BradixFocusOutsideEventArgs args)
    {
        if (NavigationMenu is null)
            return;

        if (NavigationMenu.ContainsRootNavigationMenuId(args.OriginalEvent.AncestorIds))
        {
            args.PreventDefault();
            return;
        }

        await NavigationMenu.Dismiss(Item?.ResolvedValue);
    }

    private Task HandlePointerEnter(PointerEventArgs args)
    {
        if (args.PointerType == "touch")
            return Task.CompletedTask;

        return NavigationMenu?.HandleContentPointerEnter() ?? Task.CompletedTask;
    }

    private Task HandlePointerLeave(PointerEventArgs args)
    {
        if (args.PointerType == "touch")
            return Task.CompletedTask;

        return NavigationMenu?.HandleContentPointerLeave() ?? Task.CompletedTask;
    }

    private string ResolveMotion()
    {
        if (!ShouldUseViewport ||
            NavigationMenu is null ||
            Item is null ||
            string.IsNullOrWhiteSpace(NavigationMenu.PreviousValue))
        {
            return string.Empty;
        }

        NavigationMenu.GetTriggerIndices(Item.ResolvedValue, out int index, out int previousIndex, out int activeIndex);

        bool isSelected = Item.ResolvedValue == NavigationMenu.CurrentValue;
        bool wasSelected = activeIndex == previousIndex;

        if (!isSelected && !wasSelected)
            return string.Empty;

        if (index != previousIndex)
        {
            if (isSelected && previousIndex != -1)
                return index > previousIndex ? "from-end" : "from-start";

            if (wasSelected && index != -1)
                return index > previousIndex ? "to-start" : "to-end";
        }

        return string.Empty;
    }
}
