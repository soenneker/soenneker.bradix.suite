@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using System.Globalization
@using Microsoft.JSInterop

@inherits BradixContentElement

@implements IBradixNavigationMenuIndicator

@inject INavigationMenuInterop NavigationMenuInterop

@if (ForceMount || NavigationMenu?.HasOpenItem == true)
{
    <BradixPresence Present="ForceMount || NavigationMenu?.HasOpenItem == true"
                    Tag="div"
                    Class="@Class"
                    Style="@ComputedStyle"
                    AdditionalAttributes="@IndicatorAttributes"
                    OnElementReferenceCaptured="(_cachedHandleElementCapturedDelegate ??= HandleElementCaptured)">
        @ChildContent
    </BradixPresence>
}

@code {
    private string? _mergedStyleCache0;

    private System.Func<ElementReference, Task>? _cachedHandleElementCapturedDelegate;

    private string? _positionStyle;
    private (bool Vertical, long Size, long Offset) _positionStyleKey;
    private ElementReference _element;
    private bool _hasElement;
    private bool _registered;
    private ValueAtomicBool _disposed;
    private DotNetObjectReference<BradixNavigationMenuIndicator>? _dotNetReference;
    private double? _size;
    private double? _offset;

    [CascadingParameter]
    private BradixNavigationMenu? NavigationMenu { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    private IReadOnlyDictionary<string, object> IndicatorAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(2);

            attributes["aria-hidden"] = "true";
            attributes["data-state"] = NavigationMenu?.HasOpenItem == true ? "visible" : "hidden";
            attributes["data-orientation"] = (NavigationMenu?.Orientation ?? Orientation.Horizontal).Value;
            return attributes;
        }
    }

    private string ComputedStyle
    {
        get
        {
            Orientation orientation = NavigationMenu?.Orientation ?? Orientation.Horizontal;
            var baseStyle = "position:absolute;";

            if (_size.HasValue && _offset.HasValue)
            {
                var key = (orientation == Orientation.Vertical, BitConverter.DoubleToInt64Bits(_size.Value), BitConverter.DoubleToInt64Bits(_offset.Value));
                if (_positionStyle is null || _positionStyleKey != key)
                {
                    _positionStyleKey = key;
                    _positionStyle = orientation == Orientation.Vertical
                        ? string.Create(CultureInfo.InvariantCulture, $"position:absolute; top:0;height:{_size.Value}px;transform:translateY({_offset.Value}px);")
                        : string.Create(CultureInfo.InvariantCulture, $"position:absolute; left:0;width:{_size.Value}px;transform:translateX({_offset.Value}px);");
                }
                baseStyle = _positionStyle;
            }

            return BradixStringCache.MergeStyle(baseStyle, Style, ref _mergedStyleCache0)!;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        BradixNavigationMenu? navigationMenu = NavigationMenu;

        if (!_hasElement ||
            navigationMenu is null ||
            !navigationMenu.HasIndicatorTrack ||
            !navigationMenu.HasOpenItem ||
            !navigationMenu.TryGetOpenTrigger(out IBradixNavigationMenuRegisteredTrigger trigger))
        {
            if (_registered)
            {
                await NavigationMenuInterop.UnregisterNavigationMenuIndicator(_element);
                _registered = false;
            }

            return;
        }

        _dotNetReference ??= DotNetObjectReference.Create(this);

        if (_registered)
        {
            await NavigationMenuInterop.UpdateNavigationMenuIndicator(_element, trigger.TriggerElement, navigationMenu.IndicatorTrackElement, navigationMenu.Orientation.Value);
        }
        else
        {
            await NavigationMenuInterop.RegisterNavigationMenuIndicator(_element, trigger.TriggerElement, navigationMenu.IndicatorTrackElement, _dotNetReference,
                navigationMenu.Orientation.Value);
            if (_disposed.Read())
            {
                await NavigationMenuInterop.UnregisterNavigationMenuIndicator(_element);
                return;
            }
            _registered = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_registered)
            {
                _registered = false;
                await NavigationMenuInterop.UnregisterNavigationMenuIndicator(_element);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    private Task HandleElementCaptured(ElementReference element)
    {
        _element = element;
        _hasElement = true;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandleIndicatorPositionChanged(double size, double offset)
    {
        if (_disposed.Read())
            return Task.CompletedTask;
        if (Math.Abs((_size ?? -1) - size) < 0.1 &&
            Math.Abs((_offset ?? -1) - offset) < 0.1)
        {
            return Task.CompletedTask;
        }

        _size = size;
        _offset = offset;
        return RequestRender();
    }
}
