@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixNavigationMenuItem

<CascadingValue @key="ResolvedValue"
                Value="this">
    <li
        @attributes="ItemAttributes">
        @ChildContent
    </li>
</CascadingValue>

@code {
    private string? _triggerId;
    private string? _contentId;
    [CascadingParameter]
    private BradixNavigationMenu? NavigationMenu { get; set; }

    [Parameter]
    public string? Value { get; set; }

    internal string? AutoValue { get; private set; }

    internal string ResolvedValue => Value ?? AutoValue ?? string.Empty;

    internal string TriggerId => NavigationMenu?.MakeTriggerId(ResolvedValue, ref _triggerId) ?? string.Empty;

    internal string ContentId => NavigationMenu?.MakeContentId(ResolvedValue, ref _contentId) ?? string.Empty;

    internal bool IsOpen => NavigationMenu?.IsOpen(this) == true;

    protected override void OnInitialized()
    {
        AutoValue ??= BlazorIdGenerator.New("bradix-navigation-menu-item");
    }

    private Dictionary<string, object> ItemAttributes => BuildAttributes();
}
