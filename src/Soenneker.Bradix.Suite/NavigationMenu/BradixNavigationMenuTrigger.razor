@using System.Text.Json
@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Atomics.ValueBools

@inherits BradixIdentifiableContentElement

@implements IBradixNavigationMenuTrigger

@inject IRovingFocusInterop RovingFocusInterop
@inject INavigationMenuInterop NavigationMenuInterop
<button @ref="_button"
        @onpointerenter="(_cachedHandlePointerEnterDelegate ??= HandlePointerEnter)"
        @onpointerleave="(_cachedHandlePointerLeaveDelegate ??= HandlePointerLeave)"
        @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
        @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
        @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
        @attributes="TriggerAttributes">
    @ChildContent
</button>

<span @ref="_focusProxy"
      aria-hidden="true"
      tabindex="@(IsOpen ? 0 : -1)"
      style="@(IsOpen
          ? "position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;overflow:hidden;"
          : "position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;overflow:hidden;display:none;")" />

@if (NavigationMenu?.IsRootMenu == true && NavigationMenu.HasViewport && Item is not null)
{
    <span aria-owns="@(IsOpen ? Item.ContentId : null)"></span>
}

@code {
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerEnterDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerLeaveDelegate;
    private System.Func<Task>? _cachedHandleClickDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private object? _cachedHandlePointerMoveCallback;

    private ElementReference _button;
    private ElementReference _focusProxy;
    private bool _hasPointerMoveOpened;
    private bool _openedByPointerMove;
    private bool _rovingFocusBridgeReady;
    private bool _rovingFocusRegistered;
    private bool _triggerInteractionRegistered;
    private bool _wasClickClose;
    private bool _ignoreNextClick;
    private bool _focusProxyRegistered;
    private ValueAtomicBool _disposed;
    private string? _pointerOpenClickSuppressedValue;
    private DotNetObjectReference<BradixNavigationMenuTrigger>? _dotNetReference;
    private BradixNavigationMenuTriggerRegistration? _registration;

    [CascadingParameter]
    private BradixNavigationMenu? NavigationMenu { get; set; }

    [CascadingParameter]
    private BradixNavigationMenuItem? Item { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private bool IsOpen => Item?.IsOpen == true;

    private Dictionary<string, object> TriggerAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAttributes(
                ("id", Item?.TriggerId),
                ("type", "button"),
                ("disabled", Disabled ? BradixAttributeValues.True : null),
                ("data-disabled", Disabled ? string.Empty : null),
                ("data-state", IsOpen ? "open" : "closed"),
                ("data-bradix-roving-group", NavigationMenu?.TriggerRovingGroupId),
                ("data-bradix-roving-item", string.Empty),
                ("data-bradix-roving-item-id", Item?.ResolvedValue),
                ("data-bradix-roving-orientation", NavigationMenu?.Orientation?.Value),
                ("data-bradix-roving-dir", NavigationMenu?.ResolvedDirection),
                ("data-bradix-roving-loop", "true"),
                ("data-debug-dispose-count", NavigationMenu?.GetDebugTriggerDisposeCount(Item?.ResolvedValue).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                ("aria-expanded", IsOpen ? "true" : "false"),
                ("aria-controls", Item?.ContentId),
                ("tabindex", null));

            if (!_hasPointerMoveOpened)
                attributes["onpointermove"] = (_cachedHandlePointerMoveCallback ??= EventCallback.Factory.Create<PointerEventArgs>(this, HandlePointerMove));

            return attributes;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        if (NavigationMenu is not null && Item is not null)
        {
            if (_registration is null)
            {
                _registration = new BradixNavigationMenuTriggerRegistration(Item.ResolvedValue, Item.TriggerId, this);
                NavigationMenu.RegisterTrigger(_registration);
            }

            _dotNetReference ??= DotNetObjectReference.Create(this);

            if (!_rovingFocusRegistered)
            {
                try
                {
                    await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_button, _dotNetReference);
                    if (_disposed.Read())
                    {
                        await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_button);
                        return;
                    }
                    _rovingFocusRegistered = true;
                }
                catch (Exception ex) when (ShouldIgnoreInteropException(ex))
                {
                    return;
                }
            }

            if (!_triggerInteractionRegistered)
            {
                try
                {
                    await NavigationMenuInterop.RegisterNavigationMenuTriggerInteraction(_button, _dotNetReference);
                    if (_disposed.Read())
                    {
                        await NavigationMenuInterop.UnregisterNavigationMenuTriggerInteraction(_button);
                        return;
                    }
                    _triggerInteractionRegistered = true;
                }
                catch (Exception ex) when (ShouldIgnoreInteropException(ex))
                {
                    return;
                }
            }
        }

        if (NavigationMenu is not null && Item is not null)
        {
            if (IsOpen)
            {
                NavigationMenu.RegisterFocusProxy(Item.ResolvedValue, _focusProxy);
                _focusProxyRegistered = true;
            }
            else if (_focusProxyRegistered)
            {
                NavigationMenu.UnregisterFocusProxy(Item.ResolvedValue);
                _focusProxyRegistered = false;
            }
        }

    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        NavigationMenu?.RecordTriggerDisposed(Item?.ResolvedValue);
        if (_focusProxyRegistered && Item is not null)
            NavigationMenu?.UnregisterFocusProxy(Item.ResolvedValue);
        if (_registration is not null)
            NavigationMenu?.UnregisterTrigger(_registration);
        try
        {
            try
            {
                if (_rovingFocusRegistered)
                    await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_button);
            }
            catch (Exception ex) when (ShouldIgnoreInteropException(ex))
            {
            }
        }
        finally
        {
            try
            {
                if (_triggerInteractionRegistered)
                    await NavigationMenuInterop.UnregisterNavigationMenuTriggerInteraction(_button);
            }
            catch (Exception ex) when (ShouldIgnoreInteropException(ex))
            {
            }
            finally
            {
                _dotNetReference?.Dispose();
                _dotNetReference = null;
            }
        }
    }

    private async Task HandlePointerEnter(PointerEventArgs args)
    {
        if (NavigationMenu is not null)
            NavigationMenu.HandleTriggerPointerEnter();

        if (NavigationMenu is not null && Item is not null)
            NavigationMenu.ClearEscapeClosed(Item.ResolvedValue);

        if (args.PointerType == "touch" ||
            Disabled ||
            NavigationMenu is null ||
            Item is null ||
            _hasPointerMoveOpened ||
            !NavigationMenu.HasOpenItem ||
            IsOpen)
            return;

        await NavigationMenu.HandleTriggerPointerMove(Item.ResolvedValue);
        _hasPointerMoveOpened = true;
        _openedByPointerMove = !string.Equals(_pointerOpenClickSuppressedValue, Item.ResolvedValue, StringComparison.Ordinal);
    }

    private async Task HandlePointerMove(PointerEventArgs args)
    {
        if (args.PointerType == "touch" ||
            Disabled ||
            NavigationMenu is null ||
            Item is null ||
            _wasClickClose ||
            NavigationMenu.WasEscapeClosed(Item.ResolvedValue) ||
            _hasPointerMoveOpened)
            return;

        await NavigationMenu.HandleTriggerPointerMove(Item.ResolvedValue);
        _hasPointerMoveOpened = true;
        _openedByPointerMove = !string.Equals(_pointerOpenClickSuppressedValue, Item.ResolvedValue, StringComparison.Ordinal);
    }

    private async Task HandlePointerLeave(PointerEventArgs args)
    {
        if (args.PointerType == "touch" || Disabled || NavigationMenu is null)
            return;

        await HandleHoverLeave();
    }

    private async Task HandleHoverEnter()
    {
        if (Disabled)
            return;

        if (NavigationMenu is not null)
            NavigationMenu.HandleTriggerPointerEnter();

        if (NavigationMenu is not null && Item is not null)
            NavigationMenu.ClearEscapeClosed(Item.ResolvedValue);

        if (NavigationMenu is null ||
            Item is null ||
            _hasPointerMoveOpened ||
            !NavigationMenu.HasOpenItem ||
            IsOpen)
        {
            return;
        }

        await NavigationMenu.HandleTriggerPointerMove(Item.ResolvedValue);
        _hasPointerMoveOpened = true;
    }

    private async Task HandleHoverMove()
    {
        if (Disabled ||
            NavigationMenu is null ||
            Item is null ||
            _wasClickClose ||
            NavigationMenu.WasEscapeClosed(Item.ResolvedValue) ||
            _hasPointerMoveOpened)
            return;

        await NavigationMenu.HandleTriggerPointerMove(Item.ResolvedValue);
        _hasPointerMoveOpened = true;
    }

    private async Task HandleHoverLeave()
    {
        if (Disabled || NavigationMenu is null)
            return;

        _hasPointerMoveOpened = false;
        _openedByPointerMove = false;
        _wasClickClose = false;
        await NavigationMenu.HandleTriggerPointerLeave();
    }

    private Task HandleClick()
    {
        if (_ignoreNextClick)
        {
            _ignoreNextClick = false;
            return Task.CompletedTask;
        }

        return ProcessClick();
    }

    private async Task ProcessClick()
    {
        if (Disabled || NavigationMenu is null || Item is null)
            return;

        if (IsOpen &&
            _openedByPointerMove &&
            !string.Equals(_pointerOpenClickSuppressedValue, Item.ResolvedValue, StringComparison.Ordinal))
        {
            _openedByPointerMove = false;
            _wasClickClose = false;
            _pointerOpenClickSuppressedValue = Item.ResolvedValue;
            return;
        }

        bool wasOpen = IsOpen;
        _openedByPointerMove = false;
        await NavigationMenu.ToggleItem(Item.ResolvedValue);
        _wasClickClose = wasOpen;

        if (wasOpen || !string.Equals(_pointerOpenClickSuppressedValue, Item.ResolvedValue, StringComparison.Ordinal))
            _pointerOpenClickSuppressedValue = null;
    }

    private Task HandleFocus(FocusEventArgs _) => HandleDirectFocus();

    private Task FocusCurrentTrigger()
    {
        if (NavigationMenu is not null && Item is not null)
            NavigationMenu.SetCurrentTabStop(Item.ResolvedValue);

        return Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => ProcessKeyDown(args.Key, args.CtrlKey, args.AltKey, args.MetaKey, args.ShiftKey);

    private async Task ProcessKeyDown(string key, bool ctrlKey, bool altKey, bool metaKey, bool shiftKey)
    {
        if (Disabled || NavigationMenu is null || Item is null)
            return;

        string verticalEntryKey = NavigationMenu.ResolvedDirection == "rtl" ? "ArrowLeft" : "ArrowRight";
        string entryKey = NavigationMenu.Orientation == Orientation.Vertical ? verticalEntryKey : "ArrowDown";

        if (IsOpen && string.Equals(key, entryKey, StringComparison.Ordinal))
        {
            await NavigationMenu.FocusContent(Item.ResolvedValue);
            return;
        }

        if (IsOpen && string.Equals(key, "Escape", StringComparison.Ordinal))
        {
            NavigationMenu.MarkEscapeClosed(Item.ResolvedValue);
            await NavigationMenu.Dismiss(Item.ResolvedValue);
            return;
        }

        if (key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" or "Home" or "End")
        {
            if (_rovingFocusBridgeReady && key is "ArrowLeft" or "ArrowRight")
                return;

            if (_registration is not null)
                await NavigationMenu.HandleTriggerNavigation(_registration, key, ctrlKey, altKey, metaKey, shiftKey);

            return;
        }

        if (key is "Enter" or " " or "Spacebar")
            await NavigationMenu.ToggleItem(Item.ResolvedValue);
    }

    [JSInvokable]
    public Task HandleRovingFocusBridgeReady()
    {
        _rovingFocusBridgeReady = true;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandleDirectClick()
    {
        _ignoreNextClick = true;
        return ProcessClick();
    }

    [JSInvokable]
    public Task HandleDirectFocus()
    {
        return FocusCurrentTrigger();
    }

    [JSInvokable(nameof(HandleDirectKeyDown))]
    public Task HandleDirectKeyDownFromJson(JsonElement payload) =>
        HandleDirectKeyDown(JsonSerializer.Deserialize(payload, BradixInteropJsonContext.Default.BradixDelegatedKeyboardEvent)!);

    public Task HandleDirectKeyDown(BradixDelegatedKeyboardEvent args)
    {
        return ProcessKeyDown(args.Key, args.CtrlKey, args.AltKey, args.MetaKey, args.ShiftKey);
    }

    private static bool ShouldIgnoreInteropException(Exception ex)
    {
        return ex is ObjectDisposedException or JSDisconnectedException;
    }

    internal ElementReference TriggerElement => _button;

}
