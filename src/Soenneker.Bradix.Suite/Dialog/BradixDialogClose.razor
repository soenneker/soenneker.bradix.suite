@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixContentElement

@implements IBradixDialogClose
@inject IDelegatedInteractionInterop DelegatedInteractionInterop
@inject IControlsInterop ControlsInterop
@if (AsChild && !string.IsNullOrWhiteSpace(ChildElementName))
{
    <BradixSlot ElementName="@ChildElementName"
                Class="@Class"
                Style="@Style"
                AdditionalAttributes="@SlottedButtonAttributes"
                ChildAttributes="@ChildAttributes">
        @ChildContent
    </BradixSlot>
}
else if (AsChild)
{
    <CascadingValue Name="BradixDialogCloseContext" Value="CloseContext" IsFixed="false">
        @ChildContent
    </CascadingValue>
}
else
{
    <button @onclick="HandleClick"
            @ref="_button"
            @attributes="ButtonAttributes">
        @ChildContent
    </button>
}

@code {
    private BradixDialogCloseContext? _closeContext;
    private ElementReference _button;
    private bool _delegatedInteractionReady;
    private DotNetObjectReference<object>? _dotNetReference;

    [CascadingParameter]
    private BradixDialog? Dialog { get; set; }

    [Parameter]
    public EventCallback<ElementReference> OnElementReferenceCaptured { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Close";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AsChild { get; set; }

    [Parameter]
    public string? ChildElementName { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, object>? ChildAttributes { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private BradixDialogCloseContext CloseContext
    {
        get
        {
            if (_closeContext is null || _closeContext.Disabled != Disabled ||
                !string.Equals(_closeContext.AriaLabel, AriaLabel, StringComparison.Ordinal))
            {
                _closeContext = new BradixDialogCloseContext
                {
                    Disabled = Disabled,
                    AriaLabel = AriaLabel,
                    Close = HandleChildClick
                };
            }

            return _closeContext;
        }
    }

    private Dictionary<string, object> ButtonAttributes => MergeCloseAttributes(BuildAttributes(
        ("type", "button"),
        ("aria-label", AriaLabel),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? true : null)));

    private Dictionary<string, object> SlottedButtonAttributes => MergeCloseAttributes(BuildAttributes(
        ("type", "button"),
        ("aria-label", AriaLabel),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? true : null),
        ("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, HandleChildClick))));

    private Dictionary<string, object> MergeCloseAttributes(Dictionary<string, object> attributes)
    {
        if (AdditionalAttributes is null)
            return attributes;

        if (AdditionalAttributes is Dictionary<string, object> dictionary)
        {
            foreach (KeyValuePair<string, object> attribute in dictionary)
                attributes[attribute.Key] = attribute.Value;

            return attributes;
        }

        foreach (KeyValuePair<string, object> attribute in AdditionalAttributes)
            attributes[attribute.Key] = attribute.Value;

        return attributes;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AsChild || !firstRender)
            return;

        if (OnElementReferenceCaptured.HasDelegate)
            await OnElementReferenceCaptured.InvokeAsync(_button);

        _dotNetReference = DotNetObjectReference.Create<object>(this);
        await DelegatedInteractionInterop.RegisterDelegatedInteraction(_button, _dotNetReference, new
        {
            readyMethod = nameof(HandleDelegatedInteractionReady),
            click = new
            {
                method = nameof(HandleDelegatedClick),
                currentTargetOnly = false,
                stopPropagation = true
            }
        });
    }

    private async Task HandleClick()
    {
        if (!Disabled && Dialog is not null && !_delegatedInteractionReady)
        {
            await ControlsInterop.FocusElementByIdDeferred(Dialog.ResolvedTriggerId);
            await Dialog.SetOpen(false);
        }

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private async Task HandleChildClick(MouseEventArgs args)
    {
        if (!Disabled && Dialog is not null)
        {
            await ControlsInterop.FocusElementByIdDeferred(Dialog.ResolvedTriggerId);
            await Dialog.SetOpen(false);
        }

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }

    public async ValueTask DisposeAsync()
    {
        if (AsChild)
            return;

        await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_button);
        _dotNetReference?.Dispose();
    }

    [JSInvokable]
    public Task HandleDelegatedInteractionReady()
    {
        _delegatedInteractionReady = true;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task HandleDelegatedClick(BradixDelegatedMouseEvent args)
    {
        if (!Disabled && Dialog is not null)
        {
            await ControlsInterop.FocusElementByIdDeferred(Dialog.ResolvedTriggerId);
            await Dialog.SetOpen(false);
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(new MouseEventArgs
            {
                Detail = args.Detail,
                Button = args.Button,
                CtrlKey = args.CtrlKey,
                ShiftKey = args.ShiftKey,
                AltKey = args.AltKey,
                MetaKey = args.MetaKey,
                PageX = args.PageX,
                PageY = args.PageY
            });
        }
    }
}
