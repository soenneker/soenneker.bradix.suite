@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixDialogOverlay
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IDismissableLayerInterop DismissableLayerInterop

@if (ShouldRenderOverlay)
{
    <BradixPresence OnElementReferenceCaptured="RegisterDismissSurface" Present="IsPresent"
                    Tag="div"
                    Class="@Class"
                    Style="@OverlayStyle"
                    AdditionalAttributes="OverlayAttributes"
                    OnExitComplete="(_cachedHandleExitCompleteDelegate ??= HandleExitComplete)"
                ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />
}

@code {
    private ElementReference _surface;
    private IJSObjectReference? _surfaceModule;
    private bool _surfaceDisposed;
    private async Task RegisterDismissSurface(ElementReference element)
    {
        if (_surfaceDisposed) return;
        _surfaceModule ??= await DismissableLayerInterop.Initialize();
        if (_surfaceDisposed) return;
        if (!string.IsNullOrEmpty(_surface.Id)) await _surfaceModule.InvokeBradixVoidAsync("unregisterDismissSurface", _surface);
        _surface = element;
        await _surfaceModule.InvokeBradixVoidAsync("registerDismissSurface", element);
    }
    public async ValueTask DisposeAsync()
    {
        _surfaceDisposed = true;
        try
        {
            if (_surfaceModule is not null) await _surfaceModule.InvokeBradixVoidAsync("unregisterDismissSurface", _surface);
        }
        catch (JSDisconnectedException) { }
    }

    private string? _mergedStyleCache0;

    private System.Func<Task>? _cachedHandleExitCompleteDelegate;

    private bool _wasPresent;
    private ValueAtomicBool _isExiting;

    [CascadingParameter]
    private BradixDialog? Dialog { get; set; }

    [CascadingParameter(Name = "BradixDialogPortalForceMount")]
    private bool PortalForceMount { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    private bool IsPresent => Dialog?.CurrentOpen == true || ForceMount || PortalForceMount;

    private bool ShouldRenderOverlay => Dialog?.Modal == true && (IsPresent || _isExiting.Value);

    private string? OverlayStyle => BradixStringCache.MergeStyle("pointer-events:auto;", Style, ref _mergedStyleCache0);

    private IReadOnlyDictionary<string, object> OverlayAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(2);

            attributes["data-bradix-dismiss-surface"] = string.Empty;
            attributes["data-state"] = Dialog?.CurrentOpen == true ? "open" : "closed";
            return attributes;
        }
    }

    protected override void OnParametersSet()
    {
        bool present = IsPresent;

        if (_wasPresent && !present)
            _isExiting.Value = true;
        else if (present)
            _isExiting.Value = false;

        _wasPresent = present;
    }

    private Task HandleExitComplete()
    {
        _isExiting.Value = false;
        return RequestRender();
    }
}
