@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixDialogOverlay

@if (ShouldRenderOverlay)
{
    <BradixPresence Present="IsPresent"
                    Tag="div"
                    Class="@Class"
                    Style="@OverlayStyle"
                    AdditionalAttributes="OverlayAttributes"
                    OnExitComplete="(_cachedHandleExitCompleteDelegate ??= HandleExitComplete)">
        @ChildContent
    </BradixPresence>
}

@code {
    private string? _mergedStyleCache0;

    private System.Func<Task>? _cachedHandleExitCompleteDelegate;

    private bool _wasPresent;
    private bool _isExiting;

    [CascadingParameter]
    private BradixDialog? Dialog { get; set; }

    [CascadingParameter(Name = "BradixDialogPortalForceMount")]
    private bool PortalForceMount { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    private bool IsPresent => Dialog?.CurrentOpen == true || ForceMount || PortalForceMount;

    private bool ShouldRenderOverlay => Dialog?.Modal == true && (IsPresent || _isExiting);

    private string? OverlayStyle => BradixStringCache.MergeStyle("pointer-events:auto;", Style, ref _mergedStyleCache0);

    private IReadOnlyDictionary<string, object> OverlayAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(1);

            attributes["data-state"] = Dialog?.CurrentOpen == true ? "open" : "closed";
            return attributes;
        }
    }

    protected override void OnParametersSet()
    {
        bool present = IsPresent;

        if (_wasPresent && !present)
            _isExiting = true;
        else if (present)
            _isExiting = false;

        _wasPresent = present;
    }

    private Task HandleExitComplete()
    {
        _isExiting = false;
        return RequestRender();
    }
}
