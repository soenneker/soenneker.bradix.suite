@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixDialogTrigger
@if (TriggerTemplate is not null)
{
    @TriggerTemplate(CreateTriggerContext())
}
else
{
    <button @ref="_button"
        @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
        @attributes="ButtonAttributes">
        @ChildContent
    </button>
}

@code {
    [Parameter] public RenderFragment<BradixTriggerContext>? TriggerTemplate { get; set; }
    [Parameter] public EventCallback<BradixActivationEventArgs> OnActivate { get; set; }

    private BradixTriggerContext CreateTriggerContext() => new(ButtonAttributes,
        EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick), CaptureTrigger, _button);

    private void CaptureTrigger(ElementReference element)
    {
        _button = element;
        Dialog?.RegisterTrigger(element, ResolvedTriggerId);
    }


    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    private ElementReference _button;

    [CascadingParameter]
    private BradixDialog? Dialog { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string ResolvedTriggerId => string.IsNullOrWhiteSpace(Id) ? Dialog?.DefaultTriggerId ?? string.Empty : Id;

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"),
        ("id", ResolvedTriggerId),
        ("aria-haspopup", "dialog"),
        ("aria-expanded", Dialog?.CurrentOpen == true ? "true" : "false"),
        ("aria-controls", Dialog?.ContentId),
        ("data-state", Dialog?.CurrentOpen == true ? "open" : "closed"),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? BradixAttributeValues.True : null));

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        Dialog?.RegisterTrigger(_button, ResolvedTriggerId);
        return Task.CompletedTask;
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(args);
        if (Disabled) return;

        if (OnActivate.HasDelegate)
        {
            var activation = new BradixActivationEventArgs(args);
            await OnActivate.InvokeAsync(activation);
            if (activation.DefaultPrevented) return;
        }
        if (Disabled) return;
        if (Dialog is not null) await Dialog.ToggleOpen();
    }
}
