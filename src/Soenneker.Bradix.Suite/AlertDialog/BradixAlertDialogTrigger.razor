@namespace Soenneker.Bradix

@inherits BradixContentElement
@implements IBradixAlertDialogTrigger
<BradixDialogTrigger Class="@Class"
                     Style="@Style"
                     Disabled="Disabled"
                     AdditionalAttributes="@AdditionalAttributes"
                     OnClick="OnClick"
                     OnActivate="OnActivate"
                     TriggerTemplate="TriggerTemplate"
                     ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />

@code {
    [Parameter] public RenderFragment<BradixTriggerContext>? TriggerTemplate { get; set; }
    [Parameter] public EventCallback<BradixActivationEventArgs> OnActivate { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
}
