@namespace Soenneker.Bradix

@inherits BradixContentElement
@implements IBradixAlertDialogCancel
<BradixDialogClose Class="@Class"
                   AriaLabel="@((string?)null)"
                   Style="@Style"
                   Disabled="Disabled"
                   AdditionalAttributes="@ResolvedAttributes"
                   OnElementReferenceCaptured="@HandleElementCaptured"
                   OnClick="OnClick">
    @ChildContent
</BradixDialogClose>

@code {
    [CascadingParameter]
    private BradixAlertDialogContent? Content { get; set; }

    private ElementReference _element;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private IReadOnlyDictionary<string, object>? ResolvedAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BradixAttributeDictionary.Create(AdditionalAttributes, 1);

            attributes["data-bradix-alert-dialog-cancel"] = "true";

            return attributes;
        }
    }

    private Task HandleElementCaptured(ElementReference element)
    {
        _element = element;
        Content?.RegisterCancelElement(element);
        return Task.CompletedTask;
    }
}
