@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement
@implements IBradixAlertDialogContent

@inject IControlsInterop ControlsInterop
<CascadingValue Value="this">
    <BradixDialogContent Class="@Class"
                         Style="@Style"
                         Id="@Id"
                         AdditionalAttributes="@AdditionalAttributes"
                         ForceMount="ForceMount"
                         Role="alertdialog"
                         PreventMountAutoFocus="true"
                         CloseOnEscapeKeyDown="CloseOnEscapeKeyDown"
                         CloseOnPointerDownOutside="false"
                         CloseOnFocusOutside="false"
                         OnOpenAutoFocusDetailed="(_cachedHandleOpenAutoFocusDelegate ??= HandleOpenAutoFocus)"
                         OnElementReferenceCaptured="(_cachedHandleContentElementCapturedDelegate ??= HandleContentElementCaptured)"
                         OnPointerDownOutsideDetailed="(_cachedHandlePointerDownOutsideDelegate ??= HandlePointerDownOutside)"
                         OnInteractOutsideDetailed="(_cachedHandleInteractOutsideDelegate ??= HandleInteractOutside)"
                         OnCloseAutoFocus="OnCloseAutoFocus"
                         OnCloseAutoFocusDetailed="@OnCloseAutoFocusDetailed"
                         OnEscapeKeyDown="OnEscapeKeyDown"
                         OnEscapeKeyDownDetailed="@OnEscapeKeyDownDetailed"
                         OnFocusOutside="OnFocusOutside"
                         OnFocusOutsideDetailed="@OnFocusOutsideDetailed">
        @ChildContent
    </BradixDialogContent>
</CascadingValue>

@code {
    private Func<Task>? _focusPendingCallback;
    private Func<Task>? _focusOpenCallback;
    private System.Func<BradixAutoFocusEventArgs, Task>? _cachedHandleOpenAutoFocusDelegate;
    private System.Func<ElementReference, Task>? _cachedHandleContentElementCapturedDelegate;
    private System.Func<BradixPointerDownOutsideEventArgs, Task>? _cachedHandlePointerDownOutsideDelegate;
    private System.Func<BradixInteractOutsideEventArgs, Task>? _cachedHandleInteractOutsideDelegate;

    private ElementReference _cancelElement;
    private ElementReference _contentElement;
    private ValueAtomicBool _hasCancelElement;
    private ValueAtomicBool _pendingCancelFocus;
    private ValueAtomicBool _didFocusCancelForCurrentOpen;
    private ValueAtomicBool _openAutoFocusHandled;

    [CascadingParameter]
    private BradixDialog? Dialog { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }


    [Parameter]
    public EventCallback OnOpenAutoFocus { get; set; }

    [Parameter]
    public EventCallback<BradixAutoFocusEventArgs> OnOpenAutoFocusDetailed { get; set; }

    [Parameter]
    public EventCallback OnCloseAutoFocus { get; set; }

    [Parameter]
    public EventCallback<BradixAutoFocusEventArgs> OnCloseAutoFocusDetailed { get; set; }

    [Parameter]
    public EventCallback OnEscapeKeyDown { get; set; }

    [Parameter]
    public EventCallback<BradixEscapeKeyDownEventArgs> OnEscapeKeyDownDetailed { get; set; }

    [Parameter]
    public bool CloseOnEscapeKeyDown { get; set; } = true;

    [Parameter]
    public EventCallback OnFocusOutside { get; set; }

    [Parameter]
    public EventCallback<BradixFocusOutsideEventArgs> OnFocusOutsideDetailed { get; set; }

    internal void RegisterCancelElement(ElementReference element)
    {
        _cancelElement = element;
        _hasCancelElement.Value = true;
        _ = InvokeAsync(_focusPendingCallback ??= FocusCancelIfPending);
    }

    private Task HandleContentElementCaptured(ElementReference element)
    {
        _contentElement = element;
        return Task.CompletedTask;
    }

    private async Task HandleOpenAutoFocus(BradixAutoFocusEventArgs args)
    {
        if (_openAutoFocusHandled.Value)
        {
            args.PreventDefault();
            return;
        }
        _openAutoFocusHandled.Value = true;

        if (OnOpenAutoFocus.HasDelegate)
            await OnOpenAutoFocus.InvokeAsync();

        if (OnOpenAutoFocusDetailed.HasDelegate)
            await OnOpenAutoFocusDetailed.InvokeAsync(args);

        if (args.DefaultPrevented)
        {
            _pendingCancelFocus.Value = false;
            _didFocusCancelForCurrentOpen.Value = true;
            return;
        }

        args.PreventDefault();
        _pendingCancelFocus.Value = true;
        await FocusCancelIfPending();
    }

    private Task HandlePointerDownOutside(BradixPointerDownOutsideEventArgs args)
    {
        args.PreventDefault();
        _pendingCancelFocus.Value = true;
        _ = InvokeAsync(_focusPendingCallback ??= FocusCancelIfPending);
        return Task.CompletedTask;
    }

    private Task HandleInteractOutside(BradixInteractOutsideEventArgs args)
    {
        args.PreventDefault();
        _pendingCancelFocus.Value = true;
        _ = InvokeAsync(_focusPendingCallback ??= FocusCancelIfPending);
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialog?.CurrentOpen == true && !_didFocusCancelForCurrentOpen.Value)
            _ = InvokeAsync(_focusOpenCallback ??= FocusCancelForOpen);
        else if (Dialog?.CurrentOpen != true)
        {
            _didFocusCancelForCurrentOpen.Value = false;
            _openAutoFocusHandled.Value = false;
            _pendingCancelFocus.Value = false;
        }

        if (_pendingCancelFocus.Value)
            _ = InvokeAsync(_focusPendingCallback ??= FocusCancelIfPending);

        return Task.CompletedTask;
    }

    private async Task FocusCancelIfPending()
    {
        if (!_pendingCancelFocus.Value)
            return;

        try
        {
            await Task.Yield();
            if (await TryFocusCancel())
            {
                _pendingCancelFocus.Value = false;
                _didFocusCancelForCurrentOpen.Value = true;
            }
        }
        catch
        {
        }
    }

    private async Task FocusCancelForOpen()
    {
        if (Dialog?.CurrentOpen != true)
            return;
        await HandleOpenAutoFocus(new BradixAutoFocusEventArgs());
    }

    private async Task<bool> TryFocusCancel()
    {
        if (await ControlsInterop.FocusFirstMatchingDescendant(_contentElement, "[data-bradix-alert-dialog-cancel]"))
            return true;

        if (_hasCancelElement.Value)
        {
            await ControlsInterop.FocusElementPreventScroll(_cancelElement);
            return true;
        }

        return await ControlsInterop.FocusFirstMatchingDescendant(_contentElement, "[autofocus]");
    }
}
