@namespace Soenneker.Bradix
@using Microsoft.JSInterop
@inherits BradixIdentifiableContentElement
@implements IBradixPasswordToggleFieldToggle
@inject IControlsInterop ControlsInterop

<button @ref="_element" @onclick="HandleClick" @attributes="ButtonAttributes">@ChildContent</button>

@code {
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _disposed;
    [CascadingParameter] private BradixPasswordToggleField Field { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"), ("aria-controls", Field.InputId),
        ("data-state", Field.CurrentVisible ? "visible" : "hidden"),
        ("disabled", Disabled ? BradixAttributeValues.True : null));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _module = await ControlsInterop.Initialize();
        if (!_disposed) await _module.InvokeBradixVoidAsync("registerPasswordToggle", _element);
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(args);
        if (!Disabled && !_disposed) await Field.SetVisible(!Field.CurrentVisible);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null) await _module.InvokeBradixVoidAsync("unregisterPasswordToggle", _element);
        }
        catch (JSDisconnectedException) { }
    }
}
