@namespace Soenneker.Bradix
@inherits LeptonContent
@implements IBradixPasswordToggleField

<CascadingValue Value="this">@ChildContent</CascadingValue>

@code {
    private bool _initialized;
    private bool _visible;
    private readonly string _defaultInputId = $"bradix-password-{Guid.NewGuid()}";

    [Parameter] public bool? Visible { get; set; }
    [Parameter] public bool DefaultVisible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<bool> OnVisibilityChange { get; set; }

    internal bool CurrentVisible => Visible ?? _visible;
    internal string InputId { get; private set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _initialized = true;
        _visible = DefaultVisible;
        InputId = _defaultInputId;
    }

    internal void RegisterInput(string? id)
    {
        string next = id ?? _defaultInputId;
        if (InputId == next) return;
        InputId = next;
        _ = RequestRender();
    }

    internal async Task SetVisible(bool visible)
    {
        if (visible == CurrentVisible) return;
        if (Visible is null) _visible = visible;
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(visible);
        if (OnVisibilityChange.HasDelegate) await OnVisibilityChange.InvokeAsync(visible);
        await RequestRender();
    }
}
