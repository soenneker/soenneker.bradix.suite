@using Soenneker.Blazor.Extensions.IJSObjectReferences
@namespace Soenneker.Bradix
@using Microsoft.JSInterop
@inherits BradixIdentifiableElement
@implements IBradixPasswordToggleFieldInput
@inject IControlsInterop ControlsInterop

<input @ref="_element" @attributes="InputAttributes" />

@code {
    private ElementReference _element;
    private DotNetObjectReference<BradixPasswordToggleFieldInput>? _reference;
    private IJSObjectReference? _module;
    private bool _disposed;
    private string? _lastForm;
    private EventCallback<ChangeEventArgs>? _inputCallback;

    [CascadingParameter] private BradixPasswordToggleField Field { get; set; } = null!;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnInput { get; set; }
    [Parameter] public string AutoComplete { get; set; } = "current-password";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Form { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }

    private Dictionary<string, object> InputAttributes => BuildAttributes(
        ("id", Id ?? Field.InputId), ("type", Field.CurrentVisible ? "text" : "password"),
        ("autocomplete", AutoComplete), ("autocapitalize", "off"), ("spellcheck", "false"),
        ("name", Name), ("form", Form), ("value", Value),
        ("disabled", Disabled ? BradixAttributeValues.True : null),
        ("required", Required ? BradixAttributeValues.True : null),
        ("oninput", ValueChanged.HasDelegate || OnInput.HasDelegate
            ? _inputCallback ??= EventCallback.Factory.Create<ChangeEventArgs>(this, HandleInput) : null));

    protected override void OnParametersSet() => Field.RegisterInput(Id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await ControlsInterop.Initialize();
            if (_disposed) return;
            _reference = DotNetObjectReference.Create(this);
        }
        if (_module is null) return;
        if (firstRender || _lastForm != Form)
        {
            await _module.InvokeVoidWithContextAsync("registerPasswordInput", _element, _reference);
            _lastForm = Form;
        }

    }

    private async Task HandleInput(ChangeEventArgs args)
    {
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(args.Value?.ToString());
        if (OnInput.HasDelegate) await OnInput.InvokeAsync(args);
    }

    [JSInvokable] public Task HidePassword() => _disposed ? Task.CompletedTask : Field.SetVisible(false);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null) await _module.InvokeVoidWithContextAsync("unregisterPasswordInput", _element);
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
}
