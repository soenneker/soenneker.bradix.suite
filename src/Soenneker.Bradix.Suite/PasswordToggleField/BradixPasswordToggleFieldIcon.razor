@namespace Soenneker.Bradix
@inherits BradixElement
@implements IBradixPasswordToggleFieldIcon

<span @attributes="IconAttributes">@(Field.CurrentVisible ? Visible : Hidden)</span>

@code {
    private Dictionary<string, object> IconAttributes => BuildAttributes(("aria-hidden", "true"));
    [CascadingParameter] private BradixPasswordToggleField Field { get; set; } = null!;
    [Parameter] public RenderFragment? Visible { get; set; }
    [Parameter] public RenderFragment? Hidden { get; set; }
}
