@namespace Soenneker.Bradix
@implements IBradixPasswordToggleFieldSlot

@if (ChildContent is not null) { @ChildContent(Field.CurrentVisible) }
else if (Field.CurrentVisible) { @Visible }
else { @Hidden }

@code {
    [CascadingParameter] private BradixPasswordToggleField Field { get; set; } = null!;
    [Parameter] public RenderFragment? Visible { get; set; }
    [Parameter] public RenderFragment? Hidden { get; set; }
    [Parameter] public RenderFragment<bool>? ChildContent { get; set; }
}
