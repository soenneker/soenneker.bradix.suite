@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixAspectRatio
<div style="@WrapperStyle" data-radix-aspect-ratio-wrapper="">
    <div @attributes="ContentAttributes">
        @ChildContent
    </div>
</div>

@code {
    private double _lastSafeRatio;
    private string? _wrapperStyle;
    private string? _mergedStyleCache0;

    [Parameter]
    public double Ratio { get; set; } = 1;

    private double SafeRatio => Ratio > 0 ? Ratio : 1;

    private string WrapperStyle
    {
        get
        {
            var ratio = SafeRatio;
            if (_wrapperStyle is null || _lastSafeRatio != ratio)
            {
                _lastSafeRatio = ratio;
                _wrapperStyle = $"position: relative; width: 100%; padding-bottom: {(100 / ratio).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";
            }
            return _wrapperStyle;
        }
    }

    private Dictionary<string, object> ContentAttributes => BuildAttributes(
        ("style", BuildContentStyle()));

    private string BuildContentStyle()
    {
        const string contentStyle = "position: absolute; top: 0; right: 0; bottom: 0; left: 0;";

        return BradixStringCache.MergeStyle(contentStyle, Style, ref _mergedStyleCache0)!;
    }
}
