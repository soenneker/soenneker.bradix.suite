@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids

@inherits BradixIdentifiableContentElement

@implements IBradixToolbarRovingItem
@implements IBradixToolbarToggleItem

@inject IRovingFocusInterop RovingFocusInterop
<button @ref="_element"
        @onclick="HandleClick"
        @onmousedown="HandleMouseDown"
        @onfocus="HandleFocus"
        @onkeydown="HandleKeyDown"
        @attributes="ButtonAttributes">
    @ChildContent
</button>

@code {
    private ElementReference _element;
    private bool _registered;
    private ValueAtomicBool _disposed;
    private bool _rovingRegistered;
    private bool _rovingFocusBridgeReady;

    [CascadingParameter]
    internal BradixToolbar Toolbar { get; set; } = null!;

    [CascadingParameter]
    internal BradixToolbarToggleGroup Group { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    public string? TabStopId { get; private set; }

    internal bool IsPressed => Group.IsItemPressed(Value);

    bool IBradixToolbarRovingItem.IsDisabled => IsDisabled;

    private bool IsDisabled => Group.Disabled || Disabled;

    private Dictionary<string, object> ButtonAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAttributes(
                ("type", "button"),
                ("data-state", IsPressed ? "on" : "off"),
                ("data-disabled", IsDisabled ? string.Empty : null),
                ("data-orientation", Toolbar.Orientation.Value),
                ("data-bradix-roving-group", Toolbar.GroupId),
                ("data-bradix-roving-item", string.Empty),
                ("data-bradix-roving-item-id", TabStopId),
                ("data-bradix-roving-orientation", Toolbar.Orientation.Value),
                ("data-bradix-roving-dir", Toolbar.ResolvedDirection),
                ("data-bradix-roving-loop", Toolbar.Loop ? "true" : "false"),
                ("data-bradix-prevent-nonprimary-mousedown", "true"),
                ("data-bradix-prevent-mousedown-when-disabled", "true"),
                ("disabled", IsDisabled ? true : null),
                ("tabindex", Toolbar.IsCurrentTabStop(this) ? 0 : -1));

            if (Group.IsSingle)
            {
                attributes["role"] = "radio";
                attributes["aria-checked"] = IsPressed ? "true" : "false";
            }
            else
            {
                attributes["aria-pressed"] = IsPressed ? "true" : "false";
            }

            return attributes;
        }
    }

    protected override void OnInitialized()
    {
        TabStopId ??= BlazorIdGenerator.New("bradix-toolbar-toggle-item");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read() || !firstRender)
            return;

        Toolbar.RegisterItem(this);
        _registered = true;
        await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_element);
        if (_disposed.Read())
        {
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
            return;
        }
        _rovingRegistered = true;
        _rovingFocusBridgeReady = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered)
        {
            _registered = false;
            Toolbar.UnregisterItem(this);
        }
        if (_rovingRegistered)
        {
            _rovingRegistered = false;
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
        }
    }

    public ValueTask Focus() => _element.FocusAsync();

    private async Task HandleClick(MouseEventArgs args)
    {
        if (IsDisabled)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);

        if (IsPressed)
            await Group.DeactivateItem(Value);
        else
            await Group.ActivateItem(Value);
    }

    private Task HandleMouseDown(MouseEventArgs _)
    {
        if (!IsDisabled)
            Toolbar.SetCurrentTabStop(TabStopId);

        return Task.CompletedTask;
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        if (!IsDisabled)
            Toolbar.SetCurrentTabStop(TabStopId);

        return Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (_rovingFocusBridgeReady && BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            return Task.CompletedTask;

        return IsDisabled ? Task.CompletedTask : Toolbar.HandleItemKeyDown(this, args);
    }

    [JSInvokable]
    public Task HandleRovingFocusBridgeReady()
    {
        _rovingFocusBridgeReady = true;
        return Task.CompletedTask;
    }
}
