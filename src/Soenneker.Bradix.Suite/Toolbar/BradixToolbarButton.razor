@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids

@inherits BradixIdentifiableContentElement

@implements IBradixToolbarRovingItem
@implements IBradixToolbarButton

@inject IRovingFocusInterop RovingFocusInterop
<button @ref="_element"
        @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
        @onmousedown="(_cachedHandleMouseDownDelegate ??= HandleMouseDown)"
        @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
        @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
        @attributes="ButtonAttributes">
    @ChildContent
</button>

@code {
    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleMouseDownDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private ElementReference _element;
    private bool _registered;
    private ValueAtomicBool _disposed;
    private bool _rovingFocusBridgeReady;

    [CascadingParameter]
    internal BradixToolbar Toolbar { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    public string? TabStopId { get; private set; }

    bool IBradixToolbarRovingItem.IsDisabled => Disabled;

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"),
        ("data-bradix-roving-group", Toolbar.GroupId),
        ("data-bradix-roving-item", string.Empty),
        ("data-bradix-roving-item-id", TabStopId),
        ("data-bradix-roving-orientation", Toolbar.Orientation.Value),
        ("data-bradix-roving-dir", Toolbar.ResolvedDirection),
        ("data-bradix-roving-loop", Toolbar.Loop ? "true" : "false"),
        ("data-bradix-prevent-nonprimary-mousedown", "true"),
        ("data-bradix-prevent-mousedown-when-disabled", "true"),
        ("tabindex", Toolbar.IsCurrentTabStop(this) ? BradixAttributeValues.Zero : BradixAttributeValues.MinusOne),
        ("disabled", Disabled ? BradixAttributeValues.True : null));

    protected override void OnInitialized()
    {
        TabStopId ??= BlazorIdGenerator.New("bradix-toolbar-button");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed.Read())
            return;

        Toolbar.RegisterItem(this);
        _registered = true;
        await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_element);
        if (_disposed.Read())
        {
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
            return;
        }
        _rovingFocusBridgeReady = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered)
        {
            _registered = false;
            Toolbar.UnregisterItem(this);
        }
        await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
    }

    public ValueTask Focus() => _element.FocusAsync();

    private Task HandleClick(MouseEventArgs args) => !Disabled && OnClick.HasDelegate
        ? OnClick.InvokeAsync(args) : Task.CompletedTask;

    private Task HandleMouseDown(MouseEventArgs _)
    {
        if (!Disabled)
            Toolbar.SetCurrentTabStop(TabStopId);

        return Task.CompletedTask;
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        if (!Disabled)
            Toolbar.SetCurrentTabStop(TabStopId);

        return Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (_rovingFocusBridgeReady && BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            return Task.CompletedTask;

        return Disabled ? Task.CompletedTask : Toolbar.HandleItemKeyDown(this, args);
    }

    [JSInvokable]
    public Task HandleRovingFocusBridgeReady()
    {
        _rovingFocusBridgeReady = true;
        return Task.CompletedTask;
    }
}
