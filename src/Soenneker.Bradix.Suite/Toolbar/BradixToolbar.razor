@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixToolbar

<CascadingValue Value="this">
    <div @attributes="RootAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<IBradixToolbarRovingItem> _items = [];

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Horizontal;

    [Parameter]
    public bool Loop { get; set; } = true;

    [Parameter]
    public string? Dir { get; set; }

    internal string GroupId { get; private set; } = string.Empty;

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal string? CurrentTabStopId { get; private set; }

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("role", "toolbar"),
        ("aria-orientation", Orientation.Value),
        ("dir", ResolvedDirection));

    protected override void OnInitialized()
    {
        GroupId = BlazorIdGenerator.New("bradix-toolbar");
    }

    protected override void OnParametersSet()
    {
        EnsureCurrentTabStopId();
    }

    internal bool IsCurrentTabStop(IBradixToolbarRovingItem item)
    {
        return string.Equals(CurrentTabStopId, item.TabStopId, StringComparison.Ordinal);
    }

    internal void RegisterItem(IBradixToolbarRovingItem item)
    {
        if (_items.Contains(item))
            return;

        _items.Add(item);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void UnregisterItem(IBradixToolbarRovingItem item)
    {
        _items.Remove(item);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void SetCurrentTabStop(string? tabStopId)
    {
        if (string.Equals(CurrentTabStopId, tabStopId, StringComparison.Ordinal))
            return;

        CurrentTabStopId = tabStopId;
        _ = InvokeAsync(StateHasChanged);
    }

    internal async Task HandleItemKeyDown(IBradixToolbarRovingItem item, KeyboardEventArgs args)
    {
        if (args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
            return;

        int focusableCount = CountFocusableItems(item, out int currentIndex);

        if (currentIndex < 0)
            return;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(
                args.Key,
                Orientation.Value,
                ResolvedDirection,
                currentIndex,
                focusableCount,
                Loop,
                out int targetIndex))
        {
            return;
        }

        IBradixToolbarRovingItem target = GetFocusableItemAt(targetIndex)!;
        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
    }

    private void EnsureCurrentTabStopId()
    {
        IBradixToolbarRovingItem? first = null;
        foreach (IBradixToolbarRovingItem item in _items)
        {
            if (item.IsDisabled)
                continue;
            first ??= item;
            if (CurrentTabStopId is not null && string.Equals(item.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
                return;
        }
        CurrentTabStopId = first?.TabStopId;
    }

    private int CountFocusableItems(IBradixToolbarRovingItem current, out int currentIndex)
    {
        currentIndex = -1;
        int count = 0;
        foreach (IBradixToolbarRovingItem item in _items)
        {
            if (item.IsDisabled)
                continue;
            if (ReferenceEquals(item, current))
                currentIndex = count;
            count++;
        }
        return count;
    }

    private IBradixToolbarRovingItem? GetFocusableItemAt(int targetIndex)
    {
        int index = 0;
        foreach (IBradixToolbarRovingItem item in _items)
        {
            if (!item.IsDisabled && index++ == targetIndex)
                return item;
        }
        return null;
    }

    private static bool ContainsTabStopId(IEnumerable<IBradixToolbarRovingItem> items, string tabStopId)
    {
        foreach (IBradixToolbarRovingItem item in items)
        {
            if (string.Equals(item.TabStopId, tabStopId, StringComparison.Ordinal))
                return true;
        }

        return false;
    }
}
