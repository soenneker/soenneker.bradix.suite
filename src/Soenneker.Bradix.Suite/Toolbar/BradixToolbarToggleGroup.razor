@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixToolbarToggleGroup
<CascadingValue Value="this">
    <div @attributes="RootAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private bool _initialized;
    private string _uncontrolledValue = string.Empty;
    private List<string> _uncontrolledValues = [];

    [CascadingParameter]
    internal BradixToolbar Toolbar { get; set; } = null!;

    [Parameter]
    public SelectionMode Type { get; set; } = SelectionMode.Single;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public IReadOnlyCollection<string>? Values { get; set; }

    [Parameter]
    public IEnumerable<string>? DefaultValues { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> ValuesChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> OnValuesChange { get; set; }

    internal bool IsSingle => Type != SelectionMode.Multiple;

    private bool IsSingleControlled => Value is not null || ValueChanged.HasDelegate || OnValueChange.HasDelegate;

    private bool IsMultipleControlled => Values is not null || ValuesChanged.HasDelegate || OnValuesChange.HasDelegate;

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("role", "group"),
        ("dir", Toolbar.ResolvedDirection),
        ("data-orientation", Toolbar.Orientation.Value));

    protected override void OnParametersSet()
    {
        if (_initialized)
            return;

        _uncontrolledValue = NormalizeSingleValue(DefaultValue);
        _uncontrolledValues = BradixStringCollection.CopyValues(DefaultValues);
        _initialized = true;
    }

    internal bool IsItemPressed(string value)
    {
        if (IsSingle)
            return string.Equals(NormalizeSingleValue(IsSingleControlled ? Value : _uncontrolledValue), value, StringComparison.Ordinal);

        IReadOnlyCollection<string> values = IsMultipleControlled ? Values ?? [] : _uncontrolledValues;
        return BradixStringCollection.ContainsOrdinal(values, value);
    }

    internal async Task ActivateItem(string value)
    {
        if (IsSingle)
        {
            await SetSingleValue(value);
            return;
        }

        List<string> next = IsMultipleControlled ? BradixStringCollection.CopyValues(Values) : [.. _uncontrolledValues];

        if (BradixStringCollection.ContainsOrdinal(next, value))
            return;

        next.Add(value);
        await SetMultipleValues(next);
    }

    internal async Task DeactivateItem(string value)
    {
        if (IsSingle)
        {
            await SetSingleValue(string.Empty);
            return;
        }

        List<string> next = IsMultipleControlled ? BradixStringCollection.CopyValues(Values) : [.. _uncontrolledValues];

        if (!BradixStringCollection.RemoveAllOrdinal(next, value))
            return;

        await SetMultipleValues(next);
    }

    private async Task SetSingleValue(string? value)
    {
        string normalizedValue = NormalizeSingleValue(value);

        if (string.Equals(NormalizeSingleValue(IsSingleControlled ? Value : _uncontrolledValue), normalizedValue, StringComparison.Ordinal))
            return;

        if (!IsSingleControlled)
            _uncontrolledValue = normalizedValue;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(normalizedValue);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(normalizedValue);

        await RequestRender();
    }

    private async Task SetMultipleValues(List<string> next)
    {
        if (!IsMultipleControlled)
            _uncontrolledValues = next;

        if (ValuesChanged.HasDelegate)
            await ValuesChanged.InvokeAsync(next);

        if (OnValuesChange.HasDelegate)
            await OnValuesChange.InvokeAsync(next);

        await RequestRender();
    }

    private static string NormalizeSingleValue(string? value)
    {
        return value ?? string.Empty;
    }

}
