@namespace Soenneker.Bradix

@inherits LeptonContent

@using Soenneker.Blazor.Utils.Ids
@implements IBradixMenubarMenu

<BradixMenu Open="@IsOpen"
            OpenChanged="(_cachedHandleMenuOpenChangedDelegate ??= HandleMenuOpenChanged)"
            Dir="@Menubar?.ResolvedDirection"
            Modal="false">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</BradixMenu>

@code {
    private string? _childIdCache0;
    private string? _childIdCache1;

    private System.Func<bool, Task>? _cachedHandleMenuOpenChangedDelegate;

    [CascadingParameter]
    internal BradixMenubar? Menubar { get; set; }

    [Parameter]
    public string? Value { get; set; }

    internal string? AutoValue { get; private set; }

    public string? BaseId { get; private set; }

    internal bool WasKeyboardTriggerOpen { get; private set; }

    internal string CurrentValue => Value ?? AutoValue!;

    internal string TriggerId => BradixStringCache.ChildId(BaseId!, "trigger", ref _childIdCache0);

    internal string ContentId => BradixStringCache.ChildId(BaseId!, "content", ref _childIdCache1);

    internal bool IsOpen => string.Equals(Menubar?.CurrentValue, CurrentValue, StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        BaseId ??= BlazorIdGenerator.New("bradix-menubar-menu");
        AutoValue ??= BlazorIdGenerator.New("bradix-menubar-value");
    }

    internal void MarkKeyboardTriggerOpen()
    {
        WasKeyboardTriggerOpen = true;
    }

    internal void ResetKeyboardTriggerOpen()
    {
        WasKeyboardTriggerOpen = false;
    }

    private Task HandleMenuOpenChanged(bool open)
    {
        if (open)
            return Menubar?.OpenMenu(CurrentValue) ?? Task.CompletedTask;

        ResetKeyboardTriggerOpen();

        if (!string.Equals(Menubar?.CurrentValue, CurrentValue, StringComparison.Ordinal))
            return Task.CompletedTask;

        return Menubar?.CloseMenu() ?? Task.CompletedTask;
    }
}
