@namespace Soenneker.Bradix

@implements IBradixMenubarSubTrigger
<BradixMenuSubTrigger Id="@Id"
                      Class="@Class"
                      Style="@Style"
                      TextValue="@TextValue"
                      Disabled="@Disabled"
                      AdditionalAttributes="@MergedAttributes">
    @ChildContent
</BradixMenuSubTrigger>

@code {
    private readonly BradixAttributeDictionary _attributeDictionaries = new();

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? TextValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private IReadOnlyDictionary<string, object> MergedAttributes
    {
        get
        {
            Dictionary<string, object> attributes = _attributeDictionaries.Create(AdditionalAttributes, 1);

            attributes["data-radix-menubar-subtrigger"] = string.Empty;
            return attributes;
        }
    }
}
