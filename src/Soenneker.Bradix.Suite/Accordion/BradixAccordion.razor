@namespace Soenneker.Bradix

@using Soenneker.Blazor.Utils.Ids

@inherits LeptonContentElement

@implements IBradixAccordion
<CascadingValue Value="this">
    <div @attributes="RootAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<BradixAccordionTrigger> _triggers = [];
    private bool _initialized;
    private string? _groupId;
    private string? _uncontrolledValue;
    private List<string> _uncontrolledValues = [];

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public SelectionMode Type { get; set; } = SelectionMode.Single;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;
     
    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public bool Collapsible { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public IReadOnlyCollection<string>? Values { get; set; }

    [Parameter]
    public IEnumerable<string>? DefaultValues { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> ValuesChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> OnValuesChange { get; set; }

    internal bool IsCollapsible => Type == SelectionMode.Multiple || Collapsible;
    internal string GroupId => _groupId ??= BlazorIdGenerator.New("bradix-accordion-group");
    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    private bool IsSingle => Type == SelectionMode.Single;

    private IReadOnlyDictionary<string, object> RootAttributes => BuildAttributes(
        ("data-orientation", Orientation.Value),
        ("dir", ResolvedDirection));

    protected override void OnParametersSet()
    {
        if (_initialized)
            return;

        _uncontrolledValue = DefaultValue;
        _uncontrolledValues = CopyValues(DefaultValues);

        _initialized = true;
    }

    internal bool IsItemOpen(string value)
    {
        if (IsSingle)
            return string.Equals(Value ?? _uncontrolledValue, value, StringComparison.Ordinal);

        IReadOnlyCollection<string> values = Values ?? _uncontrolledValues;
        return ContainsOrdinal(values, value);
    }

    internal async Task OpenItem(string value)
    {
        if (IsSingle)
        {
            await SetSingleValue(value);
            return;
        }

        List<string> next = Values is not null
            ? CopyValues(Values)
            : [.. _uncontrolledValues];

        if (!next.Contains(value, StringComparer.Ordinal))
        {
            next.Add(value);
            await SetMultipleValues(next);
        }
    }

    internal async Task CloseItem(string value)
    {
        if (IsSingle)
        {
            if (!IsCollapsible)
                return;

            await SetSingleValue(null);
            return;
        }

        List<string> next = Values is not null
            ? CopyValues(Values)
            : [.. _uncontrolledValues];

        if (next.RemoveAll(item => string.Equals(item, value, StringComparison.Ordinal)) > 0)
            await SetMultipleValues(next);
    }

    internal void RegisterTrigger(BradixAccordionTrigger trigger)
    {
        if (_triggers.Contains(trigger))
            return;

        _triggers.Add(trigger);
    }

    internal void UnregisterTrigger(BradixAccordionTrigger trigger)
    {
        _triggers.Remove(trigger);
    }

    internal async Task HandleTriggerKeyDown(BradixAccordionTrigger trigger, KeyboardEventArgs args)
    {
        List<BradixAccordionTrigger> enabledTriggers = GetEnabledTriggers();

        if (enabledTriggers.Count == 0)
            return;

        int currentIndex = enabledTriggers.IndexOf(trigger);

        if (currentIndex < 0)
            return;

        int nextIndex = currentIndex;

        switch (args.Key)
        {
            case "Home":
                nextIndex = 0;
                break;
            case "End":
                nextIndex = enabledTriggers.Count - 1;
                break;
            case "ArrowDown" when Orientation.Value == Orientation.VerticalValue:
                nextIndex = (currentIndex + 1) % enabledTriggers.Count;
                break;
            case "ArrowUp" when Orientation.Value == Orientation.VerticalValue:
                nextIndex = (currentIndex - 1 + enabledTriggers.Count) % enabledTriggers.Count;
                break;
            case "ArrowRight" when Orientation.Value == Orientation.HorizontalValue:
                nextIndex = ResolvedDirection == "rtl"
                    ? (currentIndex - 1 + enabledTriggers.Count) % enabledTriggers.Count
                    : (currentIndex + 1) % enabledTriggers.Count;
                break;
            case "ArrowLeft" when Orientation.Value == Orientation.HorizontalValue:
                nextIndex = ResolvedDirection == "rtl"
                    ? (currentIndex + 1) % enabledTriggers.Count
                    : (currentIndex - 1 + enabledTriggers.Count) % enabledTriggers.Count;
                break;
            default:
                return;
        }

        await enabledTriggers[nextIndex].Focus();
    }

    private async Task SetSingleValue(string? value)
    {
        if (string.Equals(Value ?? _uncontrolledValue, value, StringComparison.Ordinal))
            return;

        if (Value is null)
            _uncontrolledValue = value;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(value);

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetMultipleValues(List<string> next)
    {
        if (Values is null)
            _uncontrolledValues = next;

        if (ValuesChanged.HasDelegate)
            await ValuesChanged.InvokeAsync(next);

        if (OnValuesChange.HasDelegate)
            await OnValuesChange.InvokeAsync(next);

        await InvokeAsync(StateHasChanged);
    }

    private List<BradixAccordionTrigger> GetEnabledTriggers()
    {
        List<BradixAccordionTrigger> enabledTriggers = [];

        foreach (BradixAccordionTrigger trigger in _triggers)
        {
            if (!trigger.IsDisabled)
                enabledTriggers.Add(trigger);
        }

        return enabledTriggers;
    }

    private static List<string> CopyValues(IEnumerable<string>? values)
    {
        if (values is null)
            return [];

        if (values is IReadOnlyCollection<string> readOnlyCollection)
        {
            List<string> result = new(readOnlyCollection.Count);

            foreach (string value in readOnlyCollection)
                result.Add(value);

            return result;
        }

        if (values is ICollection<string> collection)
        {
            List<string> result = new(collection.Count);

            foreach (string value in collection)
                result.Add(value);

            return result;
        }

        return [.. values];
    }

    private static bool ContainsOrdinal(IEnumerable<string> values, string value)
    {
        foreach (string candidate in values)
        {
            if (string.Equals(candidate, value, StringComparison.Ordinal))
                return true;
        }

        return false;
    }
}
