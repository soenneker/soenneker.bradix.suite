@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixAccordionItem

<CascadingValue Value="this" >
    <BradixCollapsible Id="@BaseId" Class="@Class" Style="@Style" Open="@IsOpen" Disabled="@IsDisabled" OnOpenChange="(_cachedHandleOpenChangeDelegate ??= HandleOpenChange)" AdditionalAttributes="ItemAttributes" >
        @ChildContent
    </BradixCollapsible>
</CascadingValue>

@implements IDisposable

@code {
    public void Dispose() => UnsubscribeOwner();
    private BradixAccordion? _subscribedOwner;
    private (bool, bool, string, string, bool) _ownerState = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_subscribedOwner, Accordion))
        {
            if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
            _subscribedOwner = Accordion;
            _subscribedOwner.StateChanged += OnOwnerStateChanged;
        }
        _ownerState = (IsOpen, IsDisabled, Accordion.Orientation.Value, Accordion.ResolvedDirection, Accordion.IsCollapsible);
    }

    private void OnOwnerStateChanged()
    {
        var state = (IsOpen, IsDisabled, Accordion.Orientation.Value, Accordion.ResolvedDirection, Accordion.IsCollapsible);
        if (EqualityComparer<(bool, bool, string, string, bool)>.Default.Equals(_ownerState, state)) return;
        _ownerState = state;
        _ = RequestRender();
    }

    private void UnsubscribeOwner()
    {
        if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
        _subscribedOwner = null;
    }

    private string? _triggerIdCache;
    private System.Func<bool, Task>? _cachedHandleOpenChangeDelegate;


    [CascadingParameter]
    internal BradixAccordion Accordion { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    private string? _generatedBaseId;

    internal string BaseId => Id.HasContent() ? Id! : _generatedBaseId ??= BlazorIdGenerator.New("bradix-accordion-item");

    internal string TriggerId => BradixStringCache.ChildId(BaseId, "trigger", ref _triggerIdCache);

    internal bool IsOpen => Accordion.IsItemOpen(Value);

    internal bool IsDisabled => Accordion.Disabled || Disabled;

    protected override void OnInitialized()
    {
        _ = BaseId;
    }

    private IReadOnlyDictionary<string, object> ItemAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(1);

            attributes["data-orientation"] = Accordion.Orientation.Value;

            return attributes;
        }
    }

    private Task HandleOpenChange(bool open)
    {
        return open ? Accordion.OpenItem(Value) : Accordion.CloseItem(Value);
    }

}
