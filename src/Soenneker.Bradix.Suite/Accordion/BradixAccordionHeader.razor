@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixAccordionHeader

<h3 @attributes="HeaderAttributes" >
    @ChildContent
</h3>

@implements IDisposable

@code {
    public void Dispose() => UnsubscribeOwner();
    private BradixAccordion? _subscribedOwner;
    private (bool, bool, string) _ownerState = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_subscribedOwner, Accordion))
        {
            if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
            _subscribedOwner = Accordion;
            _subscribedOwner.StateChanged += OnOwnerStateChanged;
        }
        _ownerState = (Item.IsOpen, Item.IsDisabled, Accordion.Orientation.Value);
    }

    private void OnOwnerStateChanged()
    {
        var state = (Item.IsOpen, Item.IsDisabled, Accordion.Orientation.Value);
        if (EqualityComparer<(bool, bool, string)>.Default.Equals(_ownerState, state)) return;
        _ownerState = state;
        _ = RequestRender();
    }

    private void UnsubscribeOwner()
    {
        if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
        _subscribedOwner = null;
    }


    [CascadingParameter]
    internal BradixAccordion Accordion { get; set; } = null!;

    [CascadingParameter]
    internal BradixAccordionItem Item { get; set; } = null!;

    private IReadOnlyDictionary<string, object> HeaderAttributes => BuildAttributes(("data-orientation", Accordion.Orientation.Value), ("data-state", BradixDataStates.Open(Item.IsOpen)), ("data-disabled", Item.IsDisabled ? string.Empty : null));
}
