@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixAccordionContent
<BradixCollapsibleContent Id="@Id" Class="@Class" Style="@MergedStyle" ForceMount="@ForceMount" Role="region" AriaLabelledBy="@Item.TriggerId" AdditionalAttributes="ContentAttributes" >
    @ChildContent
</BradixCollapsibleContent>

@code {
    private string? _mergedStyleCache0;


    [CascadingParameter]
    internal BradixAccordion Accordion { get; set; } = null!;

    [CascadingParameter]
    internal BradixAccordionItem Item { get; set; } = null!;

    [Parameter]
    public bool ForceMount { get; set; }

    private string MergedStyle
    {
        get
        {
            const string radixAliasStyles = "--radix-accordion-content-height: var(--radix-collapsible-content-height); --radix-accordion-content-width: var(--radix-collapsible-content-width);";

            return BradixStringCache.MergeStyle(radixAliasStyles, Style, ref _mergedStyleCache0)!;
        }
    }

    private IReadOnlyDictionary<string, object> ContentAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(1);

            attributes["data-orientation"] = Accordion.Orientation.Value;

            return attributes;
        }
    }

}
