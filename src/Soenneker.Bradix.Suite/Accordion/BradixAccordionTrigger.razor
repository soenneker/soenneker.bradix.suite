@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixAccordionTrigger

@inject IRovingFocusInterop RovingFocusInterop
<BradixCollapsibleTrigger @ref="_trigger"
                          Id="@Item.TriggerId"
                          Class="@Class"
                          Style="@Style"
                          AriaDisabled="@AriaDisabled"
                          OnClick="@OnClick"
                          OnKeyDown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
                          AdditionalAttributes="TriggerAttributes">
    @ChildContent
</BradixCollapsibleTrigger>

@code {
    private BradixAccordion? _subscribedOwner;
    private (bool, bool, string, string, bool) _ownerState = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_subscribedOwner, Accordion))
        {
            if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
            _subscribedOwner = Accordion;
            _subscribedOwner.StateChanged += OnOwnerStateChanged;
        }
        _ownerState = (Item.IsOpen, Item.IsDisabled, Accordion.Orientation.Value, Accordion.ResolvedDirection, Accordion.IsCollapsible);
    }

    private void OnOwnerStateChanged()
    {
        var state = (Item.IsOpen, Item.IsDisabled, Accordion.Orientation.Value, Accordion.ResolvedDirection, Accordion.IsCollapsible);
        if (EqualityComparer<(bool, bool, string, string, bool)>.Default.Equals(_ownerState, state)) return;
        _ownerState = state;
        _ = RequestRender();
    }

    private void UnsubscribeOwner()
    {
        if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
        _subscribedOwner = null;
    }

    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private BradixCollapsibleTrigger? _trigger;
    private ValueAtomicBool _disposed;
    private ValueAtomicBool _asyncDisposed;

    [CascadingParameter]
    internal BradixAccordion Accordion { get; set; } = null!;

    [CascadingParameter]
    internal BradixAccordionItem Item { get; set; } = null!;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    internal bool IsDisabled => Item.IsDisabled;

    private string? AriaDisabled => Item.IsOpen && !Accordion.IsCollapsible ? "true" : null;

    private IReadOnlyDictionary<string, object> TriggerAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(7);

            attributes["data-orientation"] = Accordion.Orientation.Value;
            attributes["data-bradix-roving-group"] = Accordion.GroupId;
            attributes["data-bradix-roving-item"] = string.Empty;
            attributes["data-bradix-roving-orientation"] = Accordion.Orientation.Value;
            attributes["data-bradix-roving-dir"] = Accordion.ResolvedDirection;
            attributes["data-bradix-roving-loop"] = "true";
            attributes["data-bradix-roving-ignore-aria-disabled"] = "true";

            return attributes;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed.Read())
            return;

        Accordion.RegisterTrigger(this);

        if (_trigger is not null)
        {
            await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_trigger.Element);
            if (_disposed.Read())
                await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_trigger.Element);
        }
    }

    public void Dispose()
    {
        UnsubscribeOwner();
        if (!_disposed.TrySetTrue())
            return;
        Accordion.UnregisterTrigger(this);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_asyncDisposed.TrySetTrue())
            return;

        Dispose();
        if (_trigger is not null)
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_trigger.Element);
    }

    internal ValueTask Focus()
    {
        return _trigger?.Focus() ?? ValueTask.CompletedTask;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(args);

        if (IsDisabled)
            return;

        await Accordion.HandleTriggerKeyDown(this, args);
    }

}
