@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixTabs

<CascadingValue Value="this">
    <div @attributes="RootAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<BradixTabsTrigger> _triggers = [];
    private bool _initialized;
    private string? _uncontrolledValue;

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Horizontal;

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public TabsActivationMode ActivationMode { get; set; } = TabsActivationMode.Automatic;

    internal string? BaseId { get; private set; }

    internal string? CurrentTabStopId { get; private set; }

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal string CurrentValue => Value ?? _uncontrolledValue ?? string.Empty;

    internal bool IsAutomaticActivation => ActivationMode != TabsActivationMode.Manual;

    internal string RovingOrientationValue => Orientation.Value;

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("dir", ResolvedDirection),
        ("data-orientation", Orientation.Value));

    protected override void OnInitialized()
    {
        BaseId ??= BlazorIdGenerator.New("bradix-tabs");
    }

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            EnsureCurrentTabStopId();
            return;
        }

        _uncontrolledValue = DefaultValue;
        _initialized = true;
        EnsureCurrentTabStopId();
    }

    internal string MakeTriggerId(string value) =>
        BlazorIdGenerator.Child(BlazorIdGenerator.Child(BaseId!, "trigger"), value);

    internal string MakeContentId(string value) =>
        BlazorIdGenerator.Child(BlazorIdGenerator.Child(BaseId!, "content"), value);

    internal void RegisterTrigger(BradixTabsTrigger trigger)
    {
        if (_triggers.Contains(trigger))
            return;

        _triggers.Add(trigger);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void UnregisterTrigger(BradixTabsTrigger trigger)
    {
        _triggers.Remove(trigger);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal bool IsCurrentTabStop(BradixTabsTrigger trigger)
    {
        return string.Equals(CurrentTabStopId, trigger.TabStopId, StringComparison.Ordinal);
    }

    internal void SetCurrentTabStop(string? tabStopId)
    {
        if (string.Equals(CurrentTabStopId, tabStopId, StringComparison.Ordinal))
            return;

        CurrentTabStopId = tabStopId;
        _ = InvokeAsync(StateHasChanged);
    }

    internal async Task HandleTriggerKeyDown(BradixTabsTrigger trigger, bool loop, KeyboardEventArgs args)
    {
        if (args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
            return;

        var focusableCount = CountFocusableTriggers(out var currentIndex, trigger);

        if (currentIndex < 0)
            return;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(
                args.Key,
                RovingOrientationValue,
                ResolvedDirection,
                currentIndex,
                focusableCount,
                loop,
                out int targetIndex))
        {
            return;
        }

        BradixTabsTrigger? target = GetFocusableTriggerAt(targetIndex);

        if (target is null)
            return;

        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
    }

    internal async Task HandleListKeyDown(bool loop, KeyboardEventArgs args)
    {
        if (args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
            return;

        var focusableCount = CountFocusableTriggers(out var selectedIndex, out var tabStopIndex);

        if (focusableCount == 0)
            return;

        var currentIndex = selectedIndex >= 0 ? selectedIndex : tabStopIndex >= 0 ? tabStopIndex : 0;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(
                args.Key,
                RovingOrientationValue,
                ResolvedDirection,
                currentIndex,
                focusableCount,
                loop,
                out int targetIndex))
        {
            return;
        }

        BradixTabsTrigger? target = GetFocusableTriggerAt(targetIndex);

        if (target is null)
            return;

        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
    }

    internal async Task SetValue(string value)
    {
        if (string.Equals(CurrentValue, value, StringComparison.Ordinal))
            return;

        if (Value is null)
            _uncontrolledValue = value;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(value);

        EnsureCurrentTabStopId();
        await InvokeAsync(StateHasChanged);
    }

    private void EnsureCurrentTabStopId()
    {
        var hasFocusableTrigger = false;
        var hasCurrentTabStop = false;

        foreach (BradixTabsTrigger trigger in _triggers)
        {
            if (trigger.IsDisabled)
                continue;

            hasFocusableTrigger = true;

            if (CurrentTabStopId is not null && string.Equals(trigger.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
            {
                hasCurrentTabStop = true;
                break;
            }
        }

        if (!hasFocusableTrigger)
        {
            CurrentTabStopId = null;
            return;
        }

        if (hasCurrentTabStop)
            return;

        if (CurrentTabStopId is not null)
            CurrentTabStopId = null;
    }

    private int CountFocusableTriggers(out int selectedIndex, out int tabStopIndex)
    {
        selectedIndex = -1;
        tabStopIndex = -1;
        var index = 0;

        foreach (BradixTabsTrigger trigger in _triggers)
        {
            if (trigger.IsDisabled)
                continue;

            if (selectedIndex < 0 && trigger.IsSelected)
                selectedIndex = index;

            if (tabStopIndex < 0 && CurrentTabStopId is not null && string.Equals(trigger.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
                tabStopIndex = index;

            index++;
        }

        return index;
    }

    private int CountFocusableTriggers(out int currentIndex, BradixTabsTrigger current)
    {
        currentIndex = -1;
        var index = 0;

        foreach (BradixTabsTrigger trigger in _triggers)
        {
            if (trigger.IsDisabled)
                continue;

            if (ReferenceEquals(trigger, current))
                currentIndex = index;

            index++;
        }

        return index;
    }

    private BradixTabsTrigger? GetFocusableTriggerAt(int targetIndex)
    {
        var index = 0;

        foreach (BradixTabsTrigger trigger in _triggers)
        {
            if (trigger.IsDisabled)
                continue;

            if (index == targetIndex)
                return trigger;

            index++;
        }

        return null;
    }
}
