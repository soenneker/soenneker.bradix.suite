@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixTabsList
<CascadingValue Value="this">
    <div @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
         @attributes="ListAttributes">
        @ChildContent
    </div>
</CascadingValue>

@implements IHandleEvent

@code {
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    // State changes render through the owning context or the explicit focus handlers.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    [CascadingParameter]
    internal BradixTabs Tabs { get; set; } = null!;

    [Parameter]
    public bool Loop { get; set; } = true;

    private Dictionary<string, object> ListAttributes => BuildAttributes(
        ("role", "tablist"),
        ("aria-orientation", Tabs.RovingOrientationValue),
        ("data-orientation", Tabs.RovingOrientationValue),
        ("tabindex", BradixAttributeValues.Zero));

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        return Tabs.HandleListKeyDown(Loop, args);
    }
}
