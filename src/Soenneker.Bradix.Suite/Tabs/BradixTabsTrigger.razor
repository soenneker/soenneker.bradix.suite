@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixIdentifiableContentElement

@implements IBradixTabsTrigger

@inject IRovingFocusInterop RovingFocusInterop
<button @ref="_element"
        @onmousedown="(_cachedHandleMouseDownDelegate ??= HandleMouseDown)"
        @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
        @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
        @attributes="TriggerAttributes">
    @ChildContent
</button>

@implements IHandleEvent

@code {
    private BradixTabs? _subscribedOwner;
    private (bool, bool, string, string, bool) _ownerState = default!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_subscribedOwner, Tabs))
        {
            if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
            _subscribedOwner = Tabs;
            _subscribedOwner.StateChanged += OnOwnerStateChanged;
        }
        _ownerState = (IsSelected, Tabs.IsCurrentTabStop(this), Tabs.RovingOrientationValue, Tabs.ResolvedDirection, Tabs.IsAutomaticActivation);
    }

    private void OnOwnerStateChanged()
    {
        var state = (IsSelected, Tabs.IsCurrentTabStop(this), Tabs.RovingOrientationValue, Tabs.ResolvedDirection, Tabs.IsAutomaticActivation);
        if (EqualityComparer<(bool, bool, string, string, bool)>.Default.Equals(_ownerState, state)) return;
        _ownerState = state;
        _ = RequestRender();
    }

    private void UnsubscribeOwner()
    {
        if (_subscribedOwner is not null) _subscribedOwner.StateChanged -= OnOwnerStateChanged;
        _subscribedOwner = null;
    }

    private string? _triggerId;
    private string? _contentId;
    private System.Func<MouseEventArgs, Task>? _cachedHandleMouseDownDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;

    // State changes render through the owning context or the explicit focus handlers.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    private ElementReference _element;
    private bool _rovingFocusBridgeReady;
    private bool _registered;
    private ValueAtomicBool _disposed;
    private bool _rovingRegistered;

    [CascadingParameter]
    internal BradixTabs Tabs { get; set; } = null!;

    [CascadingParameter]
    internal BradixTabsList? List { get; set; }

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnMouseDown { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public EventCallback<FocusEventArgs> OnFocus { get; set; }

    internal bool IsDisabled => Disabled;

    internal bool IsSelected => string.Equals(Tabs.CurrentValue, Value, StringComparison.Ordinal);

    internal string TabStopId => TriggerId;

    private string TriggerId => Tabs.MakeTriggerId(Value, ref _triggerId);

    private string ContentId => Tabs.MakeContentId(Value, ref _contentId);

    private Dictionary<string, object> TriggerAttributes => BuildAttributes(
        ("type", "button"),
        ("role", "tab"),
        ("aria-selected", IsSelected ? "true" : "false"),
        ("aria-controls", ContentId),
        ("data-state", IsSelected ? "active" : "inactive"),
        ("data-disabled", Disabled ? string.Empty : null),
        ("data-orientation", Tabs.RovingOrientationValue),
        ("data-bradix-roving-group", Tabs.BaseId),
        ("data-bradix-roving-item", string.Empty),
        ("data-bradix-roving-item-id", TabStopId),
        ("data-bradix-roving-orientation", Tabs.RovingOrientationValue),
        ("data-bradix-roving-dir", Tabs.ResolvedDirection),
        ("data-bradix-roving-loop", (List?.Loop ?? true) ? "true" : "false"),
        ("data-bradix-prevent-nonprimary-mousedown", "true"),
        ("data-bradix-prevent-mousedown-when-disabled", "true"),
        ("disabled", Disabled ? BradixAttributeValues.True : null),
        ("id", TriggerId),
        ("tabindex", !Disabled && Tabs.IsCurrentTabStop(this) ? BradixAttributeValues.Zero : BradixAttributeValues.MinusOne));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read() || !firstRender)
            return;

        Tabs.RegisterTrigger(this);
        _registered = true;
        await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_element);
        if (_disposed.Read())
        {
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
            return;
        }
        _rovingRegistered = true;
        _rovingFocusBridgeReady = true;
    }

    public async ValueTask DisposeAsync()
    {
        UnsubscribeOwner();
        if (!_disposed.TrySetTrue())
            return;
        if (_registered)
        {
            _registered = false;
            Tabs.UnregisterTrigger(this);
        }
        if (_rovingRegistered)
        {
            _rovingRegistered = false;
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
        }
    }

    internal ValueTask Focus()
    {
        return _element.FocusAsync();
    }

    private async Task HandleMouseDown(MouseEventArgs args)
    {
        if (OnMouseDown.HasDelegate)
            await OnMouseDown.InvokeAsync(args);

        if (Disabled)
            return;

        if (args.Button == 0 && !args.CtrlKey)
        {
            Tabs.SetCurrentTabStop(TabStopId);
            await Tabs.SetValue(Value);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(args);

        if (Disabled)
            return;

        if (_rovingFocusBridgeReady && BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            return;

        if (args.Key is " " or "Enter" or "Spacebar")
        {
            await Tabs.SetValue(Value);
            return;
        }

        await Tabs.HandleTriggerKeyDown(this, List?.Loop ?? true, args);
    }

    private async Task HandleFocus(FocusEventArgs args)
    {
        if (OnFocus.HasDelegate)
            await OnFocus.InvokeAsync(args);

        if (Disabled)
            return;

        Tabs.SetCurrentTabStop(TabStopId);

        if (!IsSelected && Tabs.IsAutomaticActivation)
            await Tabs.SetValue(Value);
    }

    [JSInvokable]
    public Task HandleRovingFocusBridgeReady()
    {
        _rovingFocusBridgeReady = true;
        return Task.CompletedTask;
    }
}
