@namespace Soenneker.Bradix

@inherits LeptonIdentifiableContentElement
@implements IBradixContextMenuItem
<BradixMenuItem Id="@Id"
                Class="@Class"
                Style="@Style"
                TextValue="@TextValue"
                Disabled="@Disabled"
                CloseOnSelect="@CloseOnSelect"
                OnSelect="@OnSelect"
                OnSelectDetailed="@OnSelectDetailed"
                AdditionalAttributes="@AdditionalAttributes">
    @ChildContent
</BradixMenuItem>

@code {
    [Parameter]
    public string? TextValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    [Parameter]
    public EventCallback OnSelect { get; set; }

    [Parameter]
    public EventCallback<BradixMenuItemSelectEventArgs> OnSelectDetailed { get; set; }
}
