@namespace Soenneker.Bradix

@inherits BradixContentElement
@implements IBradixContextMenuArrow
<BradixMenuArrow Class="@Class"
                 Style="@Style"
                 Width="@Width"
                 Height="@Height"
                 AdditionalAttributes="@AdditionalAttributes">
    @ChildContent
</BradixMenuArrow>

@code {
    [Parameter]
    public double Width { get; set; } = 10;

    [Parameter]
    public double Height { get; set; } = 5;
}
