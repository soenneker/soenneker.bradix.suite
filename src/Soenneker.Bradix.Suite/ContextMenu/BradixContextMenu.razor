@namespace Soenneker.Bradix

@inherits BradixContent

@implements IBradixContextMenu
<BradixMenu @ref="_menu"
            Open="@CurrentOpen"
            OpenChanged="(_cachedHandleMenuOpenChangedDelegate ??= HandleMenuOpenChanged)"
            Dir="@Dir"
            Modal="@Modal">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</BradixMenu>

@code {
    private System.Func<bool, Task>? _cachedHandleMenuOpenChangedDelegate;

    private bool _open;
    private BradixMenu? _menu;

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public bool Modal { get; set; } = true;

    internal bool CurrentOpen => Open ?? _open;

    internal async Task OpenAtPoint(double x, double y)
    {
        _menu?.RegisterVirtualAnchor(x, y);

        if (CurrentOpen)
        {
            await RequestRender();
            return;
        }

        await SetOpen(true);
    }

    internal Task Close()
    {
        return SetOpen(false);
    }

    private async Task SetOpen(bool open)
    {
        if (CurrentOpen == open)
            return;

        if (Open is null)
            _open = open;

        if (OpenChanged.HasDelegate)
            await OpenChanged.InvokeAsync(open);

        if (OnOpenChange.HasDelegate)
            await OnOpenChange.InvokeAsync(open);

        await RequestRender();
    }

    private Task HandleMenuOpenChanged(bool open)
    {
        return SetOpen(open);
    }
}
