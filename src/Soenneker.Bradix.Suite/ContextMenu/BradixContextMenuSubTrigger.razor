@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement
@implements IBradixContextMenuSubTrigger
<BradixMenuSubTrigger Id="@Id"
                      Class="@Class"
                      Style="@Style"
                      TextValue="@TextValue"
                      Disabled="@Disabled"
                      AdditionalAttributes="@AdditionalAttributes"
                      ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />

@code {
    [Parameter]
    public string? TextValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
