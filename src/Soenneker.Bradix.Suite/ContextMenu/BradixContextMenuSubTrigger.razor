@namespace Soenneker.Bradix

@inherits LeptonIdentifiableContentElement
@implements IBradixContextMenuSubTrigger
<BradixMenuSubTrigger Id="@Id"
                      Class="@Class"
                      Style="@Style"
                      TextValue="@TextValue"
                      Disabled="@Disabled"
                      AdditionalAttributes="@AdditionalAttributes">
    @ChildContent
</BradixMenuSubTrigger>

@code {
    [Parameter]
    public string? TextValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}
