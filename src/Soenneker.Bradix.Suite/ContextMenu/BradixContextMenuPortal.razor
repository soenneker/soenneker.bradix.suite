@namespace Soenneker.Bradix

@inherits LeptonContent
@implements IBradixContextMenuPortal
<BradixMenuPortal ContainerSelector="@ContainerSelector"
                  Container="@Container"
                  ForceMount="@ForceMount"
                  ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />

@code {
    [Parameter]
    public string? ContainerSelector { get; set; }

    [Parameter]
    public ElementReference Container { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }
}
