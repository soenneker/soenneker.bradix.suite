@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement
@implements IBradixContextMenuRadioGroup
<BradixMenuRadioGroup Id="@Id"
                      Class="@Class"
                      Style="@Style"
                      Value="@Value"
                      DefaultValue="@DefaultValue"
                      Disabled="@Disabled"
                      ValueChanged="@ValueChanged"
                      OnValueChange="@OnValueChange"
                      AdditionalAttributes="@AdditionalAttributes"
                      ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }
}
