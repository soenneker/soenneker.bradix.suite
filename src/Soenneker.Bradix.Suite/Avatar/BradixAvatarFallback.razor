@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using System.Threading

@inherits BradixContentElement

@implements IBradixAvatarFallback

@if (CanRenderFallback)
{
    <span @attributes="FallbackAttributes">
        @ChildContent
    </span>
}

@code {
    private CancellationTokenSource? _delayTokenSource;
    private int? _lastDelayMs;
    private ValueAtomicBool _canRender;
    private ValueAtomicBool _delayInitialized;

    [CascadingParameter]
    private BradixAvatar? Avatar { get; set; }

    [Parameter]
    public int? DelayMs { get; set; }

    private bool CanRenderFallback => _canRender.Value && Avatar?.ImageLoadingStatus != BradixAvatarImageLoadingStatus.Loaded;

    private Dictionary<string, object> FallbackAttributes => BuildAttributes();

    protected override void OnParametersSet()
    {
        if (_delayInitialized.Value && _lastDelayMs == DelayMs)
            return;

        _delayInitialized.Value = true;
        _lastDelayMs = DelayMs;
        ResetDelay();
    }

    public ValueTask DisposeAsync()
    {
        _delayTokenSource?.Cancel();
        _delayTokenSource?.Dispose();
        return ValueTask.CompletedTask;
    }

    private void ResetDelay()
    {
        _delayTokenSource?.Cancel();
        _delayTokenSource?.Dispose();
        _delayTokenSource = null;

        if (DelayMs is null)
        {
            _canRender.Value = true;
            return;
        }

        _canRender.Value = false;
        _delayTokenSource = new CancellationTokenSource();
        _ = EnableAfterDelay(_delayTokenSource.Token);
    }

    private async Task EnableAfterDelay(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(DelayMs!.Value, cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            _canRender.Value = true;
            await RequestRender();
        }
        catch (TaskCanceledException)
        {
        }
    }
}
