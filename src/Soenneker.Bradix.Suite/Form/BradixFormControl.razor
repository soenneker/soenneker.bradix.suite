@namespace Soenneker.Bradix

@inherits BradixIdentifiableElement

@implements IBradixFormControl

@inject IFormInterop FormInterop
<input @ref="_element"
       @oninvalid:preventDefault="true"
       @oninvalid="(_cachedHandleInvalidDelegate ??= HandleInvalid)"
       @oninput="(_cachedHandleInputDelegate ??= HandleInput)"
       @onchange="(_cachedHandleChangeDelegate ??= HandleChange)"
       @attributes="ControlAttributes" />

@code {
    private System.Func<Task>? _cachedHandleInvalidDelegate;
    private System.Func<ChangeEventArgs, Task>? _cachedHandleInputDelegate;
    private System.Func<ChangeEventArgs, Task>? _cachedHandleChangeDelegate;

    private ElementReference _element;
    private bool? _lastServerInvalid;
    private BradixForm? _registeredForm;
    private string? _registeredName;

    [CascadingParameter]
    private BradixForm? Form { get; set; }

    [CascadingParameter]
    private BradixFormField? Field { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Type { get; set; }

    internal string ResolvedName => Name ?? Field?.Name ?? string.Empty;

    private string ResolvedId => Id ?? Field?.FieldId ?? string.Empty;

    private Dictionary<string, object> ControlAttributes => BuildAttributes(
        ("name", ResolvedName),
        ("id", ResolvedId),
        ("type", string.IsNullOrWhiteSpace(Type) ? null : Type),
        ("data-valid", Field?.IsValid == true ? string.Empty : null),
        ("data-invalid", Field?.IsInvalid == true ? string.Empty : null),
        ("aria-invalid", Field?.ServerInvalid == true ? "true" : null),
        ("aria-describedby", !string.IsNullOrWhiteSpace(ResolvedName) ? Form?.GetFieldDescription(ResolvedName) : null),
        ("title", string.Empty));

    public async Task HandleValidityChanged(BradixFormValiditySnapshot? validity)
    {
        if (!string.IsNullOrWhiteSpace(ResolvedName))
            Form?.SetFieldValidity(ResolvedName, validity);

        await RequestRender();
    }

    public async Task HandleControlStateChanged(BradixFormControlSnapshot snapshot)
    {
        if (Form is null || string.IsNullOrWhiteSpace(ResolvedName))
            return;

        await Form.UpdateControlState(_element, ResolvedName, snapshot);
        await RequestRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ReferenceEquals(_registeredForm, Form) || !string.Equals(_registeredName, ResolvedName, StringComparison.Ordinal))
        {
            if (_registeredForm is not null && _registeredName is not null)
                _registeredForm.UnregisterControl(_registeredName, _element);

            _registeredForm = Form;
            _registeredName = ResolvedName;
            if (Form is not null && !string.IsNullOrWhiteSpace(_registeredName))
                Form.RegisterControl(_registeredName, _element);
        }

        bool serverInvalid = Field?.ServerInvalid == true;

        if (serverInvalid && (_lastServerInvalid != true || firstRender))
            await FormInterop.FocusServerInvalidFormControl(_element);

        _lastServerInvalid = serverInvalid;
    }

    public ValueTask DisposeAsync()
    {
        if (_registeredForm is not null && _registeredName is not null)
            _registeredForm.UnregisterControl(_registeredName, _element);

        _registeredForm = null;
        _registeredName = null;

        return ValueTask.CompletedTask;
    }

    private async Task HandleInvalid()
    {
        BradixFormControlSnapshot snapshot = await FormInterop.GetFormControlState(_element);
        await HandleControlStateChanged(snapshot);
    }

    private async Task HandleChange(ChangeEventArgs _)
    {
        BradixFormControlSnapshot snapshot = await FormInterop.GetFormControlState(_element);
        await HandleControlStateChanged(snapshot);
    }

    private async Task HandleInput(ChangeEventArgs _)
    {
        await FormInterop.SetFormControlCustomValidity(_element, null);

        if (!string.IsNullOrWhiteSpace(ResolvedName))
            Form?.ClearFieldValidation(ResolvedName);

        await RequestRender();
    }
}
