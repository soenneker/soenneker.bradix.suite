@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits LeptonIdentifiableContentElement

@implements IBradixForm

@inject IFormInterop FormInterop
<CascadingValue Value="this">
    <form @ref="_formElement"
          @onsubmit="HandleSubmit"
          @onreset="HandleReset"
          @attributes="FormAttributes">
        @ChildContent
    </form>
</CascadingValue>

@code {
    private const string _defaultInvalidMessage = "This value is not valid";

    private readonly Dictionary<string, BradixFormValiditySnapshot?> _validityMap = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Dictionary<string, BradixFormCustomMatcherEntry>> _customMatchersByField = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Dictionary<string, bool>> _customErrorsByField = new(StringComparer.Ordinal);
    private readonly Dictionary<string, long> _validationVersions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, HashSet<string>> _messageIdsByField = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ElementReference> _controlsByField = new(StringComparer.Ordinal);
    private ElementReference _formElement;
    private bool _registered;
    private DotNetObjectReference<object>? _dotNetReference;

    [Parameter]
    public EventCallback OnClearServerErrors { get; set; }

    [Parameter]
    public EventCallback<EventArgs> OnSubmit { get; set; }

    [Parameter]
    public EventCallback<EventArgs> OnReset { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<string>> OnInvalid { get; set; }

    private Dictionary<string, object> FormAttributes => BuildAttributes();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotNetReference = DotNetObjectReference.Create<object>(this);
        await FormInterop.RegisterFormRoot(_formElement, _dotNetReference);
        _registered = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_registered)
            await FormInterop.UnregisterFormRoot(_formElement);

        _dotNetReference?.Dispose();
    }

    internal BradixFormValiditySnapshot? GetFieldValidity(string fieldName)
    {
        return _validityMap.TryGetValue(fieldName, out BradixFormValiditySnapshot? validity)
            ? validity
            : null;
    }

    internal string? GetFieldDescription(string fieldName)
    {
        if (!_messageIdsByField.TryGetValue(fieldName, out HashSet<string>? ids) || ids.Count == 0)
            return null;

        using var builder = new PooledStringBuilder(ids.Count * 24);

        foreach (string id in ids)
        {
            if (builder.Length != 0)
                builder.Append(' ');

            builder.Append(id);
        }

        return builder.ToString();
    }

    internal bool GetFieldCustomError(string fieldName, string matcherId)
    {
        return _customErrorsByField.TryGetValue(fieldName, out Dictionary<string, bool>? fieldErrors) &&
               fieldErrors.TryGetValue(matcherId, out bool matches) &&
               matches;
    }

    internal void SetFieldValidity(string fieldName, BradixFormValiditySnapshot? validity)
    {
        if (validity is null)
            _validityMap.Remove(fieldName);
        else
            _validityMap[fieldName] = validity;

        _ = InvokeAsync(StateHasChanged);
    }

    internal void ClearFieldValidation(string fieldName)
    {
        _validityMap.Remove(fieldName);
        _customErrorsByField.Remove(fieldName);
        _validationVersions.Remove(fieldName);
        _ = InvokeAsync(StateHasChanged);
    }

    internal void RegisterFieldCustomMatcher(string fieldName, BradixFormCustomMatcherEntry entry)
    {
        if (!_customMatchersByField.TryGetValue(fieldName, out Dictionary<string, BradixFormCustomMatcherEntry>? fieldEntries))
        {
            fieldEntries = new Dictionary<string, BradixFormCustomMatcherEntry>(StringComparer.Ordinal);
            _customMatchersByField[fieldName] = fieldEntries;
        }

        fieldEntries[entry.Id] = entry;
    }

    internal void UnregisterFieldCustomMatcher(string fieldName, string matcherId)
    {
        if (!_customMatchersByField.TryGetValue(fieldName, out Dictionary<string, BradixFormCustomMatcherEntry>? fieldEntries))
            return;

        fieldEntries.Remove(matcherId);

        if (fieldEntries.Count == 0)
            _customMatchersByField.Remove(fieldName);

        if (_customErrorsByField.TryGetValue(fieldName, out Dictionary<string, bool>? fieldErrors))
        {
            fieldErrors.Remove(matcherId);

            if (fieldErrors.Count == 0)
                _customErrorsByField.Remove(fieldName);
        }
    }

    internal async Task UpdateControlState(ElementReference element, string fieldName, BradixFormControlSnapshot snapshot)
    {
        long version = NextValidationVersion(fieldName);
        BradixFormValiditySnapshot validity = snapshot.Validity ?? new BradixFormValiditySnapshot();

        if (HasBuiltInError(validity))
        {
            await FormInterop.SetFormControlCustomValidity(element, null);

            if (!IsLatestValidation(fieldName, version))
                return;

            SetFieldCustomErrors(fieldName, null);
            SetFieldValidity(fieldName, validity);
            return;
        }

        if (!_customMatchersByField.TryGetValue(fieldName, out Dictionary<string, BradixFormCustomMatcherEntry>? matcherEntries) ||
            matcherEntries.Count == 0)
        {
            await FormInterop.SetFormControlCustomValidity(element, null);

            if (!IsLatestValidation(fieldName, version))
                return;

            SetFieldCustomErrors(fieldName, null);
            SetFieldValidity(fieldName, validity);
            return;
        }

        Dictionary<string, bool>? syncResults = null;
        List<(BradixFormCustomMatcherEntry Entry, ValueTask<bool> Task)>? asyncMatchers = null;
        var consumedAsyncMatcherCount = 0;

        try
        {
            foreach (BradixFormCustomMatcherEntry entry in matcherEntries.Values)
            {
                ValueTask<bool> task = entry.Match(snapshot.Value, snapshot.FormData);

                if (task.IsCompletedSuccessfully)
                {
                    syncResults ??= new Dictionary<string, bool>(matcherEntries.Count, StringComparer.Ordinal);
                    syncResults[entry.Id] = task.Result;
                    continue;
                }

                asyncMatchers ??= new List<(BradixFormCustomMatcherEntry, ValueTask<bool>)>(matcherEntries.Count);
                asyncMatchers.Add((entry, task));
            }

            bool hasSyncErrors = HasCustomErrors(syncResults);

            await FormInterop.SetFormControlCustomValidity(element, hasSyncErrors ? _defaultInvalidMessage : null);

            if (!IsLatestValidation(fieldName, version))
                return;

            BradixFormValiditySnapshot syncValidity = await FormInterop.GetFormControlValidity(element);

            if (!IsLatestValidation(fieldName, version))
                return;

            SetFieldCustomErrors(fieldName, syncResults);
            SetFieldValidity(fieldName, syncValidity);

            if (hasSyncErrors || asyncMatchers is not { Count: > 0 })
                return;

            Dictionary<string, bool> asyncResults = syncResults is not null
                ? new Dictionary<string, bool>(syncResults, StringComparer.Ordinal)
                : new Dictionary<string, bool>(asyncMatchers.Count, StringComparer.Ordinal);

            while (consumedAsyncMatcherCount < asyncMatchers.Count)
            {
                (BradixFormCustomMatcherEntry entry, ValueTask<bool> task) = asyncMatchers[consumedAsyncMatcherCount++];
                asyncResults[entry.Id] = await task;

                if (!IsLatestValidation(fieldName, version))
                    return;
            }

            bool hasAsyncErrors = HasCustomErrors(asyncResults);

            await FormInterop.SetFormControlCustomValidity(element, hasAsyncErrors ? _defaultInvalidMessage : null);

            if (!IsLatestValidation(fieldName, version))
                return;

            BradixFormValiditySnapshot asyncValidity = await FormInterop.GetFormControlValidity(element);

            if (!IsLatestValidation(fieldName, version))
                return;

            SetFieldCustomErrors(fieldName, asyncResults);
            SetFieldValidity(fieldName, asyncValidity);
        }
        finally
        {
            if (asyncMatchers is { Count: > 0 } && consumedAsyncMatcherCount < asyncMatchers.Count)
                _ = ObserveRemainingMatchers(asyncMatchers, consumedAsyncMatcherCount);
        }
    }

    private static async Task ObserveRemainingMatchers(List<(BradixFormCustomMatcherEntry Entry, ValueTask<bool> Task)> asyncMatchers, int startIndex)
    {
        for (int i = startIndex; i < asyncMatchers.Count; i++)
        {
            try
            {
                _ = await asyncMatchers[i].Task.ConfigureAwait(false);
            }
            catch (Exception)
            {
                // These matcher results can no longer affect the superseded or failed validation,
                // but each started ValueTask still must be consumed exactly once.
            }
        }
    }

    internal void RegisterFieldMessageId(string fieldName, string id)
    {
        if (!_messageIdsByField.TryGetValue(fieldName, out HashSet<string>? ids))
        {
            ids = new HashSet<string>(StringComparer.Ordinal);
            _messageIdsByField[fieldName] = ids;
        }

        if (ids.Add(id))
            _ = InvokeAsync(StateHasChanged);
    }

    internal void UnregisterFieldMessageId(string fieldName, string id)
    {
        if (!_messageIdsByField.TryGetValue(fieldName, out HashSet<string>? ids))
            return;

        if (ids.Remove(id))
        {
            if (ids.Count == 0)
                _messageIdsByField.Remove(fieldName);

            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSubmit(EventArgs args)
    {
        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(args);

        if (OnClearServerErrors.HasDelegate)
            await OnClearServerErrors.InvokeAsync();
    }

    private async Task HandleReset(EventArgs args)
    {
        if (OnReset.HasDelegate)
            await OnReset.InvokeAsync(args);

        await FormInterop.ClearFormCustomValidity(_formElement);

        _validityMap.Clear();
        _customErrorsByField.Clear();
        _validationVersions.Clear();

        if (OnClearServerErrors.HasDelegate)
            await OnClearServerErrors.InvokeAsync();

        await InvokeAsync(StateHasChanged);
    }

    private static bool HasBuiltInError(BradixFormValiditySnapshot validity)
    {
        return validity.BadInput ||
               validity.PatternMismatch ||
               validity.RangeOverflow ||
               validity.RangeUnderflow ||
               validity.StepMismatch ||
               validity.TooLong ||
               validity.TooShort ||
               validity.TypeMismatch ||
               validity.ValueMissing;
    }

    private static bool HasCustomErrors(Dictionary<string, bool>? results)
    {
        if (results is null)
            return false;

        foreach (bool value in results.Values)
        {
            if (value)
                return true;
        }

        return false;
    }

    private long NextValidationVersion(string fieldName)
    {
        long next = _validationVersions.TryGetValue(fieldName, out long current)
            ? current + 1
            : 1;

        _validationVersions[fieldName] = next;
        return next;
    }

    private bool IsLatestValidation(string fieldName, long version)
    {
        return _validationVersions.TryGetValue(fieldName, out long current) && current == version;
    }

    private void SetFieldCustomErrors(string fieldName, Dictionary<string, bool>? errors)
    {
        if (errors is null || errors.Count == 0)
        {
            _customErrorsByField.Remove(fieldName);
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        _customErrorsByField[fieldName] = errors;
        _ = InvokeAsync(StateHasChanged);
    }

    internal void RegisterControl(string fieldName, ElementReference element)
    {
        if (string.IsNullOrWhiteSpace(fieldName))
            return;

        _controlsByField[fieldName] = element;
    }

    internal void UnregisterControl(string fieldName, ElementReference element)
    {
        if (string.IsNullOrWhiteSpace(fieldName))
            return;

        if (_controlsByField.TryGetValue(fieldName, out ElementReference existing) && string.Equals(existing.Id, element.Id, StringComparison.Ordinal))
            _controlsByField.Remove(fieldName);
    }

    [JSInvokable]
    public async Task HandleInvalidControls(string[] fieldNames)
    {
        IReadOnlyList<string> distinctFieldNames = GetDistinctFieldNames(fieldNames);

        foreach (string fieldName in distinctFieldNames)
        {
            if (!_controlsByField.TryGetValue(fieldName, out ElementReference element))
                continue;

            BradixFormControlSnapshot snapshot = await FormInterop.GetFormControlState(element);
            await UpdateControlState(element, fieldName, snapshot);
        }

        if (OnInvalid.HasDelegate)
            await OnInvalid.InvokeAsync(distinctFieldNames);
    }

    private static IReadOnlyList<string> GetDistinctFieldNames(string[] fieldNames)
    {
        if (fieldNames.Length < 2)
            return fieldNames;

        for (int i = 0; i < fieldNames.Length; i++)
        {
            string fieldName = fieldNames[i];

            for (int j = 0; j < i; j++)
            {
                if (!string.Equals(fieldNames[j], fieldName, StringComparison.Ordinal))
                    continue;

                return CopyDistinctFieldNames(fieldNames, i);
            }
        }

        return fieldNames;
    }

    private static IReadOnlyList<string> CopyDistinctFieldNames(string[] fieldNames, int duplicateIndex)
    {
        List<string> distinctFieldNames = new(duplicateIndex);

        for (int i = 0; i < duplicateIndex; i++)
            distinctFieldNames.Add(fieldNames[i]);

        for (int i = duplicateIndex + 1; i < fieldNames.Length; i++)
        {
            string fieldName = fieldNames[i];

            if (!ContainsOrdinal(distinctFieldNames, fieldName))
                distinctFieldNames.Add(fieldName);
        }

        return distinctFieldNames;
    }

    private static bool ContainsOrdinal(List<string> values, string value)
    {
        foreach (string candidate in values)
        {
            if (string.Equals(candidate, value, StringComparison.Ordinal))
                return true;
        }

        return false;
    }
}
