@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixSelectViewport
<style nonce="@Nonce">
    [data-radix-select-viewport] { scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
    [data-radix-select-viewport]::-webkit-scrollbar { display: none; }
</style>
<div @ref="_element"
     @attributes="ViewportAttributes">
    <div @ref="_content"
         style="min-width:100%;display:block;">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Nonce { get; set; }
    private string? _mergedStyleCache0;

    private ElementReference _element;
    private ElementReference _content;
    private ValueAtomicBool _registered;

    [CascadingParameter]
    private BradixSelectContent? Content { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Content is null)
        {
            _registered.Value = false;
            return;
        }

        Content.RegisterViewportContent(_content);

        if (_registered.Value)
            return;

        await Content.RegisterViewport(_element);
        _registered.Value = true;
    }

    private Dictionary<string, object> ViewportAttributes => BuildAttributes(
        ("data-radix-select-viewport", string.Empty),
        ("role", "presentation"),
        ("style", BuildStyle()));

    private string BuildStyle()
    {
        const string baseStyle = "position:relative;flex:1 1 auto;min-height:0;overflow-x:hidden;overflow-y:auto;";
        return BradixStringCache.MergeStyle(baseStyle, Style, ref _mergedStyleCache0)!;
    }
}
