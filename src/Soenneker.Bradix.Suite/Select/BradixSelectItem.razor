@namespace Soenneker.Bradix

@using Soenneker.Blazor.Utils.Ids

@inherits BradixContentElement

@implements IBradixSelectCollectionItem
@implements IBradixSelectItem
@implements IHandleEvent

@inject IDomInterop DomInterop
@inject IControlsInterop ControlsInterop
<CascadingValue Value="this">
    <div @ref="_element"
         @onclick="HandleClick"
         @onfocus="HandleFocus"
         @onblur="HandleBlur"
         @onkeydown="HandleKeyDown"
         @onkeydown:preventDefault="true"
         @onpointerdown="HandlePointerDown"
         @onpointerup="HandlePointerUp"
         @onpointermove="HandlePointerMove"
         @onpointerleave="HandlePointerLeave"
         @attributes="ItemAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    // Handlers below explicitly refresh changed items or selection/open state.
    // Pointer bookkeeping alone must not render the item subtree.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    private ElementReference _element;
    private bool _registered;
    private bool _isFocused;
    private string _pointerType = "mouse";
    private string? _resolvedTextValue;
    private ElementReference _itemTextElement;
    private bool _hasItemTextElement;
    private bool _hasItemTextContent;
    private bool _disposed;
    private BradixTextObserver? _textObserver;
    private bool _pointerFocusPending;

    [CascadingParameter]
    private BradixSelect? Select { get; set; }

    [CascadingParameter]
    private BradixSelectContent? Content { get; set; }

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? TextValue { get; set; }

    internal string? TextId { get; private set; }

    string IBradixSelectCollectionItem.Value => Value;

    bool IBradixSelectCollectionItem.Disabled => Disabled;

    string IBradixSelectCollectionItem.TextValue => TextValue is null
        ? _resolvedTextValue ?? string.Empty
        : TextValue;

    ElementReference IBradixSelectCollectionItem.ItemElement => _element;

    ElementReference IBradixSelectCollectionItem.ItemTextElement => _itemTextElement;

    bool IBradixSelectCollectionItem.HasItemTextElement => _hasItemTextElement;

    internal bool IsSelected => string.Equals(Select?.CurrentValue, Value, StringComparison.Ordinal);

    private bool IsHighlighted => !Disabled && (Select?.IsFocusedItem(this) == true || _isFocused);

    private Dictionary<string, object> ItemAttributes => BuildAttributes(
        ("role", "option"),
        ("aria-labelledby", TextId),
        ("aria-selected", IsSelected && IsHighlighted ? "true" : "false"),
        ("aria-disabled", Disabled ? "true" : null),
        ("data-value", Value),
        ("data-state", IsSelected ? "checked" : "unchecked"),
        ("data-highlighted", IsHighlighted ? string.Empty : null),
        ("data-disabled", Disabled ? string.Empty : null),
        ("tabindex", Disabled ? null : -1));

    protected override void OnInitialized()
    {
        TextId ??= Select?.BaseId is string bid
            ? BlazorIdGenerator.Child(BlazorIdGenerator.Child(BlazorIdGenerator.Child(bid, "item"), Value), "text")
            : BlazorIdGenerator.New("bradix-select-item-text");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (firstRender && Select is not null)
        {
            if (string.IsNullOrWhiteSpace(Value))
                throw new InvalidOperationException("A BradixSelectItem value cannot be empty.");

            Select.RegisterItem(this);
            _registered = true;
        }

        if (TextValue is null && !_hasItemTextContent)
        {
            _textObserver ??= new BradixTextObserver(DomInterop, text => InvokeAsync(() => NotifyResolvedText(text)));
            await _textObserver.Observe(_element);
        }
        else if (_textObserver is not null)
        {
            await _textObserver.DisposeAsync();
            _textObserver = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_registered)
            Select?.UnregisterItem(this);
        if (_textObserver is not null)
            await _textObserver.DisposeAsync();
    }

    ValueTask IBradixSelectCollectionItem.Focus() => ControlsInterop.FocusElementPreventScroll(_element);

    ValueTask IBradixSelectCollectionItem.ScrollIntoView() => ControlsInterop.ScrollElementIntoViewNearest(_element);

    ValueTask IBradixSelectCollectionItem.Refresh() => new(InvokeAsync(StateHasChanged));

    internal async Task NotifyResolvedText(string? text)
    {
        if (_disposed || TextValue is not null || string.Equals(_resolvedTextValue, text, StringComparison.Ordinal))
            return;

        _resolvedTextValue = text;
        if (Select is not null)
            await Select.NotifyItemTextChanged();
    }

    internal void RegisterTextContent() => _hasItemTextContent = true;

    internal void UnregisterTextContent()
    {
        _hasItemTextContent = false;
        _hasItemTextElement = false;
        _itemTextElement = default;
        if (!_disposed && _registered)
            _ = InvokeAsync(StateHasChanged);
    }

    internal void RegisterTextElement(ElementReference element)
    {
        if (_hasItemTextElement && _itemTextElement.Equals(element))
            return;

        _itemTextElement = element;
        _hasItemTextElement = true;
        Content?.QueueOpenLayoutPass();
    }

    private async Task HandleClick(MouseEventArgs _)
    {
        if (Disabled || Select is null || _pointerType == "mouse")
            return;

        await Select.SetValue(Value);
        await Select.SetOpen(false);
        await Task.Yield();
        await Select.FocusTrigger();
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        if (Disabled || Select is null)
            return Task.CompletedTask;

        _isFocused = true;
        Select.SetFocusedItem(Value);
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleBlur(FocusEventArgs _)
    {
        _isFocused = false;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Disabled || Select is null || args.CtrlKey || args.AltKey || args.MetaKey)
            return;

        bool isTypingAhead = Select.HasActiveTypeahead;

        if (isTypingAhead && args.Key is " " or "Spacebar")
            return;

        if (args.Key is " " or "Spacebar" or "Enter")
        {
            await Select.SetValue(Value);
            await Select.SetOpen(false);
            await Task.Yield();
            await Select.FocusTrigger();
            return;
        }

        if (args.Key.Length == 1)
        {
            await Select.HandleContentTypeahead(args.Key);
            return;
        }

        if (args.Key is "ArrowUp" or "ArrowDown" or "Home" or "End" or "PageUp" or "PageDown")
            await Select.HandleContentNavigation(args.Key);
    }

    private Task HandlePointerDown(PointerEventArgs args)
    {
        _pointerType = args.PointerType ?? "mouse";
        return Task.CompletedTask;
    }

    private async Task HandlePointerUp(PointerEventArgs args)
    {
        if (Disabled || Select is null || _pointerType != "mouse")
            return;

        if (Select.ConsumeSuppressNextMousePointerUpSelection())
            return;

        if (Select.HasTriggerPointerDownPosition)
        {
            double deltaX = Math.Abs(Math.Round(args.PageX) - Math.Round(Select.TriggerPointerDownX));
            double deltaY = Math.Abs(Math.Round(args.PageY) - Math.Round(Select.TriggerPointerDownY));

            if (deltaX <= 10 && deltaY <= 10)
            {
                Select.ClearTriggerPointerDownPosition();
                return;
            }
        }

        await Select.SetValue(Value);
        await Select.SetOpen(false);
        await Task.Yield();
        await Select.FocusTrigger();
    }

    private async Task HandlePointerMove(PointerEventArgs args)
    {
        _pointerType = args.PointerType ?? _pointerType;

        if (Disabled || Select is null || !string.Equals(_pointerType, "mouse", StringComparison.Ordinal))
        {
            if (Disabled)
                await (Content?.FocusContent() ?? Task.CompletedTask);

            return;
        }

        if (_isFocused || _pointerFocusPending)
            return;

        _pointerFocusPending = true;
        try
        {
            Select.SetFocusedItem(Value);
            await ControlsInterop.FocusElementPreventScroll(_element);
        }
        finally
        {
            _pointerFocusPending = false;
        }
    }

    private async Task HandlePointerLeave(PointerEventArgs _)
    {
        if (Content is null || !_isFocused || !string.Equals(_pointerType, "mouse", StringComparison.Ordinal))
            return;

        await Content.FocusContent();
    }
}
