@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids

@inherits BradixContentElement

@implements IBradixSelect
@implements IAsyncDisposable

@inject IFormInterop FormInterop
@inject IControlsInterop ControlsInterop
<BradixPopper>
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</BradixPopper>

@if (RenderDefaultParts && ShouldRenderBubbleSelect) { @RenderBubbleInput() }

@code {
    protected virtual bool RenderDefaultParts => true;
    internal async ValueTask ClearBubbleInput()
    {
        if (_bubbleSelectRegistered.Value)
        {
            await ControlsInterop.UnregisterSelectBubbleInput(_bubbleSelectElement);
            await FormInterop.UnregisterAssociatedFormReset(_bubbleSelectElement);
            _bubbleSelectRegistered.Value = false;
        }
        _bubbleSelectElement = default;
        _hasBubbleSelectElement.Value = false;
        _bubbleSelectValueInitialized.Value = false;
    }
    internal RenderFragment RenderBubbleInput() => @<select @ref="_bubbleSelectElement"
            @attributes="BubbleSelectAttributes">
        @if (string.IsNullOrWhiteSpace(CurrentValue))
        {
            <option value=""></option>
        }

        @{ var items = _items.Snapshot(); }
        @for (var i = 0; i < items.Count; i++)
        {
            BradixCollectionEntry<IBradixSelectCollectionItem> entry = items[i];
            <option value="@entry.Item.Value"
                    disabled="@entry.Item.Disabled">
                @entry.Item.TextValue
            </option>
        }

        @if (!string.IsNullOrWhiteSpace(CurrentValue) && !_items.TryGet(CurrentValue!, out _))
        {
            <option value="@CurrentValue">
                @CurrentText
            </option>
        }
    </select>;

    private string? _childIdCache0;

    private BradixAttributeDictionary? _bubbleAttributes;
    private Action? _refreshCallback;
    private Func<Task>? _focusOpenItemCallback;
    private readonly BradixCollectionRegistry<IBradixSelectCollectionItem> _items = new();
    private readonly BradixTypeaheadBuffer _typeahead = new();
    private ValueAtomicBool _initialized;
    private ValueAtomicBool _refreshQueued;
    private ValueAtomicBool _focusOpenItemQueued;
    private bool _uncontrolledOpen;
    private string? _uncontrolledValue;
    private ElementReference _bubbleSelectElement;
    private ValueAtomicBool _hasBubbleSelectElement;
    private ValueAtomicBool _bubbleSelectRegistered;
    private ValueAtomicBool _bubbleSelectValueInitialized;
    private ValueAtomicBool _suppressNextMousePointerUpSelection;
    private string? _lastBubbleSelectValue;
    private bool _isFormControl = true;
    private ValueAtomicBool _formControlStateResolved;
    private string? _lastResolvedForm;
    private (double X, double Y)? _triggerPointerDownPosition;
    private string? _currentText;
    private DotNetObjectReference<object>? _dotNetReference;
    private Task? _bubbleSelectRegistrationTask;
    private ValueAtomicBool _disposed;

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? AutoComplete { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? Form { get; set; }

    internal string? BaseId { get; private set; }

    internal bool CurrentOpen => Open ?? _uncontrolledOpen;

    internal string? CurrentValue => Value ?? _uncontrolledValue;

    internal bool HasActiveTypeahead => !string.IsNullOrEmpty(_typeahead.CurrentSearch);

    internal string ContentId => BradixStringCache.ChildId(BaseId!, "content", ref _childIdCache0);

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal string CurrentText => _currentText ?? string.Empty;

    internal bool ShouldShowPlaceholder => string.IsNullOrWhiteSpace(CurrentValue);

    internal ElementReference TriggerElement { get; private set; }

    internal bool HasTrigger { get; private set; }

    internal ElementReference ValueNodeElement { get; private set; }

    internal bool HasValueNode { get; private set; }

    internal bool ValueNodeHasChildren { get; private set; }

    internal string? CurrentFocusedItemValue { get; private set; }

    internal bool HasTriggerPointerDownPosition => _triggerPointerDownPosition is not null;

    internal double TriggerPointerDownX => _triggerPointerDownPosition?.X ?? 0;

    internal double TriggerPointerDownY => _triggerPointerDownPosition?.Y ?? 0;

    private bool ShouldRenderBubbleSelect => _isFormControl;

    private Dictionary<string, object> BubbleSelectAttributes
    {
        get
        {
            Dictionary<string, object> attributes = (_bubbleAttributes ??= new BradixAttributeDictionary()).Create(null, 8);
                attributes["tabindex"] = BradixAttributeValues.MinusOne;
                attributes["aria-hidden"] = "true";
                attributes["required"] = Required ? BradixAttributeValues.True : BradixAttributeValues.False;
                attributes["disabled"] = Disabled ? BradixAttributeValues.True : BradixAttributeValues.False;
                attributes["style"] = "position:absolute;width:0;height:0;padding:0;border:0;pointer-events:none;opacity:0;margin:0;transform:translateX(-100%);";

            if (!string.IsNullOrWhiteSpace(Name))
                attributes["name"] = Name;

            if (!string.IsNullOrWhiteSpace(Form))
                attributes["form"] = Form;

            if (!string.IsNullOrWhiteSpace(AutoComplete))
                attributes["autocomplete"] = AutoComplete;

            return attributes;
        }
    }

    protected override void OnInitialized()
    {
        BaseId ??= BlazorIdGenerator.New("bradix-select");
    }

    protected override void OnParametersSet()
    {
        if (!_initialized.Value)
        {
            _uncontrolledOpen = DefaultOpen;
            _uncontrolledValue = DefaultValue;
            _initialized.Value = true;
        }

        UpdateCurrentText();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        if (HasTrigger && (!_formControlStateResolved.Value || !string.Equals(_lastResolvedForm, Form, StringComparison.Ordinal)))
        {
            bool isFormControl = await FormInterop.IsFormControl(TriggerElement, Form);

            if (_disposed.Read())
                return;

            _formControlStateResolved.Value = true;
            _lastResolvedForm = Form;

            if (_isFormControl != isFormControl)
            {
                _isFormControl = isFormControl;
                await RequestRender();
                return;
            }
        }

        if (ShouldRenderBubbleSelect && !string.IsNullOrEmpty(_bubbleSelectElement.Id))
        {
            RegisterBubbleSelect(_bubbleSelectElement);
            await EnsureBubbleSelectRegistration();
            await SyncBubbleSelectValue();
        }
        else
        {
            if (_bubbleSelectRegistered.Value)
            {
                await ControlsInterop.UnregisterSelectBubbleInput(_bubbleSelectElement);
                await FormInterop.UnregisterAssociatedFormReset(_bubbleSelectElement);
                _bubbleSelectRegistered.Value = false;
            }

            _hasBubbleSelectElement.Value = false;
            _bubbleSelectValueInitialized.Value = false;
            _lastBubbleSelectValue = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_bubbleSelectRegistrationTask is not null)
                await _bubbleSelectRegistrationTask;

            if (_bubbleSelectRegistered.Value)
            {
                await ControlsInterop.UnregisterSelectBubbleInput(_bubbleSelectElement);
                await FormInterop.UnregisterAssociatedFormReset(_bubbleSelectElement);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    internal void RegisterItem(IBradixSelectCollectionItem item)
    {
        _items.Register(item.Value, item);

        if (string.Equals(item.Value, CurrentValue, StringComparison.Ordinal))
            UpdateCurrentText(item.TextValue);

        if (ShouldRenderBubbleSelect || string.Equals(item.Value, CurrentValue, StringComparison.Ordinal))
            QueueRefresh();

        QueueOpenItemFocusIfNeeded();
    }

    internal void UnregisterItem(IBradixSelectCollectionItem item, string? registeredValue = null)
    {
        string value = registeredValue ?? item.Value;
        if (!_items.TryGet(value, out var registeredItem) || !ReferenceEquals(registeredItem, item))
            return;

        _items.Unregister(value);

        if (string.Equals(CurrentFocusedItemValue, value, StringComparison.Ordinal))
            CurrentFocusedItemValue = null;

        if (ShouldRenderBubbleSelect || string.Equals(CurrentValue, value, StringComparison.Ordinal))
            QueueRefresh();
    }

    internal void RegisterTrigger(ElementReference element)
    {
        TriggerElement = element;
        HasTrigger = true;
    }

    internal void RegisterValueNode(ElementReference element)
    {
        ValueNodeElement = element;
        HasValueNode = true;
    }

    internal void RegisterBubbleSelect(ElementReference element)
    {
        _bubbleSelectElement = element;
        _hasBubbleSelectElement.Value = true;
    }

    internal void SetValueNodeHasChildren(bool hasChildren)
    {
        if (ValueNodeHasChildren == hasChildren)
            return;

        ValueNodeHasChildren = hasChildren;
        _ = RequestRender();
    }

    internal Task FocusTrigger()
    {
        return HasTrigger ? ControlsInterop.FocusElementPreventScroll(TriggerElement).AsTask() : Task.CompletedTask;
    }

    private string? _pendingUserValue;
    private bool _hasPendingUserValue;

    internal async Task SetValue(string? value)
    {
        if (string.Equals(CurrentValue, value, StringComparison.Ordinal))
            return;

        _pendingUserValue = value;
        _hasPendingUserValue = true;
        if (Value is null && !ValueChanged.HasDelegate)
        {
            _uncontrolledValue = value;
            UpdateCurrentText(GetItemText(value));
        }

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(value);

        await RequestRender();
    }

    internal async Task SetOpen(bool open)
    {
        if (CurrentOpen == open)
            return;

        if (Open is null)
            _uncontrolledOpen = open;

        if (!open)
        {
            _typeahead.Reset();
            _triggerPointerDownPosition = null;
        }

        if (OpenChanged.HasDelegate)
            await OpenChanged.InvokeAsync(open);

        if (OnOpenChange.HasDelegate)
            await OnOpenChange.InvokeAsync(open);

        await RequestRender();
    }

    internal Task ToggleOpen()
    {
        return SetOpen(!CurrentOpen);
    }

    internal Task OpenFromTrigger(double? pageX = null, double? pageY = null)
    {
        _typeahead.Reset();

        if (pageX.HasValue && pageY.HasValue)
            _triggerPointerDownPosition = (pageX.Value, pageY.Value);
        else
            _triggerPointerDownPosition = null;

        return SetOpen(true);
    }

    internal void ClearTriggerPointerDownPosition()
    {
        _triggerPointerDownPosition = null;
    }

    internal void SetSuppressNextMousePointerUpSelection(bool suppress)
    {
        _suppressNextMousePointerUpSelection.Value = suppress;
    }

    internal bool ConsumeSuppressNextMousePointerUpSelection()
    {
        return _suppressNextMousePointerUpSelection.Exchange(false);
    }

    internal void SetFocusedItem(string? value)
    {
        if (string.Equals(CurrentFocusedItemValue, value, StringComparison.Ordinal))
            return;

        string? previousValue = CurrentFocusedItemValue;
        CurrentFocusedItemValue = value;
        _ = RefreshFocusedItems(previousValue, value);
    }

    internal bool IsFocusedItem(IBradixSelectCollectionItem item)
    {
        return string.Equals(CurrentFocusedItemValue, item.Value, StringComparison.Ordinal);
    }

    internal async Task FocusSelectedOrFirstItem()
    {
        IBradixSelectCollectionItem? target = GetSelectedOrFirstEnabledItem();

        if (target is null)
            return;

        await FocusItem(target);
    }

    internal async Task FocusFirstItem()
    {
        IBradixSelectCollectionItem? first = GetFirstEnabledItem();

        if (first is null)
            return;

        await FocusItem(first);
    }

    internal async Task FocusLastItem()
    {
        IBradixSelectCollectionItem? last = GetLastEnabledItem();

        if (last is null)
            return;

        await FocusItem(last);
    }

    internal async Task HandleTriggerTypeahead(string key)
    {
        string search = _typeahead.Append(key);
        IBradixSelectCollectionItem? currentItem = FindEnabledItem(CurrentValue);
        IBradixSelectCollectionItem? nextItem = FindNextTypeaheadItem(search, currentItem);

        if (nextItem is null)
            return;

        await SetValue(nextItem.Value);
    }

    internal async Task HandleContentTypeahead(string key)
    {
        string search = _typeahead.Append(key);
        IBradixSelectCollectionItem? currentItem = FindEnabledItem(CurrentFocusedItemValue);
        if (search.Length == 1)
            currentItem = null;

        IBradixSelectCollectionItem? nextItem = FindNextTypeaheadItem(search, currentItem);

        if (nextItem is null)
            return;

        await FocusItem(nextItem);
    }

    internal async Task HandleContentNavigation(string key)
    {
        switch (key)
        {
            case "Home":
            case "PageUp":
                await FocusFirstItem();
                return;
            case "End":
            case "PageDown":
                await FocusLastItem();
                return;
        }

        if (key is not ("ArrowUp" or "ArrowDown"))
            return;

        int enabledCount = CountEnabledItems(CurrentFocusedItemValue, CurrentValue, out int currentIndex);
        if (enabledCount == 0 || currentIndex < 0)
            return;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(key, "vertical", ResolvedDirection, currentIndex, enabledCount, false, out int targetIndex))
            return;

        IBradixSelectCollectionItem? target = GetEnabledItemAt(targetIndex);
        if (target is not null)
            await FocusItem(target);
    }

    internal async Task SetFocusedItemFromScript(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        IBradixSelectCollectionItem? item = FindEnabledItem(value);

        if (item is null || string.Equals(CurrentFocusedItemValue, item.Value, StringComparison.Ordinal))
            return;

        string? previousValue = CurrentFocusedItemValue;
        CurrentFocusedItemValue = item.Value;
        await RefreshFocusedItems(previousValue, item.Value);
    }

    internal Task NotifyItemTextChanged()
    {
        UpdateCurrentText();

        if (ShouldRenderBubbleSelect || !ValueNodeHasChildren)
            QueueRefresh();

        return Task.CompletedTask;
    }

    private string? GetItemText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return _items.TryGet(value, out IBradixSelectCollectionItem? item)
            ? item.TextValue
            : null;
    }

    private void UpdateCurrentText(string? preferredText = null)
    {
        if (string.IsNullOrWhiteSpace(CurrentValue))
        {
            _currentText = string.Empty;
            return;
        }

        if (!string.IsNullOrWhiteSpace(preferredText))
        {
            _currentText = preferredText;
            return;
        }

        string? resolvedText = GetItemText(CurrentValue);

        if (resolvedText is not null)
            _currentText = resolvedText;
    }

    private async Task FocusItem(IBradixSelectCollectionItem item)
    {
        string? previousValue = CurrentFocusedItemValue;
        CurrentFocusedItemValue = item.Value;
        await RefreshFocusedItems(previousValue, item.Value);
        await Task.Yield();
        await item.ScrollIntoView();
        await item.Focus();
    }

    private async Task RefreshFocusedItems(string? previousValue, string? nextValue)
    {
        if (string.Equals(previousValue, nextValue, StringComparison.Ordinal))
            return;

        if (previousValue is not null && _items.TryGet(previousValue, out var previous))
            await previous.Refresh();

        if (nextValue is not null && _items.TryGet(nextValue, out var next))
            await next.Refresh();
    }

    internal IBradixSelectCollectionItem? GetSelectedOrFirstEnabledItem()
    {
        return FindEnabledItem(CurrentValue) ?? GetFirstEnabledItem();
    }

    internal IBradixSelectCollectionItem? GetPositioningItem()
    {
        IBradixSelectCollectionItem? item = GetSelectedOrFirstEnabledItem();
        if (item is not null) return item;
        var items = _items.Snapshot();
        return items.Count > 0 ? items[0].Item : null;
    }

    internal IBradixSelectCollectionItem? GetSelectedItem()
    {
        return CurrentValue is not null && _items.TryGet(CurrentValue, out IBradixSelectCollectionItem? item)
            ? item
            : null;
    }

    [JSInvokable]
    public Task HandleNativeChangeFromScript(string? value)
    {
        return SetValue(string.IsNullOrEmpty(value) ? null : value);
    }

    private void QueueRefresh()
    {
        if (_disposed.Read())
            return;

        if (!_refreshQueued.TrySetTrue())
            return;

        _ = InvokeAsync(_refreshCallback ??= RefreshQueued);
    }

    private void RefreshQueued()
    {
        if (_disposed.Read()) return;
        _refreshQueued.Value = false;
        StateHasChanged();
    }

    private void QueueOpenItemFocusIfNeeded()
    {
        if (_disposed.Read() || !CurrentOpen || CurrentFocusedItemValue is not null || !_focusOpenItemQueued.TrySetTrue())
            return;

        _ = InvokeAsync(_focusOpenItemCallback ??= FocusOpenItemQueued);
    }

    private async Task FocusOpenItemQueued()
    {
        if (_disposed.Read()) return;
        await Task.Yield();
        _focusOpenItemQueued.Value = false;
        if (_disposed.Read() || !CurrentOpen || CurrentFocusedItemValue is not null) return;
        await FocusSelectedOrFirstItem();
    }

    private IBradixSelectCollectionItem? GetFirstEnabledItem()
    {
        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (!entry.Value.Disabled)
                return entry.Value;
        }

        return null;
    }

    private IBradixSelectCollectionItem? GetLastEnabledItem()
    {
        IBradixSelectCollectionItem? last = null;

        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (!entry.Value.Disabled)
                last = entry.Value;
        }

        return last;
    }

    private IBradixSelectCollectionItem? FindEnabledItem(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        return _items.TryGet(value, out var item) && !item.Disabled ? item : null;
    }

    private int CountEnabledItems(string? preferredValue, string? fallbackValue, out int currentIndex)
    {
        currentIndex = -1;
        var count = 0;
        var matchedPreferred = false;
        bool hasPreferred = !string.IsNullOrWhiteSpace(preferredValue);
        bool hasFallback = !string.IsNullOrWhiteSpace(fallbackValue);

        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (entry.Value.Disabled)
                continue;

            if (hasPreferred && string.Equals(entry.Value.Value, preferredValue, StringComparison.Ordinal))
            {
                currentIndex = count;
                matchedPreferred = true;
            }
            else if (!matchedPreferred && hasFallback && string.Equals(entry.Value.Value, fallbackValue, StringComparison.Ordinal))
            {
                currentIndex = count;
            }

            count++;
        }

        return count;
    }

    private IBradixSelectCollectionItem? GetEnabledItemAt(int targetIndex)
    {
        var index = 0;

        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (entry.Value.Disabled)
                continue;

            if (index == targetIndex)
                return entry.Value;

            index++;
        }

        return null;
    }

    private IBradixSelectCollectionItem? FindNextTypeaheadItem(string search, IBradixSelectCollectionItem? currentItem)
    {
        int enabledCount = CountEnabledItems(currentItem, out int currentIndex);
        if (enabledCount == 0 || string.IsNullOrEmpty(search))
            return null;

        ReadOnlySpan<char> normalizedSearch = BradixTypeaheadMatcher.GetNormalizedSearch(search);
        int startIndex = Math.Max(currentIndex, 0);
        bool excludeCurrentItem = normalizedSearch.Length == 1 && currentItem is not null;
        IBradixSelectCollectionItem? nextItem = FindNextTypeaheadItemInRange(normalizedSearch, currentItem, excludeCurrentItem, startIndex, enabledCount)
                                             ?? FindNextTypeaheadItemInRange(normalizedSearch, currentItem, excludeCurrentItem, 0, startIndex);

        return currentItem is not null && ReferenceEquals(nextItem, currentItem) ? null : nextItem;
    }

    private int CountEnabledItems(IBradixSelectCollectionItem? current, out int currentIndex)
    {
        currentIndex = -1;
        var count = 0;

        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (entry.Value.Disabled)
                continue;

            if (ReferenceEquals(entry.Value, current))
                currentIndex = count;

            count++;
        }

        return count;
    }

    private IBradixSelectCollectionItem? FindNextTypeaheadItemInRange(ReadOnlySpan<char> normalizedSearch, IBradixSelectCollectionItem? currentItem, bool excludeCurrentItem,
        int startIndex, int endIndex)
    {
        var index = 0;

        foreach (KeyValuePair<string, IBradixSelectCollectionItem> entry in _items)
        {
            if (index >= endIndex) break;

            IBradixSelectCollectionItem item = entry.Value;
            if (item.Disabled)
                continue;

            if (index >= startIndex && index < endIndex)
            {
                if ((!excludeCurrentItem || !ReferenceEquals(item, currentItem)) &&
                    item.TextValue.AsSpan().StartsWith(normalizedSearch, StringComparison.OrdinalIgnoreCase))
                {
                    return item;
                }
            }

            index++;
        }

        return null;
    }

    private async Task EnsureBubbleSelectRegistration()
    {
        if (_disposed.Read() || !_hasBubbleSelectElement.Value || _bubbleSelectRegistered.Value)
            return;

        if (_bubbleSelectRegistrationTask is not null)
        {
            await _bubbleSelectRegistrationTask;
            return;
        }

        _bubbleSelectRegistrationTask = RegisterBubbleSelectCore();

        try
        {
            await _bubbleSelectRegistrationTask;
        }
        finally
        {
            _bubbleSelectRegistrationTask = null;
        }
    }

    private async Task RegisterBubbleSelectCore()
    {
        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        await ControlsInterop.RegisterSelectBubbleInput(_bubbleSelectElement, _dotNetReference);

        await FormInterop.RegisterAssociatedFormReset(_bubbleSelectElement, _dotNetReference, Form);
        _bubbleSelectRegistered.Value = true;
    }

    [JSInvokable]
    public async Task HandleFormReset()
    {
        _hasPendingUserValue = false;
        if (Value is null && !ValueChanged.HasDelegate) _uncontrolledValue = DefaultValue;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(DefaultValue);
        if (OnValueChange.HasDelegate) await OnValueChange.InvokeAsync(DefaultValue);
        UpdateCurrentText();
        await RequestRender();
    }

    private async Task SyncBubbleSelectValue()
    {
        if (_disposed.Read() || !_hasBubbleSelectElement.Value)
            return;

        string? nextValue = CurrentValue;
        bool valueChanged = !string.Equals(_lastBubbleSelectValue, nextValue, StringComparison.Ordinal);

        if (_bubbleSelectValueInitialized.Value && !valueChanged)
            return;

        bool dispatchEvent = _bubbleSelectValueInitialized.Value && _hasPendingUserValue &&
            string.Equals(_pendingUserValue, nextValue, StringComparison.Ordinal);
        if (dispatchEvent) _hasPendingUserValue = false;
        await ControlsInterop.SyncSelectBubbleInputValue(_bubbleSelectElement, nextValue, dispatchEvent);

        _lastBubbleSelectValue = nextValue;
        _bubbleSelectValueInitialized.Value = true;
    }
}
