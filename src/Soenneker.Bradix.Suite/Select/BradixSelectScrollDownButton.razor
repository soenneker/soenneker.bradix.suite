@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixSelectScrollDownButton

@if (Content?.CanScrollDown == true)
{
    <div aria-hidden="true"
         @onpointerdown="(_cachedHandlePointerDownDelegate ??= HandlePointerDown)"
         @onpointermove="(_cachedHandlePointerMoveDelegate ??= HandlePointerMove)"
         @onpointerleave="(_cachedHandlePointerLeaveDelegate ??= HandlePointerLeave)"
         @onpointerup="(_cachedHandlePointerUpDelegate ??= HandlePointerUp)"
         @attributes="ButtonAttributes">
        @ChildContent
    </div>
}

@code {
    private string? _mergedStyleCache0;

    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerDownDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerMoveDelegate;
    private System.Action<PointerEventArgs>? _cachedHandlePointerLeaveDelegate;
    private System.Action<PointerEventArgs>? _cachedHandlePointerUpDelegate;

    private bool _didNotifyContent;

    [CascadingParameter]
    private BradixSelectContent? Content { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (Content is null)
        {
            _didNotifyContent = false;
            return Task.CompletedTask;
        }

        if (_didNotifyContent)
            return Task.CompletedTask;

        _didNotifyContent = true;
        return Content.HandleScrollButtonMounted();
    }

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("data-radix-select-scroll-down-button", string.Empty),
        ("style", BuildStyle()));

    private string BuildStyle()
    {
        const string baseStyle = "flex-shrink:0;";
        return BradixStringCache.MergeStyle(baseStyle, Style, ref _mergedStyleCache0)!;
    }

    private Task HandlePointerDown(PointerEventArgs _)
    {
        return Content?.StartAutoScroll(false) ?? Task.CompletedTask;
    }

    private Task HandlePointerMove(PointerEventArgs _)
    {
        return Content?.StartAutoScroll(false) ?? Task.CompletedTask;
    }

    private void HandlePointerLeave(PointerEventArgs _)
    {
        Content?.StopAutoScroll();
    }

    private void HandlePointerUp(PointerEventArgs _)
    {
        Content?.StopAutoScroll();
    }
}
