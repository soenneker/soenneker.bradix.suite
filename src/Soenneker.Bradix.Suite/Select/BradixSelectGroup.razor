@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixSelectGroup

<CascadingValue Value="_context">
    <div role="group"
         aria-labelledby="@_context.LabelId"
         @attributes="BuildAttributes()">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly BradixSelectGroupContext _context = new();

    protected override void OnInitialized()
    {
        _context.RegisterLabelId(BlazorIdGenerator.New("bradix-select-group-label"));
    }
}
