@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixSelectItemText
@implements IAsyncDisposable

@inject IDomInterop DomInterop
<span @ref="_element"
      @attributes="ItemTextAttributes">
    @ChildContent
</span>

@code {
    private ElementReference _element;
    private BradixTextObserver? _textObserver;

    [CascadingParameter]
    private BradixSelectItem? Item { get; set; }

    private Dictionary<string, object> ItemTextAttributes => BuildAttributes(
        ("id", Item?.TextId));

    protected override void OnInitialized() => Item?.RegisterTextContent();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Item is null)
            return;

        Item.RegisterTextElement(_element);

        if (Item.TextValue is not null)
        {
            if (_textObserver is not null)
            {
                await _textObserver.DisposeAsync();
                _textObserver = null;
            }
            return;
        }

        _textObserver ??= new BradixTextObserver(DomInterop, text => InvokeAsync(() => Item?.NotifyResolvedText(text) ?? Task.CompletedTask));
        await _textObserver.Observe(_element);
    }

    public async ValueTask DisposeAsync()
    {
        Item?.UnregisterTextContent();
        if (_textObserver is not null)
            await _textObserver.DisposeAsync();
    }
}
