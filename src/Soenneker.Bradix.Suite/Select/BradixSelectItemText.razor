@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixSelectItemText

@inject IDomInterop DomInterop
<span @ref="_element"
      @attributes="ItemTextAttributes">
    @ChildContent
</span>

@code {
    private ElementReference _element;
    private string? _lastResolvedText;

    [CascadingParameter]
    private BradixSelectItem? Item { get; set; }

    private Dictionary<string, object> ItemTextAttributes => BuildAttributes(
        ("id", Item?.TextId));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Item is null)
            return;

        Item.RegisterTextElement(_element);

        if (Item.TextValue is not null)
            return;

        string text = await DomInterop.GetTextContent(_element);

        if (string.Equals(_lastResolvedText, text, StringComparison.Ordinal))
            return;

        _lastResolvedText = text;
        await Item.NotifyResolvedText(text);
    }
}
