@using System.Text.Json
@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using System.Threading
@using Microsoft.JSInterop

@inherits BradixIdentifiableContentElement

@implements IBradixSelectContent

@inject ISelectInterop SelectInterop
@inject IPresenceOverlayInterop PresenceOverlayInterop
@inject IControlsInterop ControlsInterop

@if (ShouldRenderContainer)
{
    <BradixRemoveScroll AllowPinchZoom>
        <BradixFocusGuards>
            <BradixFocusScope Trapped="@(Select?.CurrentOpen == true)"
                              PreventMountAutoFocus="true"
                              PreventUnmountAutoFocus="true"
                              OnMountAutoFocusDetailed="(_cachedHandleOpenAutoFocusDelegate ??= HandleOpenAutoFocus)"
                              OnUnmountAutoFocusDetailed="(_cachedHandleCloseAutoFocusDelegate ??= HandleCloseAutoFocus)">
                <BradixDismissableLayer DeferPointerDownOutside="true" DisableOutsidePointerEvents="@ShouldDisableOutsidePointerEvents"
                                        DismissOnEscapeKeyDown="true"
                                        DismissOnPointerDownOutside="true"
                                        DismissOnFocusOutside="true"
                                        OnDismiss="(_cachedHandleDismissDelegate ??= HandleDismiss)"
                                        OnEscapeKeyDownDetailed="(_cachedHandleEscapeKeyDownDelegate ??= HandleEscapeKeyDown)"
                                        OnPointerDownOutsideDetailed="(_cachedHandlePointerDownOutsideDelegate ??= HandlePointerDownOutside)"
                                        OnFocusOutsideDetailed="(_cachedHandleFocusOutsideDelegate ??= HandleFocusOutside)">
                    @if (UseItemAlignedPosition)
                    {
                        <div @ref="_wrapperElement"
                             data-radix-select-position="item-aligned"
                             style="display:flex;flex-direction:column;position:fixed;">
                            <BradixPresence Present="@IsPresent"
                                            Tag="div"
                                            Id="@Select?.ContentId"
                                            Class="@Class"
                                            Style="@MergedStyle"
                                            AdditionalAttributes="@ContentAttributes"
                                            OnKeyDown="(_cachedHandleContentKeyDownDelegate ??= HandleContentKeyDown)"
                                            PreventKeyDownDefault="true"
                                            OnElementReferenceCaptured="(_cachedHandleContentElementCapturedDelegate ??= HandleContentElementCaptured)"
                                            OnExitComplete="(_cachedHandleExitCompleteDelegate ??= HandleExitComplete)">
                                <CascadingValue Value="this">
                                    @ChildContent
                                </CascadingValue>
                            </BradixPresence>
                        </div>
                    }
                    else
                    {
                        <BradixPopperContent Side="@Side"
                                             SideOffset="@SideOffset"
                                             Align="@Align"
                                             AlignOffset="@AlignOffset"
                                             ArrowPadding="@ArrowPadding"
                                             AvoidCollisions="@AvoidCollisions"
                                             CollisionPadding="@CollisionPadding"
                                             CollisionBoundarySelector="@CollisionBoundarySelector"
                                             CollisionBoundarySelectors="@CollisionBoundarySelectors"
                                             Sticky="@Sticky"
                                             UpdatePositionStrategy="@UpdatePositionStrategy"
                                             HideWhenDetached="@HideWhenDetached"
                                             Style="@PositionerStyle"
                                             OnPlaced="@OnPlaced"
                                             OnPlacementChanged="(_cachedHandlePlacementChangedDelegate ??= HandlePlacementChanged)">
                            <BradixPresence Present="@IsPresent"
                                            Tag="div"
                                            Id="@Select?.ContentId"
                                            Class="@Class"
                                            Style="@MergedStyle"
                                            AdditionalAttributes="@ContentAttributes"
                                            OnKeyDown="(_cachedHandleContentKeyDownDelegate ??= HandleContentKeyDown)"
                                            PreventKeyDownDefault="true"
                                            OnElementReferenceCaptured="(_cachedHandleContentElementCapturedDelegate ??= HandleContentElementCaptured)"
                                            OnExitComplete="(_cachedHandleExitCompleteDelegate ??= HandleExitComplete)">
                                <CascadingValue Value="this">
                                    @ChildContent
                                </CascadingValue>
                            </BradixPresence>
                        </BradixPopperContent>
                    }
                </BradixDismissableLayer>
            </BradixFocusScope>
        </BradixFocusGuards>
    </BradixRemoveScroll>
}
else
{
    <div hidden
         style="display:none;">
        @ChildContent
    </div>
}

@code {
    private string? _mergedStyleCache0;

    private System.Func<BradixAutoFocusEventArgs, Task>? _cachedHandleOpenAutoFocusDelegate;
    private System.Func<BradixAutoFocusEventArgs, Task>? _cachedHandleCloseAutoFocusDelegate;
    private System.Func<Task>? _cachedHandleDismissDelegate;
    private System.Func<BradixEscapeKeyDownEventArgs, Task>? _cachedHandleEscapeKeyDownDelegate;
    private System.Func<BradixPointerDownOutsideEventArgs, Task>? _cachedHandlePointerDownOutsideDelegate;
    private System.Func<BradixFocusOutsideEventArgs, Task>? _cachedHandleFocusOutsideDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleContentKeyDownDelegate;
    private System.Func<ElementReference, Task>? _cachedHandleContentElementCapturedDelegate;
    private System.Func<Task>? _cachedHandleExitCompleteDelegate;
    private System.Func<BradixPopperPlacementEventArgs, Task>? _cachedHandlePlacementChangedDelegate;

    private ValueAtomicBool _disposed;
    private bool _wasPresent;
    private ValueAtomicBool _isExiting;
    private ValueAtomicBool _didFocusOpenItem;
    private ValueAtomicBool _pendingOpenAutoFocus;
    private ValueAtomicBool _hasContentElement;
    private ValueAtomicBool _hasViewportElement;
    private ValueAtomicBool _itemAlignedRegistered;
    private ValueAtomicBool _openLayoutPassQueued;
    private Func<Task>? _openLayoutPassCallback;
    private ValueAtomicBool _viewportRegistered;
    private ValueAtomicBool _shouldRepositionOnScrollButton = new(true);
    private ValueAtomicBool _pointerTrackerRegistered;
    private ValueAtomicBool _keyboardRegistered;
    private ValueAtomicBool _windowDismissRegistered;
    private ValueAtomicBool _hideOthersRegistered;
    private double _viewportScrollTop;
    private double _viewportScrollHeight;
    private double _viewportHeight;
    private string? _lastItemAlignedPositionValue;
    private CancellationTokenSource? _autoScrollCts;
    private Task? _autoScrollTask;
    private bool _autoScrollUpward;
    private ElementReference _contentElement;
    private ElementReference _viewportElement;
    private ElementReference _wrapperElement;
    private ElementReference _viewportContentElement;
    private DotNetObjectReference<object>? _dotNetReference;
    private string? _placedSide;
    private string? _placedAlign;

    [CascadingParameter]
    private BradixSelect? Select { get; set; }

    [Parameter]
    public bool ForceMount { get; set; }

    [Parameter]
    public SelectPosition Position { get; set; } = SelectPosition.ItemAligned;

    [Parameter]
    public Side Side { get; set; } = Soenneker.Bradix.Side.Bottom;

    [Parameter]
    public double SideOffset { get; set; }

    [Parameter]
    public Alignment Align { get; set; } = Alignment.Start;

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public PopperUpdatePositionStrategy UpdatePositionStrategy { get; set; } = PopperUpdatePositionStrategy.Optimized;

    [Parameter]
    public bool HideWhenDetached { get; set; }

    [Parameter]
    public EventCallback OnEscapeKeyDown { get; set; }

    [Parameter]
    public EventCallback<BradixEscapeKeyDownEventArgs> OnEscapeKeyDownDetailed { get; set; }

    [Parameter]
    public EventCallback OnPointerDownOutside { get; set; }

    [Parameter]
    public EventCallback<BradixPointerDownOutsideEventArgs> OnPointerDownOutsideDetailed { get; set; }

    [Parameter]
    public EventCallback OnCloseAutoFocus { get; set; }

    [Parameter]
    public EventCallback<BradixAutoFocusEventArgs> OnCloseAutoFocusDetailed { get; set; }

    [Parameter]
    public EventCallback OnPlaced { get; set; }

    internal bool CanScrollUp => _viewportRegistered.Value && _viewportScrollTop > 0;

    internal bool CanScrollDown => _viewportRegistered.Value && Math.Ceiling(_viewportScrollTop) < Math.Max(_viewportScrollHeight - _viewportHeight, 0);

    private bool IsPresent => Select?.CurrentOpen == true || ForceMount;
    private bool ShouldRenderContainer => Select is not null && (IsPresent || _isExiting.Value);
    private bool UseItemAlignedPosition => Position != SelectPosition.Popper;

    private bool ShouldDisableOutsidePointerEvents => Select?.CurrentOpen == true;

    private string PositionerStyle =>
        "--radix-select-content-transform-origin: var(--radix-popper-transform-origin); --radix-select-content-available-width: var(--radix-popper-available-width); --radix-select-content-available-height: var(--radix-popper-available-height); --radix-select-trigger-width: var(--radix-popper-anchor-width); --radix-select-trigger-height: var(--radix-popper-anchor-height);";

    private string MergedStyle => BradixStringCache.MergeStyle("display:flex;flex-direction:column;outline:none;", Style, ref _mergedStyleCache0)!;

    private IReadOnlyDictionary<string, object> ContentAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(7);

            attributes["role"] = "listbox";
            attributes["dir"] = Select?.ResolvedDirection ?? "ltr";
            attributes["data-state"] = Select?.CurrentOpen == true ? "open" : "closed";
            attributes["data-position"] = UseItemAlignedPosition ? "item-aligned" : "popper";
            attributes["data-side"] = UseItemAlignedPosition ? Side.Value : _placedSide ?? Side.Value;
            attributes["data-align"] = UseItemAlignedPosition ? Align.Value : _placedAlign ?? Align.Value;
            attributes["tabindex"] = BradixAttributeValues.MinusOne;
            return attributes;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        if (Select?.CurrentOpen == true)
        {
            if (UseItemAlignedPosition)
                await UpdateItemAlignedPosition();

            if (_pendingOpenAutoFocus.Value)
                await ApplyOpenAutoFocus();

            await EnsurePointerTracker();
            await EnsureKeyboard();
            await EnsureWindowDismiss();
            await EnsureHideOthers();
        }
        else
        {
            _didFocusOpenItem.Value = false;
            _pendingOpenAutoFocus.Value = false;
            _openLayoutPassQueued.Value = false;
            _shouldRepositionOnScrollButton.Value = true;
            _lastItemAlignedPositionValue = null;

            StopAutoScroll();

            if (_itemAlignedRegistered.Value)
            {
                await SelectInterop.UnregisterSelectItemAlignedPosition(_wrapperElement);
                _itemAlignedRegistered.Value = false;
            }

            if (_viewportRegistered.Value)
            {
                await SelectInterop.UnregisterSelectViewport(_viewportElement);
                _viewportRegistered.Value = false;
            }

            if (_pointerTrackerRegistered.Value)
            {
                await SelectInterop.UnregisterSelectContentPointerTracker(_contentElement);
                _pointerTrackerRegistered.Value = false;
            }

            if (_keyboardRegistered.Value)
            {
                await SelectInterop.UnregisterSelectContentKeyboard(_contentElement);
                _keyboardRegistered.Value = false;
            }

            if (_windowDismissRegistered.Value)
            {
                await SelectInterop.UnregisterSelectWindowDismiss(_contentElement);
                _windowDismissRegistered.Value = false;
            }

            if (_hideOthersRegistered.Value)
            {
                await PresenceOverlayInterop.UnregisterHideOthers(_contentElement);
                _hideOthersRegistered.Value = false;
            }

            _hasContentElement.Value = false;
            _hasViewportElement.Value = false;
            _contentElement = default;
            _viewportElement = default;
            _wrapperElement = default;
            _viewportContentElement = default;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        StopAutoScroll();
        try
        {
            if (_itemAlignedRegistered.Value)
            {
                _itemAlignedRegistered.Value = false;
                await SelectInterop.UnregisterSelectItemAlignedPosition(_wrapperElement);
            }
        }
        finally
        {
            try
            {
                if (_viewportRegistered.Value)
                {
                    _viewportRegistered.Value = false;
                    await SelectInterop.UnregisterSelectViewport(_viewportElement);
                }
            }
            finally
            {
                try
                {
                    if (_pointerTrackerRegistered.Value)
                    {
                        _pointerTrackerRegistered.Value = false;
                        await SelectInterop.UnregisterSelectContentPointerTracker(_contentElement);
                    }
                }
                finally
                {
                    try
                    {
                        if (_keyboardRegistered.Value)
                        {
                            _keyboardRegistered.Value = false;
                            await SelectInterop.UnregisterSelectContentKeyboard(_contentElement);
                        }
                    }
                    finally
                    {
                        try
                        {
                            if (_windowDismissRegistered.Value)
                            {
                                _windowDismissRegistered.Value = false;
                                await SelectInterop.UnregisterSelectWindowDismiss(_contentElement);
                            }
                        }
                        finally
                        {
                            try
                            {
                                if (_hideOthersRegistered.Value)
                                {
                                    _hideOthersRegistered.Value = false;
                                    await PresenceOverlayInterop.UnregisterHideOthers(_contentElement);
                                }
                            }
                            finally
                            {
                                _dotNetReference?.Dispose();
                                _dotNetReference = null;
                            }
                        }
                    }
                }
            }
        }
    }

    internal async Task RegisterViewport(ElementReference element)
    {
        if (_disposed.Read())
            return;

        _viewportElement = element;
        _hasViewportElement.Value = true;

        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        ElementReference registeredElement = _viewportElement;
        await SelectInterop.RegisterSelectViewport(registeredElement, _viewportContentElement, _wrapperElement, _dotNetReference);
        if (_disposed.Read())
        {
            await SelectInterop.UnregisterSelectViewport(registeredElement);
            return;
        }

        _viewportRegistered.Value = true;

        await CompleteOpenLayoutPass();
    }

    internal void RegisterViewportContent(ElementReference element)
    {
        _viewportContentElement = element;
    }

    internal Task FocusViewport()
    {
        return Select?.FocusSelectedOrFirstItem() ?? Task.CompletedTask;
    }

    internal void QueueOpenLayoutPass()
    {
        if (_disposed.Read() || !UseItemAlignedPosition || Select?.CurrentOpen != true || !_openLayoutPassQueued.TrySetTrue())
            return;

        _ = InvokeAsync(_openLayoutPassCallback ??= RunQueuedOpenLayoutPass);
    }

    internal async Task FocusContent()
    {
        if (!_hasContentElement.Value)
            return;

        Select?.SetFocusedItem(null);
        await ControlsInterop.FocusElementPreventScroll(_contentElement);
    }

    internal Task StartAutoScroll(bool upward)
    {
        if (_disposed.Read())
            return Task.CompletedTask;

        if (_autoScrollCts is not null && _autoScrollUpward == upward && _autoScrollTask is { IsCompleted: false })
            return _autoScrollTask;

        StopAutoScroll();
        _autoScrollCts = new CancellationTokenSource();
        _autoScrollUpward = upward;
        return _autoScrollTask = RunAutoScroll(upward, _autoScrollCts.Token);
    }

    internal void StopAutoScroll()
    {
        _autoScrollCts?.Cancel();
        _autoScrollCts?.Dispose();
        _autoScrollCts = null;
        _autoScrollTask = null;
    }

    internal async Task HandleScrollButtonMounted()
    {
        if (!UseItemAlignedPosition || !_shouldRepositionOnScrollButton.Value)
            return;

        _shouldRepositionOnScrollButton.Value = false;
        await UpdateItemAlignedPosition(force: true);
        await FocusViewport();
    }

    [JSInvokable]
    public Task HandleViewportMetricsChanged(double scrollTop, double scrollHeight, double viewportHeight)
    {
        if (_disposed.Read())
            return Task.CompletedTask;

        bool couldScrollUp = CanScrollUp;
        bool couldScrollDown = CanScrollDown;

        _viewportScrollTop = scrollTop;
        _viewportScrollHeight = scrollHeight;
        _viewportHeight = viewportHeight;

        return couldScrollUp != CanScrollUp || couldScrollDown != CanScrollDown
            ? RequestRender()
            : Task.CompletedTask;
    }

    [JSInvokable]
    public async Task HandleTriggerPointerGuardResult(bool suppressSelection, bool shouldClose)
    {
        Select?.SetSuppressNextMousePointerUpSelection(suppressSelection);

        if (!suppressSelection)
            Select?.ClearTriggerPointerDownPosition();

        if (shouldClose && Select is not null)
            await Select.SetOpen(false);

        _pointerTrackerRegistered.Value = false;
    }

    protected override void OnParametersSet()
    {
        bool present = IsPresent;

        if (_wasPresent && !present)
            _isExiting.Value = true;
        else if (present)
            _isExiting.Value = false;

        _wasPresent = present;
    }

    [JSInvokable]
    public async Task HandleTriggerPointerSelect(string? value)
    {
        if (Select is null || string.IsNullOrWhiteSpace(value))
            return;

        Select.ClearTriggerPointerDownPosition();
        await Select.SetValue(value);
        await Select.SetOpen(false);
        await Task.Yield();
        await Select.FocusTrigger();
    }

    [JSInvokable]
    public async Task HandleWindowDismiss()
    {
        if (Select is not null && Select.CurrentOpen)
            await Select.SetOpen(false);
    }

    private Task HandleContentElementCaptured(ElementReference element)
    {
        if (_disposed.Read())
            return Task.CompletedTask;

        _contentElement = element;
        _hasContentElement.Value = true;
        return HandleContentElementCapturedInternal();
    }

    private async Task HandleEscapeKeyDown(BradixEscapeKeyDownEventArgs args)
    {
        if (OnEscapeKeyDown.HasDelegate)
            await OnEscapeKeyDown.InvokeAsync();

        if (OnEscapeKeyDownDetailed.HasDelegate)
            await OnEscapeKeyDownDetailed.InvokeAsync(args);
    }

    private async Task HandlePointerDownOutside(BradixPointerDownOutsideEventArgs args)
    {
        if (OnPointerDownOutside.HasDelegate)
            await OnPointerDownOutside.InvokeAsync();

        if (OnPointerDownOutsideDetailed.HasDelegate)
            await OnPointerDownOutsideDetailed.InvokeAsync(args);
    }

    private Task HandlePlacementChanged(BradixPopperPlacementEventArgs args)
    {
        _placedSide = args.Side;
        _placedAlign = args.Align;
        return Task.CompletedTask;
    }

    private Task HandleFocusOutside(BradixFocusOutsideEventArgs args)
    {
        args.PreventDefault();
        return Task.CompletedTask;
    }

    private async Task HandleOpenAutoFocus(BradixAutoFocusEventArgs args)
    {
        if (_didFocusOpenItem.Value || Select is null || args.DefaultPrevented)
            return;

        _pendingOpenAutoFocus.Value = true;
        await ApplyOpenAutoFocus();
    }

    private async Task HandleCloseAutoFocus(BradixAutoFocusEventArgs args)
    {
        if (OnCloseAutoFocus.HasDelegate)
            await OnCloseAutoFocus.InvokeAsync();

        if (OnCloseAutoFocusDetailed.HasDelegate)
            await OnCloseAutoFocusDetailed.InvokeAsync(args);

        if (args.DefaultPrevented || Select is null)
            return;

        await Select.FocusTrigger();
        args.PreventDefault();
    }

    private Task HandleDismiss()
    {
        return Select?.SetOpen(false) ?? Task.CompletedTask;
    }

    private Task HandleExitComplete()
    {
        _isExiting.Value = false;
        return RequestRender();
    }

    private async Task HandleContentKeyDown(KeyboardEventArgs args)
    {
        if (args.IsComposing) return;
        if (Select is null || args.CtrlKey || args.AltKey || args.MetaKey)
            return;

        if (args.Key is "ArrowUp" or "ArrowDown" or "Home" or "End" or "PageUp" or "PageDown")
        {
            await Select.HandleContentNavigation(args.Key);
            return;
        }

        if (args.Key.Length == 1)
            await Select.HandleContentTypeahead(args.Key);
    }

    [JSInvokable(nameof(HandleDelegatedContentKeyDown))]
    public Task HandleDelegatedContentKeyDownFromJson(JsonElement payload) =>
        HandleDelegatedContentKeyDown(JsonSerializer.Deserialize(payload, BradixInteropJsonContext.Default.BradixDelegatedKeyboardEvent)!);

    public async Task HandleDelegatedContentKeyDown(BradixDelegatedKeyboardEvent args)
    {
        if (args.IsComposing) return;
        if (Select is null || args.CtrlKey || args.AltKey || args.MetaKey)
            return;

        if (args.Key == "Tab")
            return;

        if (args.Key is "ArrowUp" or "ArrowDown" or "Home" or "End" or "PageUp" or "PageDown")
        {
            await Select.HandleContentNavigation(args.Key);
            return;
        }

        if (args.Key.Length == 1)
            await Select.HandleContentTypeahead(args.Key);
    }

    [JSInvokable]
    public Task HandleDelegatedContentFocusedValueChanged(string? value)
    {
        return Select?.SetFocusedItemFromScript(value) ?? Task.CompletedTask;
    }

    private async Task UpdateItemAlignedPosition(bool force = false)
    {
        if (_disposed.Read())
            return;

        if (Select is null || !UseItemAlignedPosition || !_hasContentElement.Value || !_hasViewportElement.Value || !Select.HasTrigger || !Select.HasValueNode)
            return;

        IBradixSelectCollectionItem? selectedItem = Select.GetPositioningItem();

        if (selectedItem is null || !selectedItem.HasItemTextElement)
            return;

        if (_itemAlignedRegistered.Value && !force && string.Equals(_lastItemAlignedPositionValue, selectedItem.Value, StringComparison.Ordinal))
            return;

        if (_itemAlignedRegistered.Value)
        {
            await SelectInterop.UpdateSelectItemAlignedPosition(_wrapperElement, _contentElement, _viewportElement, Select.TriggerElement, Select.ValueNodeElement,
                selectedItem.ItemElement, selectedItem.ItemTextElement, Select.ResolvedDirection);
        }
        else
        {
            ElementReference registeredWrapper = _wrapperElement;
            await SelectInterop.RegisterSelectItemAlignedPosition(registeredWrapper, _contentElement, _viewportElement, Select.TriggerElement, Select.ValueNodeElement,
                selectedItem.ItemElement, selectedItem.ItemTextElement, Select.ResolvedDirection);
            if (_disposed.Read())
            {
                await SelectInterop.UnregisterSelectItemAlignedPosition(registeredWrapper);
                return;
            }

            _itemAlignedRegistered.Value = true;

            if (OnPlaced.HasDelegate)
                await OnPlaced.InvokeAsync();
        }

        _lastItemAlignedPositionValue = selectedItem.Value;
    }

    private async Task RunAutoScroll(bool upward, CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            if (Select is null)
                return;

            IBradixSelectCollectionItem? item = Select.GetSelectedOrFirstEnabledItem();

            try
            {
                if (item is not null)
                    await SelectInterop.ScrollSelectViewportByItem(_viewportElement, item.ItemElement, upward, cancellationToken);
                await Task.Delay(50, cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
        }
    }

    private async Task EnsurePointerTracker()
    {
        if (_disposed.Read())
            return;

        if (Select is null || !_hasContentElement.Value || _pointerTrackerRegistered.Value || !Select.HasTriggerPointerDownPosition)
            return;

        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        ElementReference registeredElement = _contentElement;
        await SelectInterop.RegisterSelectContentPointerTracker(registeredElement, _dotNetReference, Select.TriggerPointerDownX, Select.TriggerPointerDownY);
        if (_disposed.Read())
        {
            await SelectInterop.UnregisterSelectContentPointerTracker(registeredElement);
            return;
        }

        _pointerTrackerRegistered.Value = true;
    }

    private async Task EnsureKeyboard()
    {
        if (_disposed.Read())
            return;

        if (!_hasContentElement.Value || _keyboardRegistered.Value)
            return;

        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        ElementReference registeredElement = _contentElement;
        await SelectInterop.RegisterSelectContentKeyboard(registeredElement, _dotNetReference);
        if (_disposed.Read())
        {
            await SelectInterop.UnregisterSelectContentKeyboard(registeredElement);
            return;
        }

        _keyboardRegistered.Value = true;
    }

    private async Task EnsureWindowDismiss()
    {
        if (_disposed.Read())
            return;

        if (!_hasContentElement.Value || _windowDismissRegistered.Value)
            return;

        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        ElementReference registeredElement = _contentElement;
        await SelectInterop.RegisterSelectWindowDismiss(registeredElement, _dotNetReference);
        if (_disposed.Read())
        {
            await SelectInterop.UnregisterSelectWindowDismiss(registeredElement);
            return;
        }

        _windowDismissRegistered.Value = true;
    }

    private async Task EnsureHideOthers()
    {
        if (_disposed.Read())
            return;

        if (!_hasContentElement.Value || _hideOthersRegistered.Value)
            return;

        ElementReference registeredElement = _contentElement;
        await PresenceOverlayInterop.RegisterHideOthers(registeredElement);
        if (_disposed.Read())
        {
            await PresenceOverlayInterop.UnregisterHideOthers(registeredElement);
            return;
        }

        _hideOthersRegistered.Value = true;
    }

    private async Task HandleContentElementCapturedInternal()
    {
        await EnsureKeyboard();

        await CompleteOpenLayoutPass();
    }

    private async Task CompleteOpenLayoutPass()
    {
        if (_disposed.Read())
            return;

        if (Select?.CurrentOpen != true)
            return;

        if (UseItemAlignedPosition)
            await UpdateItemAlignedPosition(force: true);

        if (!_didFocusOpenItem.Value)
            await ApplyOpenAutoFocus();
    }

    private async Task RunQueuedOpenLayoutPass()
    {
        await Task.Yield();
        _openLayoutPassQueued.Value = false;
        await CompleteOpenLayoutPass();
    }

    private async Task ApplyOpenAutoFocus()
    {
        if (_disposed.Read())
            return;

        if (_didFocusOpenItem.Value || !_hasContentElement.Value || Select is null)
            return;

        if (Select.GetSelectedOrFirstEnabledItem() is null)
            return;

        _pendingOpenAutoFocus.Value = false;
        _didFocusOpenItem.Value = true;
        await Select.FocusSelectedOrFirstItem();
    }

}
