@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Blazor.Utils.Ids

@inherits BradixIdentifiableContentElement

@implements IBradixRadioGroupItem

@inject IRovingFocusInterop RovingFocusInterop
@inject IRadioGroupInterop RadioGroupInterop
@inject IFormInterop FormInterop
@inject IControlsInterop ControlsInterop
@if (RenderDefaultParts)
{
<CascadingValue Value="this">
    <button @ref="_element"
            @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
            @onclick:stopPropagation="ShouldRenderBubbleInput"
            @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
            @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
            @attributes="ItemAttributes">
        @ChildContent
    </button>
</CascadingValue>

@if (ShouldRenderBubbleInput)
{
    <input @ref="_bubbleInputElement"
           @attributes="BubbleInputAttributes" />
}
}
else
{
    <CascadingValue Value="this">@ChildContent</CascadingValue>
}

@code {
    protected virtual bool RenderDefaultParts => true;
    internal void ClearBubbleInput()
    {
        _bubbleInputElement = default;
        _hasSyncedBubbleInput.Value = false;
    }
    internal RenderFragment RenderTrigger(RenderFragment? content, IReadOnlyDictionary<string, object>? attributes = null) => @<button @ref="_element"
            @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
            @onclick:stopPropagation="ShouldRenderBubbleInput"
            @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
            @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
            @attributes="MergePartAttributes(ItemAttributes, attributes)">
        @content
    </button>;
    internal RenderFragment RenderBubbleInput(IReadOnlyDictionary<string, object>? attributes = null) => @<input @ref="_bubbleInputElement" @attributes="MergePartAttributes(BubbleInputAttributes, attributes)" />;

    private static Dictionary<string, object> MergePartAttributes(Dictionary<string, object> defaults, IReadOnlyDictionary<string, object>? attributes)
    {
        if (attributes is not null)
            foreach (var pair in attributes) defaults[pair.Key] = pair.Value;
        return defaults;
    }

    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private BradixAttributeDictionary? _bubbleAttributes;
    private ElementReference _element;
    private ElementReference _bubbleInputElement;
    private ValueAtomicBool _hasSyncedBubbleInput;
    private bool _isFormControl = true;
    private ValueAtomicBool _formControlStateResolved;
    private bool _lastRenderedChecked;
    private string? _lastResolvedForm;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;
    private ValueAtomicBool _rovingRegistered;
    private ValueAtomicBool _radioKeysRegistered;
    private ValueAtomicBool _rovingFocusBridgeReady;

    [CascadingParameter]
    internal BradixRadioGroup Group { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? InputValue { get; set; }

    [Parameter]
    public string? Form { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<FocusEventArgs> OnFocus { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    internal string? TabStopId { get; private set; }

    internal bool IsDisabled => Group.Disabled || Disabled;

    internal bool IsChecked => Group.IsChecked(Value);

    private string? ResolvedForm => Form ?? Group.Form;

    private bool ShouldRenderBubbleInput => _isFormControl || !string.IsNullOrWhiteSpace(ResolvedForm);

    private string ResolvedInputValue => InputValue ?? Value;

    private Dictionary<string, object> ItemAttributes => BuildAttributes(
        ("type", "button"),
        ("role", "radio"),
        ("aria-checked", IsChecked ? "true" : "false"),
        ("data-state", IsChecked ? "checked" : "unchecked"),
        ("data-disabled", IsDisabled ? string.Empty : null),
        ("data-orientation", Group.Orientation?.Value),
        ("data-bradix-roving-group", Group.GroupId),
        ("data-bradix-roving-item", string.Empty),
        ("data-bradix-roving-item-id", TabStopId),
        ("data-bradix-roving-orientation", Group.Orientation?.Value),
        ("data-bradix-roving-dir", Group.ResolvedDirection),
        ("data-bradix-roving-loop", Group.Loop ? "true" : "false"),
        ("data-bradix-roving-click-on-focus", "true"),
        ("disabled", IsDisabled ? BradixAttributeValues.True : null),
        ("value", ResolvedInputValue),
        ("tabindex", Group.IsCurrentTabStop(this) ? BradixAttributeValues.Zero : BradixAttributeValues.MinusOne));

    private Dictionary<string, object> BubbleInputAttributes
    {
        get
        {
            Dictionary<string, object> attributes = (_bubbleAttributes ??= new BradixAttributeDictionary()).Create(null, 10);
                attributes["type"] = "radio";
                attributes["name"] = Group.Name!;
                attributes["value"] = ResolvedInputValue;
                attributes["checked"] = IsChecked ? BradixAttributeValues.True : BradixAttributeValues.False;
                attributes["required"] = Group.Required ? BradixAttributeValues.True : BradixAttributeValues.False;
                attributes["disabled"] = IsDisabled ? BradixAttributeValues.True : BradixAttributeValues.False;
                attributes["tabindex"] = BradixAttributeValues.MinusOne;
                attributes["aria-hidden"] = "true";
                attributes["style"] = "position:absolute;width:0;height:0;padding:0;border:0;pointer-events:none;opacity:0;margin:0;transform:translateX(-100%);";

            if (!string.IsNullOrWhiteSpace(ResolvedForm))
                attributes["form"] = ResolvedForm;

            return attributes;
        }
    }

    protected override void OnInitialized()
    {
        TabStopId ??= BlazorIdGenerator.New("bradix-radio-group-item");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        if (!_registered.Value && !string.IsNullOrEmpty(_element.Id))
        {
            Group.RegisterItem(this);
            _registered.Value = true;
            await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_element);
            if (_disposed.Read())
            {
                await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
                return;
            }
            _rovingRegistered.Value = true;
            _rovingFocusBridgeReady.Value = true;
            await RadioGroupInterop.RegisterRadioGroupItemKeys(_element);
            if (_disposed.Read())
            {
                await RadioGroupInterop.UnregisterRadioGroupItemKeys(_element);
                return;
            }
            _radioKeysRegistered.Value = true;
        }

        if (!_formControlStateResolved.Value || !string.Equals(_lastResolvedForm, ResolvedForm, StringComparison.Ordinal))
        {
            bool isFormControl = await FormInterop.IsFormControl(_element, ResolvedForm);
            if (_disposed.Read())
                return;
            _formControlStateResolved.Value = true;
            _lastResolvedForm = ResolvedForm;

            if (_isFormControl != isFormControl)
            {
                _isFormControl = isFormControl;
                await RequestRender();
                return;
            }
        }

        if (ShouldRenderBubbleInput && !string.IsNullOrEmpty(_bubbleInputElement.Id))
        {
            if (!_hasSyncedBubbleInput.Value || _lastRenderedChecked != IsChecked)
            {
                bool isChecked = IsChecked;
                bool dispatchEvent = _hasSyncedBubbleInput.Value && isChecked && Group.ConsumeUserChange(Value);
                // Record the value sent to JavaScript before yielding: another render may change selection.
                _lastRenderedChecked = isChecked;
                _hasSyncedBubbleInput.Value = true;
                await ControlsInterop.SyncCheckboxBubbleInputState(_bubbleInputElement, isChecked, false, dispatchEvent);
            }

            _hasSyncedBubbleInput.Value = true;
        }
        else
        {
            _hasSyncedBubbleInput.Value = false;
        }

    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value)
        {
            _registered.Value = false;
            Group.UnregisterItem(this);
        }
        try
        {
            if (_rovingRegistered.Value)
            {
                _rovingRegistered.Value = false;
                await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_element);
            }
        }
        finally
        {
            if (_radioKeysRegistered.Value)
            {
                _radioKeysRegistered.Value = false;
                await RadioGroupInterop.UnregisterRadioGroupItemKeys(_element);
            }
        }
    }

    internal ValueTask Focus()
    {
        return _element.FocusAsync();
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);

        if (IsDisabled)
            return;

        await Group.SelectValue(Value);
    }

    private async Task HandleFocus(FocusEventArgs args)
    {
        if (OnFocus.HasDelegate)
            await OnFocus.InvokeAsync(args);

        if (IsDisabled)
            return;

        Group.SetCurrentTabStop(TabStopId);

        if (!IsChecked && Group.TryConsumeSelectOnFocus())
            await Group.SelectValue(Value);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.IsComposing) return;
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(args);

        if (_rovingFocusBridgeReady.Value && BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            return;

        if (IsDisabled)
            return;

        await Group.HandleItemKeyDown(this, args);
    }

    [JSInvokable]
    public Task HandleRovingFocusBridgeReady()
    {
        _rovingFocusBridgeReady.Value = true;
        return Task.CompletedTask;
    }
}
