@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixRadioGroup
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IFormInterop FormInterop

<CascadingValue Value="this">
    <div @ref="_element" @attributes="RootAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<BradixRadioGroupItem> _items = [];
    private ValueAtomicBool _initialized;
    private string? _uncontrolledValue;
    private ElementReference _element;
    private DotNetObjectReference<object>? _reference;
    private bool _disposed;

    [Parameter] public string? Form { get; set; }
    private string? _pendingUserValue;

    internal bool ConsumeUserChange(string value)
    {
        if (_pendingUserValue != value) return false;
        _pendingUserValue = null;
        return true;
    }

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public Orientation? Orientation { get; set; }

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public bool Loop { get; set; } = true;

    internal string GroupId { get; private set; } = string.Empty;

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal string? CurrentValue => Value ?? _uncontrolledValue;

    internal string? CurrentTabStopId { get; private set; }

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("role", "radiogroup"),
        ("aria-required", Required ? "true" : null),
        ("aria-disabled", Disabled ? "true" : null),
        ("aria-orientation", Orientation?.Value),
        ("data-disabled", Disabled ? string.Empty : null),
        ("data-orientation", Orientation?.Value),
        ("dir", ResolvedDirection));

    protected override void OnInitialized()
    {
        GroupId = BlazorIdGenerator.New("bradix-radio-group");
    }

    protected override void OnParametersSet()
    {
        if (_initialized.Value)
        {
            EnsureCurrentTabStopId();
            return;
        }

        _uncontrolledValue = DefaultValue;
        _initialized.Value = true;
        EnsureCurrentTabStopId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _reference = DotNetObjectReference.Create<object>(this);
        await FormInterop.RegisterAssociatedFormReset(_element, _reference, Form);
        if (_disposed) await FormInterop.UnregisterAssociatedFormReset(_element);
    }

    [JSInvokable]
    public async Task HandleFormReset()
    {
        if (_disposed) return;
        _pendingUserValue = null;
        if (Value is null) _uncontrolledValue = DefaultValue;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(DefaultValue);
        if (OnValueChange.HasDelegate) await OnValueChange.InvokeAsync(DefaultValue);
        EnsureCurrentTabStopId();
        await RequestRender();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await FormInterop.UnregisterAssociatedFormReset(_element); }
        finally { _reference?.Dispose(); }
    }

    internal bool IsChecked(string value)
    {
        return string.Equals(CurrentValue, value, StringComparison.Ordinal);
    }

    internal bool IsCurrentTabStop(BradixRadioGroupItem item)
    {
        return string.Equals(CurrentTabStopId, item.TabStopId, StringComparison.Ordinal);
    }

    internal void RegisterItem(BradixRadioGroupItem item)
    {
        if (_items.Contains(item))
            return;

        _items.Add(item);
        RefreshTabStopIfChanged();
    }

    internal void UnregisterItem(BradixRadioGroupItem item)
    {
        if (_items.Remove(item))
            RefreshTabStopIfChanged();
    }

    internal void SetCurrentTabStop(string? tabStopId)
    {
        if (string.Equals(CurrentTabStopId, tabStopId, StringComparison.Ordinal))
            return;

        CurrentTabStopId = tabStopId;
        _ = RequestRender();
    }

    internal bool TryConsumeSelectOnFocus()
    {
        return false;
    }

    internal async Task SelectValue(string value)
    {
        if (string.Equals(CurrentValue, value, StringComparison.Ordinal))
            return;

        _pendingUserValue = value;
        if (Value is null)
            _uncontrolledValue = value;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(value);

        EnsureCurrentTabStopId();
        await RequestRender();
    }

    internal async Task HandleItemKeyDown(BradixRadioGroupItem item, KeyboardEventArgs args)
    {
        if (args.IsComposing) return;
        if (args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
            return;

        if (args.Key is " " or "Spacebar")
        {
            await SelectValue(item.Value);
            return;
        }

        if (!BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            return;

        int focusableCount = CountFocusableItems(item, out int currentIndex);

        if (currentIndex < 0)
            return;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(
                args.Key,
                Orientation?.Value,
                ResolvedDirection,
                currentIndex,
                focusableCount,
                Loop,
                out int targetIndex))
        {
            return;
        }

        BradixRadioGroupItem target = GetFocusableItemAt(targetIndex)!;
        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await RequestRender();
    }

    private void RefreshTabStopIfChanged()
    {
        string? previous = CurrentTabStopId;
        EnsureCurrentTabStopId();
        if (!string.Equals(previous, CurrentTabStopId, StringComparison.Ordinal))
            _ = RequestRender();
    }

    private void EnsureCurrentTabStopId()
    {
        BradixRadioGroupItem? first = null;
        var hasCurrent = false;
        foreach (BradixRadioGroupItem item in _items)
        {
            if (item.IsDisabled)
                continue;
            first ??= item;
            if (item.IsChecked)
            {
                CurrentTabStopId = item.TabStopId;
                return;
            }
            hasCurrent |= CurrentTabStopId is not null && string.Equals(item.TabStopId, CurrentTabStopId, StringComparison.Ordinal);
        }
        if (!hasCurrent)
            CurrentTabStopId = first?.TabStopId;
    }

    private int CountFocusableItems(BradixRadioGroupItem current, out int currentIndex)
    {
        currentIndex = -1;
        var count = 0;
        foreach (BradixRadioGroupItem item in _items)
        {
            if (item.IsDisabled)
                continue;
            if (ReferenceEquals(item, current))
                currentIndex = count;
            count++;
        }
        return count;
    }

    private BradixRadioGroupItem? GetFocusableItemAt(int targetIndex)
    {
        var index = 0;
        foreach (BradixRadioGroupItem item in _items)
        {
            if (!item.IsDisabled && index++ == targetIndex)
                return item;
        }
        return null;
    }

    private static BradixRadioGroupItem? FindCheckedItem(IEnumerable<BradixRadioGroupItem> items)
    {
        foreach (BradixRadioGroupItem item in items)
        {
            if (item.IsChecked)
                return item;
        }

        return null;
    }

    private static bool ContainsTabStopId(IEnumerable<BradixRadioGroupItem> items, string tabStopId)
    {
        foreach (BradixRadioGroupItem item in items)
        {
            if (string.Equals(item.TabStopId, tabStopId, StringComparison.Ordinal))
                return true;
        }

        return false;
    }
}
