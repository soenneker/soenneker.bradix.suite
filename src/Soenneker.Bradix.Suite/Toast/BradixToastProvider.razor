@namespace Soenneker.Bradix

@inherits LeptonContent

@using Soenneker.Blazor.Utils.Ids
@implements IBradixToastProvider

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    private readonly HashSet<BradixToast> _toasts = [];
    private BradixToast[]? _toastSnapshot;

    [Parameter]
    public string Label { get; set; } = "Notification";

    [Parameter]
    public int Duration { get; set; } = 5000;

    [Parameter]
    public SwipeDirection SwipeDirection { get; set; } = SwipeDirection.Right;

    [Parameter]
    public double SwipeThreshold { get; set; } = 50;

    internal string? ViewportId { get; private set; }

    internal int ToastCount => _toasts.Count;

    internal bool HasViewport { get; private set; }

    internal bool IsClosePaused { get; private set; }

    protected override void OnInitialized()
    {
        ViewportId ??= BlazorIdGenerator.New("bradix-toast-viewport");
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Label))
            throw new InvalidOperationException("BradixToastProvider requires a non-empty Label.");

        if (Duration < 0)
            throw new InvalidOperationException("BradixToastProvider Duration must be zero or greater.");
    }

    internal void RegisterViewport(string? viewportId = null)
    {
        if (!string.IsNullOrWhiteSpace(viewportId))
            ViewportId = viewportId;

        if (HasViewport)
            return;

        HasViewport = true;
        _ = RequestRender();
    }

    internal void UnregisterViewport()
    {
        if (!HasViewport)
            return;

        HasViewport = false;
        _ = RequestRender();
    }

    internal void RegisterToast(BradixToast toast)
    {
        if (_toasts.Add(toast))
        {
            _toastSnapshot = null;
            _ = RequestRender();
        }
    }

    internal void UnregisterToast(BradixToast toast)
    {
        if (_toasts.Remove(toast))
        {
            _toastSnapshot = null;
            _ = RequestRender();
        }
    }

    internal async Task PauseToasts()
    {
        if (IsClosePaused)
            return;

        IsClosePaused = true;

        if (_toasts.Count == 0)
            return;

        BradixToast[] toasts = GetToastSnapshot();

        foreach (BradixToast toast in toasts)
        {
            await toast.Pause();
        }
    }

    internal async Task ResumeToasts()
    {
        if (!IsClosePaused)
            return;

        IsClosePaused = false;

        if (_toasts.Count == 0)
            return;

        BradixToast[] toasts = GetToastSnapshot();

        foreach (BradixToast toast in toasts)
        {
            await toast.Resume();
        }
    }
    private BradixToast[] GetToastSnapshot()
    {
        if (_toastSnapshot is not null) return _toastSnapshot;
        var snapshot = new BradixToast[_toasts.Count];
        _toasts.CopyTo(snapshot);
        return _toastSnapshot = snapshot;
    }

}
