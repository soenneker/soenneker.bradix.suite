@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits LeptonIdentifiableElement

@implements IBradixToastViewport

@inject IToastInterop ToastInterop
<div @ref="_wrapperElement"
     @attributes="RegionAttributes">
    @if (Provider?.ToastCount > 0)
    {
        <span @ref="_headFocusProxy"
              aria-hidden="true"
              tabindex="0"
              style="position:fixed;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none;"></span>
    }

    <ol @ref="_viewportElement"
        @attributes="ViewportAttributes"></ol>

    @if (Provider?.ToastCount > 0)
    {
        <span @ref="_tailFocusProxy"
              aria-hidden="true"
              tabindex="0"
              style="position:fixed;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none;"></span>
    }
</div>

@code {
    private static readonly IReadOnlyList<string> _defaultHotkey = ["F8"];

    private ElementReference _wrapperElement;
    private ElementReference _viewportElement;
    private ElementReference _headFocusProxy;
    private ElementReference _tailFocusProxy;
    private DotNetObjectReference<object>? _dotNetReference;
    private bool _lastRegisteredHasToasts;
    private string? _lastRegisteredHotkeySignature;
    private bool _registered;
    private string _hotkeyLabel = "F8";
    private string _hotkeySignature = "F8";

    [CascadingParameter]
    private BradixToastProvider? Provider { get; set; }

    [Parameter]
    public IReadOnlyList<string> Hotkey { get; set; } = _defaultHotkey;

    [Parameter]
    public string Label { get; set; } = "Notifications ({hotkey})";

    private string HotkeyLabel => _hotkeyLabel;

    private string ResolvedViewportId => Id ?? Provider?.ViewportId ?? string.Empty;

    private Dictionary<string, object> RegionAttributes
    {
        get
        {
            var attributes = new Dictionary<string, object>
            {
                ["role"] = "region",
                ["aria-label"] = Label.Replace("{hotkey}", HotkeyLabel, StringComparison.Ordinal),
                ["tabindex"] = -1
            };

            if (Provider?.ToastCount <= 0)
                attributes["style"] = "pointer-events:none;";

            return attributes;
        }
    }

    private Dictionary<string, object> ViewportAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAttributes(
                ("id", ResolvedViewportId),
                ("tabindex", -1));

            attributes["id"] = ResolvedViewportId;
            return attributes;
        }
    }

    protected override void OnParametersSet()
    {
        _hotkeyLabel = BuildHotkeyLabel(Hotkey);
        _hotkeySignature = BuildHotkeySignature(Hotkey);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            Provider?.RegisterViewport(ResolvedViewportId);

        bool hasToasts = Provider?.ToastCount > 0;

        if (!firstRender &&
            _registered &&
            _lastRegisteredHasToasts == hasToasts &&
            string.Equals(_lastRegisteredHotkeySignature, _hotkeySignature, StringComparison.Ordinal))
        {
            return;
        }

        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        await ToastInterop.RegisterToastViewport(_wrapperElement, _viewportElement, _headFocusProxy, _tailFocusProxy, Hotkey, _dotNetReference);
        _registered = true;
        _lastRegisteredHasToasts = hasToasts;
        _lastRegisteredHotkeySignature = _hotkeySignature;
    }

    public async ValueTask DisposeAsync()
    {
        Provider?.UnregisterViewport();

        if (_registered)
            await ToastInterop.UnregisterToastViewport(_viewportElement);

        _dotNetReference?.Dispose();
    }

    [JSInvokable]
    public Task HandlePause()
    {
        return Provider?.PauseToasts() ?? Task.CompletedTask;
    }

    [JSInvokable]
    public Task HandleResume()
    {
        return Provider?.ResumeToasts() ?? Task.CompletedTask;
    }

    private static string BuildHotkeyLabel(IReadOnlyList<string> hotkey)
    {
        if (hotkey.Count == 0)
            return string.Empty;

        int length = 0;

        for (int i = 0; i < hotkey.Count; i++)
            length += GetDisplayKeyLength(hotkey[i]) + (i == 0 ? 0 : 1);

        return string.Create(length, hotkey, static (span, keys) =>
        {
            int position = 0;

            for (int i = 0; i < keys.Count; i++)
            {
                if (i > 0)
                    span[position++] = '+';

                string key = keys[i];
                ReadOnlySpan<char> displayKey = GetDisplayKey(key);
                displayKey.CopyTo(span[position..]);
                position += displayKey.Length;
            }
        });
    }

    private static string BuildHotkeySignature(IReadOnlyList<string> hotkey)
    {
        if (hotkey.Count == 0)
            return string.Empty;

        int length = hotkey.Count - 1;

        foreach (string key in hotkey)
            length += key.Length;

        return string.Create(length, hotkey, static (span, keys) =>
        {
            int position = 0;

            for (int i = 0; i < keys.Count; i++)
            {
                if (i > 0)
                    span[position++] = '\u001F';

                keys[i].AsSpan().CopyTo(span[position..]);
                position += keys[i].Length;
            }
        });
    }

    private static int GetDisplayKeyLength(string key)
    {
        return GetDisplayKey(key).Length;
    }

    private static ReadOnlySpan<char> GetDisplayKey(string key)
    {
        ReadOnlySpan<char> span = key.AsSpan();

        if (span.StartsWith("Key", StringComparison.Ordinal))
            return span[3..];

        if (span.StartsWith("Digit", StringComparison.Ordinal))
            return span[5..];

        return span;
    }
}
