@namespace Soenneker.Bradix

@inherits BradixContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixToggleGroup

<CascadingValue Value="this">
    <div dir="@ResolvedDirection" @attributes="RootAttributes" @onfocus="HandleFocus">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<BradixToggleGroupItem> _items = [];
    private bool _initialized;
    private string _uncontrolledValue = string.Empty;
    private List<string> _uncontrolledValues = [];

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public SelectionMode Type { get; set; } = SelectionMode.Single;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool RovingFocus { get; set; } = true;

    [Parameter]
    public bool Loop { get; set; } = true;

    [Parameter]
    public Orientation? Orientation { get; set; }

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    [Parameter]
    public IReadOnlyCollection<string>? Values { get; set; }

    [Parameter]
    public IEnumerable<string>? DefaultValues { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> ValuesChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> OnValuesChange { get; set; }

    internal string GroupId { get; private set; } = string.Empty;

    internal string? CurrentTabStopId { get; private set; }

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    private bool IsSingle => Type != SelectionMode.Multiple;

    private string? NormalizedOrientation => Orientation?.Value;

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("role", IsSingle ? "radiogroup" : "toolbar"),
        ("tabindex", RovingFocus ? 0 : null),
        ("data-orientation", NormalizedOrientation));

    protected override void OnInitialized()
    {
        GroupId = BlazorIdGenerator.New("bradix-toggle-group");
    }

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            EnsureCurrentTabStopId();
            return;
        }

        _uncontrolledValue = NormalizeSingleValue(DefaultValue);
        _uncontrolledValues = CopyValues(DefaultValues);
        _initialized = true;
        EnsureCurrentTabStopId();
    }

    internal bool IsItemPressed(string value)
    {
        if (IsSingle)
            return string.Equals(NormalizeSingleValue(Value ?? _uncontrolledValue), value, StringComparison.Ordinal);

        IReadOnlyCollection<string> values = Values ?? _uncontrolledValues;
        return ContainsOrdinal(values, value);
    }

    internal bool IsCurrentTabStop(BradixToggleGroupItem item)
    {
        return !RovingFocus || string.Equals(CurrentTabStopId, item.TabStopId, StringComparison.Ordinal);
    }

    internal void RegisterItem(BradixToggleGroupItem item)
    {
        if (_items.Contains(item))
            return;

        _items.Add(item);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void UnregisterItem(BradixToggleGroupItem item)
    {
        _items.Remove(item);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void SetCurrentTabStop(string? tabStopId)
    {
        if (!RovingFocus || string.Equals(CurrentTabStopId, tabStopId, StringComparison.Ordinal))
            return;

        CurrentTabStopId = tabStopId;
        _ = InvokeAsync(StateHasChanged);
    }

    internal async Task ActivateItem(string value)
    {
        if (IsSingle)
        {
            await SetSingleValue(value);
            return;
        }

        List<string> next = Values is not null ? CopyValues(Values) : [.. _uncontrolledValues];

        if (ContainsOrdinal(next, value))
            return;

        next.Add(value);
        await SetMultipleValues(next);
    }

    internal async Task DeactivateItem(string value)
    {
        if (IsSingle)
        {
            await SetSingleValue(string.Empty);
            return;
        }

        List<string> next = Values is not null ? CopyValues(Values) : [.. _uncontrolledValues];

        if (!RemoveAllOrdinal(next, value))
            return;

        await SetMultipleValues(next);
    }

    internal async Task HandleItemKeyDown(BradixToggleGroupItem item, KeyboardEventArgs args)
    {
        if (!RovingFocus || args.CtrlKey || args.AltKey || args.MetaKey || args.ShiftKey)
            return;

        int focusableCount = CountFocusableItems(item, out int currentIndex);

        if (currentIndex < 0)
            return;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(
                args.Key,
                NormalizedOrientation,
                ResolvedDirection,
                currentIndex,
                focusableCount,
                Loop,
                out int targetIndex))
        {
            return;
        }

        BradixToggleGroupItem target = GetFocusableItemAt(targetIndex)!;
        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFocus(FocusEventArgs _)
    {
        if (!RovingFocus)
            return;

        BradixToggleGroupItem? target = GetPreferredTabStopItem();

        if (target is null)
            return;

        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
    }

    private void EnsureCurrentTabStopId()
    {
        if (CurrentTabStopId is null)
            return;
        foreach (BradixToggleGroupItem item in _items)
        {
            if (item.IsFocusable && string.Equals(item.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
                return;
        }
        CurrentTabStopId = null;
    }

    private BradixToggleGroupItem? GetPreferredTabStopItem()
    {
        BradixToggleGroupItem? first = null;
        BradixToggleGroupItem? current = null;
        foreach (BradixToggleGroupItem item in _items)
        {
            if (!item.IsFocusable)
                continue;
            first ??= item;
            if (item.IsPressed)
                return item;
            if (CurrentTabStopId is not null && string.Equals(item.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
                current = item;
        }
        return current ?? first;
    }

    private async Task SetSingleValue(string? value)
    {
        string normalizedValue = NormalizeSingleValue(value);

        if (string.Equals(NormalizeSingleValue(Value ?? _uncontrolledValue), normalizedValue, StringComparison.Ordinal))
            return;

        if (Value is null)
            _uncontrolledValue = normalizedValue;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(normalizedValue);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(normalizedValue);

        EnsureCurrentTabStopId();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetMultipleValues(List<string> next)
    {
        if (Values is null)
            _uncontrolledValues = next;

        if (ValuesChanged.HasDelegate)
            await ValuesChanged.InvokeAsync(next);

        if (OnValuesChange.HasDelegate)
            await OnValuesChange.InvokeAsync(next);

        EnsureCurrentTabStopId();
        await InvokeAsync(StateHasChanged);
    }

    private static string NormalizeSingleValue(string? value)
    {
        return value ?? string.Empty;
    }

    private int CountFocusableItems(BradixToggleGroupItem current, out int currentIndex)
    {
        currentIndex = -1;
        int count = 0;
        foreach (BradixToggleGroupItem item in _items)
        {
            if (!item.IsFocusable)
                continue;
            if (ReferenceEquals(item, current))
                currentIndex = count;
            count++;
        }
        return count;
    }

    private BradixToggleGroupItem? GetFocusableItemAt(int targetIndex)
    {
        int index = 0;
        foreach (BradixToggleGroupItem item in _items)
        {
            if (item.IsFocusable && index++ == targetIndex)
                return item;
        }
        return null;
    }

    private static BradixToggleGroupItem? FindPressedItem(IEnumerable<BradixToggleGroupItem> items)
    {
        foreach (BradixToggleGroupItem item in items)
        {
            if (item.IsPressed)
                return item;
        }

        return null;
    }

    private static BradixToggleGroupItem? FindTabStopItem(IEnumerable<BradixToggleGroupItem> items, string tabStopId)
    {
        foreach (BradixToggleGroupItem item in items)
        {
            if (string.Equals(item.TabStopId, tabStopId, StringComparison.Ordinal))
                return item;
        }

        return null;
    }

    private static List<string> CopyValues(IEnumerable<string>? values)
    {
        if (values is null)
            return [];

        if (values is IReadOnlyCollection<string> readOnlyCollection)
        {
            List<string> result = new(readOnlyCollection.Count);

            foreach (string value in readOnlyCollection)
                result.Add(value);

            return result;
        }

        if (values is ICollection<string> collection)
        {
            List<string> result = new(collection.Count);

            foreach (string value in collection)
                result.Add(value);

            return result;
        }

        return [.. values];
    }

    private static bool ContainsOrdinal(IEnumerable<string> values, string value)
    {
        foreach (string candidate in values)
        {
            if (string.Equals(candidate, value, StringComparison.Ordinal))
                return true;
        }

        return false;
    }

    private static bool RemoveAllOrdinal(List<string> values, string value)
    {
        var removed = false;

        for (int i = 0; i < values.Count; i++)
        {
            if (!string.Equals(values[i], value, StringComparison.Ordinal))
                continue;

            values.RemoveAt(i);
            i--;
            removed = true;
        }

        return removed;
    }
}
