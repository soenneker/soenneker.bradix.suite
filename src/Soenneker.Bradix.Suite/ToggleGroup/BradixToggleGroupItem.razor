@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@using Soenneker.Blazor.Utils.Ids
@implements IBradixToggleGroupItem

@inject IRovingFocusInterop RovingFocusInterop
<BradixToggle @ref="_toggle"
              Id="@Id"
              Class="@Class"
              Style="@Style"
              Pressed="@IsPressed"
              Disabled="@IsDisabled"
              RenderAriaPressed="@(!IsSingle)"
              OnClick="@OnClick"
              OnPressedChange="(_cachedHandlePressedChangeDelegate ??= HandlePressedChange)"
              OnMouseDown="(_cachedHandleMouseDownDelegate ??= HandleMouseDown)"
              OnFocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
              OnKeyDown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
              AdditionalAttributes="ToggleAttributes"
              ChildContent="@(ChildContent ?? BradixRenderFragments.Empty)" />

@code {
    private System.Func<bool, Task>? _cachedHandlePressedChangeDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleMouseDownDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private BradixToggle? _toggle;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;
    private ValueAtomicBool _rovingRegistered;

    [CascadingParameter]
    internal BradixToggleGroup Group { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Value { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<FocusEventArgs> OnFocus { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    internal string? TabStopId { get; private set; }

    internal bool IsPressed => Group.IsItemPressed(Value);

    internal bool IsDisabled => Group.Disabled || Disabled;

    internal bool IsFocusable => !IsDisabled;

    private bool IsSingle => Group.Type != SelectionMode.Multiple;

    private Dictionary<string, object> ToggleAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAdditionalAttributes(Group.RovingFocus ? 9 : 2);

            if (IsSingle)
            {
                attributes["role"] = "radio";
                attributes["aria-checked"] = IsPressed ? "true" : "false";
            }

            if (Group.RovingFocus)
            {
                attributes["tabindex"] = Group.IsCurrentTabStop(this) ? BradixAttributeValues.Zero : BradixAttributeValues.MinusOne;
                attributes["data-bradix-roving-group"] = Group.GroupId;
                attributes["data-bradix-roving-item"] = string.Empty;

                if (TabStopId is not null)
                    attributes["data-bradix-roving-item-id"] = TabStopId;

                if (Group.Orientation is not null)
                    attributes["data-bradix-roving-orientation"] = Group.Orientation.Value;

                attributes["data-bradix-roving-dir"] = Group.ResolvedDirection;
                attributes["data-bradix-roving-loop"] = Group.Loop ? "true" : "false";
            }

            return attributes;
        }
    }

    protected override void OnInitialized()
    {
        TabStopId ??= BlazorIdGenerator.New("bradix-toggle-group-item");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        if (!_registered.Value)
        {
            Group.RegisterItem(this);
            _registered.Value = true;
        }

        if (Group.RovingFocus && !_rovingRegistered.Value && _toggle is not null)
        {
            await RovingFocusInterop.RegisterRovingFocusNavigationKeys(_toggle.Element);
            if (_disposed.Read())
                await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_toggle.Element);
            else
                _rovingRegistered.Value = true;
        }
        else if (!Group.RovingFocus && _rovingRegistered.Value && _toggle is not null)
        {
            _rovingRegistered.Value = false;
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_toggle.Element);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value)
        {
            _registered.Value = false;
            Group.UnregisterItem(this);
        }
        if (_rovingRegistered.Value && _toggle is not null)
        {
            _rovingRegistered.Value = false;
            await RovingFocusInterop.UnregisterRovingFocusNavigationKeys(_toggle.Element);
        }
    }

    internal ValueTask Focus()
    {
        return _toggle?.Focus() ?? ValueTask.CompletedTask;
    }

    private Task HandleMouseDown(MouseEventArgs _)
    {
        if (IsFocusable)
            Group.SetCurrentTabStop(TabStopId);

        return Task.CompletedTask;
    }

    private async Task HandleFocus(FocusEventArgs args)
    {
        if (OnFocus.HasDelegate)
            await OnFocus.InvokeAsync(args);
        if (IsFocusable)
            Group.SetCurrentTabStop(TabStopId);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.IsComposing) return;
        if (OnKeyDown.HasDelegate)
            await OnKeyDown.InvokeAsync(args);
        if (!_rovingRegistered.Value || !BradixRovingFocusNavigator.IsNavigationKey(args.Key))
            await Group.HandleItemKeyDown(this, args);
    }

    private Task HandlePressedChange(bool pressed)
    {
        return pressed
            ? Group.ActivateItem(Value)
            : Group.DeactivateItem(Value);
    }
}
