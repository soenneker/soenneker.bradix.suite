@namespace Soenneker.Bradix

@inherits LeptonContent
@implements IBradixRemoveScroll

@inject IPresenceOverlayInterop PresenceOverlayInterop

@ChildContent
@code {
    private bool _registered;

    [Parameter]
    public bool AllowPinchZoom { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await PresenceOverlayInterop.RegisterRemoveScroll(AllowPinchZoom);
        _registered = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_registered)
            await PresenceOverlayInterop.UnregisterRemoveScroll();
    }
}
