@namespace Soenneker.Bradix
@using System

@inherits LeptonContent
@implements IBradixRemoveScroll

@inject IPresenceOverlayInterop PresenceOverlayInterop

@ChildContent
@code {
    private readonly string _registrationId = Guid.NewGuid().ToString("N");
    private bool _disposed;
    private bool _registered;

    [Parameter]
    public bool AllowPinchZoom { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await PresenceOverlayInterop.RegisterRemoveScroll(_registrationId, AllowPinchZoom);
        _registered = true;

        if (_disposed)
            await Unregister();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await Unregister();
    }

    private async ValueTask Unregister()
    {
        if (!_registered)
            return;

        await PresenceOverlayInterop.UnregisterRemoveScroll(_registrationId);
        _registered = false;
    }
}
