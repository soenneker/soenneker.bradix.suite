@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix
@using Soenneker.Blazor.Utils.Ids

@inherits LeptonContent
@implements IBradixRemoveScroll

@inject IPresenceOverlayInterop PresenceOverlayInterop

@ChildContent
@code {
    private readonly string _registrationId = BlazorIdGenerator.New("bradix-remove-scroll");
    private ValueAtomicBool _disposed;
    private ValueAtomicBool _registered;

    [Parameter]
    public bool AllowPinchZoom { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await PresenceOverlayInterop.RegisterRemoveScroll(_registrationId, AllowPinchZoom);
        _registered.Value = true;

        if (_disposed.Read())
            await Unregister();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        await Unregister();
    }

    private async ValueTask Unregister()
    {
        if (!_registered.Value)
            return;

        await PresenceOverlayInterop.UnregisterRemoveScroll(_registrationId);
        _registered.Value = false;
    }
}
