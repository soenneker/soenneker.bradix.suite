@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContent
@implements IBradixFocusGuards

@inject IPresenceOverlayInterop PresenceOverlayInterop

@ChildContent
@code {
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed.Read())
            return;

        await PresenceOverlayInterop.RegisterFocusGuards();
        if (_disposed.Read())
        {
            await PresenceOverlayInterop.UnregisterFocusGuards();
            return;
        }
        _registered.Value = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value)
        {
            _registered.Value = false;
            await PresenceOverlayInterop.UnregisterFocusGuards();
        }
    }
}
