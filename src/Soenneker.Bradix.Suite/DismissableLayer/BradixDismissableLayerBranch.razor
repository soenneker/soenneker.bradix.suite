@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixDismissableLayerBranch

@inject IDismissableLayerInterop DismissableLayerInterop
<div @ref="_element"
     @attributes="BranchAttributes">
    @ChildContent
</div>

@code {
    private string? _mergedStyleCache0;

    private ElementReference _element;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;

    private Dictionary<string, object> BranchAttributes => BuildAttributes(
        ("data-bradix-dismissable-layer-branch", string.Empty),
        ("style", BradixStringCache.MergeStyle("display:contents;", Style, ref _mergedStyleCache0)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed.Read())
            return;

        await DismissableLayerInterop.RegisterDismissableLayerBranch(_element);
        if (_disposed.Read())
        {
            await DismissableLayerInterop.UnregisterDismissableLayerBranch(_element);
            return;
        }
        _registered.Value = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value)
        {
            _registered.Value = false;
            await DismissableLayerInterop.UnregisterDismissableLayerBranch(_element);
        }
    }
}
