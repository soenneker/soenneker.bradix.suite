@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixPopperArrow
<span @ref="_element"
      @attributes="ArrowContainerAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <svg class="@Class"
             width="@_widthText.Get(Width)"
             height="@_heightText.Get(Height)"
             viewBox="0 0 30 10"
             preserveAspectRatio="none"
             style="display: block;">
            <polygon points="0,0 30,0 15,10"></polygon>
        </svg>
    }
</span>

@code {
    private string? _mergedStyleCache0;

    private BradixInvariantDoubleTextCache _widthText;
    private BradixInvariantDoubleTextCache _heightText;
    private string? _positionStyle;
    private (string Side, long? X, long? Y, bool Hidden) _positionKey;
    private ElementReference _element;

    [CascadingParameter]
    private BradixPopperContent? Content { get; set; }

    [Parameter]
    public double Width { get; set; } = 10;

    [Parameter]
    public double Height { get; set; } = 5;

    private Dictionary<string, object> ArrowContainerAttributes
    {
        get
        {
            var attributes = BuildAttributes(
                ("aria-hidden", "true"),
                ("style", BuildArrowStyle()));

            attributes.Remove("class");
            return attributes;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            Content?.RegisterArrow(_element);

        return Task.CompletedTask;
    }

    private string BuildArrowStyle()
    {
        if (Content is null)
            return Style ?? string.Empty;

        var key = (Content.PlacedSide,
            Content.ArrowX.HasValue ? (long?)BitConverter.DoubleToInt64Bits(Content.ArrowX.Value) : null,
            Content.ArrowY.HasValue ? (long?)BitConverter.DoubleToInt64Bits(Content.ArrowY.Value) : null,
            Content.ShouldHideArrow);
        if (_positionStyle is null || _positionKey != key)
        {
            _positionKey = key;
            _positionStyle = BuildPositionStyle(Content);
        }
        return BradixStringCache.MergeStyle(_positionStyle, Style, ref _mergedStyleCache0)!;
    }

    private static string BuildPositionStyle(BradixPopperContent content)
    {
        string oppositeSide = content.PlacedSide switch
        {
            "top" => "bottom",
            "right" => "left",
            "bottom" => "top",
            "left" => "right",
            _ => "top"
        };

        var transform = content.PlacedSide switch
        {
            "top" => " transform: translateY(100%);",
            "bottom" => " transform: translateY(-100%);",
            "left" => " transform: translateX(100%);",
            "right" => " transform: translateX(-100%);",
            _ => string.Empty
        };

        var positionStyle = $"position: absolute; {oppositeSide}: 0;{transform}";

        if (content.ArrowX.HasValue)
            positionStyle += $" left: {content.ArrowX.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";
        else if (content.ArrowY.HasValue)
            positionStyle += $" top: {content.ArrowY.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

        if (content.ShouldHideArrow)
            positionStyle += " visibility: hidden;";

        return positionStyle;
    }
}
