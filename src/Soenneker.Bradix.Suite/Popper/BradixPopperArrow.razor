@namespace Soenneker.Bradix

@inherits LeptonContentElement

@implements IBradixPopperArrow
<span @ref="_element"
      @attributes="ArrowContainerAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <svg class="@Class"
             width="@Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             height="@Height.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             viewBox="0 0 30 10"
             preserveAspectRatio="none"
             style="display: block;">
            <polygon points="0,0 30,0 15,10"></polygon>
        </svg>
    }
</span>

@code {
    private ElementReference _element;

    [CascadingParameter]
    private BradixPopperContent? Content { get; set; }

    [Parameter]
    public double Width { get; set; } = 10;

    [Parameter]
    public double Height { get; set; } = 5;

    private Dictionary<string, object> ArrowContainerAttributes
    {
        get
        {
            var attributes = BuildAttributes(
                ("aria-hidden", "true"),
                ("style", BuildArrowStyle()));

            attributes.Remove("class");
            return attributes;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            Content?.RegisterArrow(_element);

        return Task.CompletedTask;
    }

    private string BuildArrowStyle()
    {
        if (Content is null)
            return Style ?? string.Empty;

        string oppositeSide = Content.PlacedSide switch
        {
            "top" => "bottom",
            "right" => "left",
            "bottom" => "top",
            "left" => "right",
            _ => "top"
        };

        var transform = Content.PlacedSide switch
        {
            "top" => " transform: translateY(100%);",
            "bottom" => " transform: translateY(-100%);",
            "left" => " transform: translateX(100%);",
            "right" => " transform: translateX(-100%);",
            _ => string.Empty
        };

        var positionStyle = $"position: absolute; {oppositeSide}: 0;{transform}";

        if (Content.ArrowX.HasValue)
            positionStyle += $" left: {Content.ArrowX.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";
        else if (Content.ArrowY.HasValue)
            positionStyle += $" top: {Content.ArrowY.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

        if (Content.ShouldHideArrow)
            positionStyle += " visibility: hidden;";

        return MergeStyleValues(positionStyle, Style)!;
    }
}
