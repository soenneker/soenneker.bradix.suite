@namespace Soenneker.Bradix
@using Microsoft.JSInterop
@using Soenneker.Atomics.ValueBools

@inherits BradixIdentifiableContentElement

@implements IBradixPopperContent

@inject IPopperInterop PopperInterop
<CascadingValue Value="this" >
    <div @ref="_element" @attributes="ContentAttributes" >
        @ChildContent
    </div>
</CascadingValue>

@code {
    private string? _mergedStyleCache0;

    private string? _positionStyle;
    private string _boundarySelectorKey = string.Empty;
    private ElementReference _element;
    private ElementReference _arrow;
    private DotNetObjectReference<object>? _dotNetReference;
    private Task? _registrationTask;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;
    private string _placedSide = "bottom";
    private string _placedAlign = "center";
    private double _left;
    private double _top;
    private double _availableWidth;
    private double _availableHeight;
    private double _anchorWidth;
    private double _anchorHeight;
    private double? _arrowX;
    private double? _arrowY;
    private bool _hideArrow;
    private bool _hidden;
    private bool _isPositioned;
    private string _transformOriginX = "50%";
    private string _transformOriginY = "50%";
    private string? _zIndex;
    private (string Side, double SideOffset, string Align, double AlignOffset, double ArrowPadding, bool AvoidCollisions, double CollisionPadding, string CollisionBoundarySelectors, string Sticky, bool HideWhenDetached, string Dir, string UpdatePositionStrategy)? _lastOptions;
    private bool _lastHadArrow;
    private bool _lastHadElementAnchor;
    private ElementReference _lastElementAnchor;
    private ElementReference _lastArrow;
    private (double X, double Y)? _lastVirtualAnchor;
    private string? _lastAnchorSelector;

    [CascadingParameter]
    private BradixPopper? Popper { get; set; }

    [CascadingParameter(Name = "BradixDirection")]
    private string? Direction { get; set; }

    [Parameter]
    public Side Side { get; set; } = Soenneker.Bradix.Side.Bottom;

    [Parameter]
    public double SideOffset { get; set; }

    [Parameter]
    public Alignment Align { get; set; } = Alignment.Center;

    [Parameter]
    public double AlignOffset { get; set; }

    [Parameter]
    public double ArrowPadding { get; set; }

    [Parameter]
    public bool AvoidCollisions { get; set; } = true;

    [Parameter]
    public double CollisionPadding { get; set; }

    [Parameter]
    public string? CollisionBoundarySelector { get; set; }

    [Parameter]
    public IReadOnlyList<string>? CollisionBoundarySelectors { get; set; }

    [Parameter]
    public string Sticky { get; set; } = "partial";

    [Parameter]
    public PopperUpdatePositionStrategy UpdatePositionStrategy { get; set; } = PopperUpdatePositionStrategy.Optimized;

    [Parameter]
    public bool HideWhenDetached { get; set; }

    [Parameter]
    public EventCallback OnPlaced { get; set; }

    [Parameter]
    public EventCallback<BradixPopperPlacementEventArgs> OnPlacementChanged { get; set; }

    [Parameter]
    public ElementReference Anchor { get; set; }

    [Parameter]
    public bool UseAnchor { get; set; }

    [Parameter]
    public string? AnchorSelector { get; set; }

    internal string PlacedSide => _placedSide;
    internal double? ArrowX => _arrowX;
    internal double? ArrowY => _arrowY;
    internal bool ShouldHideArrow => _hideArrow;

    private Dictionary<string, object> ContentAttributes => BuildAttributes(
        ("data-side", _placedSide),
        ("data-align", _placedAlign),
        ("style", BuildContentStyle()));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        bool hasExplicitAnchor = UseAnchor;
        bool hasAnchorSelector = !string.IsNullOrWhiteSpace(AnchorSelector);
        bool hasPopperAnchor = Popper?.HasAnchor == true;
        bool hasVirtualAnchor = Popper?.HasVirtualAnchor == true;
        bool hasElementAnchor = hasExplicitAnchor || hasPopperAnchor;

        if ((!hasElementAnchor && !hasAnchorSelector && Popper is null) || (!hasElementAnchor && !hasAnchorSelector && !hasVirtualAnchor))
        {
            // Anchor registration or new parameters will schedule the next render.
            // Rendering here spins indefinitely when an anchor never arrives.
            return;
        }

        (string Side, double SideOffset, string Align, double AlignOffset, double ArrowPadding, bool AvoidCollisions, double CollisionPadding, string CollisionBoundarySelectors, string Sticky, bool HideWhenDetached, string Dir, string UpdatePositionStrategy) options = CurrentOptions;
        bool hasArrow = !string.IsNullOrEmpty(_arrow.Id);

        if (!_registered.Value)
        {
            _registrationTask ??= Register(hasExplicitAnchor, hasAnchorSelector, hasVirtualAnchor, options, hasArrow);
            await _registrationTask;
            return;
        }

        bool virtualAnchorChanged = hasVirtualAnchor && _lastVirtualAnchor != (Popper!.VirtualAnchorX, Popper.VirtualAnchorY);
        bool anchorSelectorChanged = !string.Equals(_lastAnchorSelector, AnchorSelector, StringComparison.Ordinal);
        bool elementAnchorBecameAvailable = hasElementAnchor && !_lastHadElementAnchor;
        ElementReference currentAnchor = hasExplicitAnchor ? Anchor : Popper?.AnchorElement ?? default;
        bool elementAnchorChanged = hasElementAnchor && !_lastElementAnchor.Equals(currentAnchor);

        if (_lastOptions != options || _lastHadArrow != hasArrow || !_lastArrow.Equals(_arrow) || virtualAnchorChanged || anchorSelectorChanged || elementAnchorBecameAvailable || elementAnchorChanged)
        {
            if (hasVirtualAnchor)
            {
                await PopperInterop.UpdateVirtualPopperContent(_element, _arrow, Popper!.VirtualAnchorX, Popper.VirtualAnchorY, CreateOptionsPayload(options));
                _lastVirtualAnchor = (Popper.VirtualAnchorX, Popper.VirtualAnchorY);
            }
            else if (elementAnchorBecameAvailable || elementAnchorChanged)
            {
                ElementReference anchor = hasExplicitAnchor ? Anchor : Popper!.AnchorElement;
                await PopperInterop.RegisterPopperContent(anchor, _element, _arrow, _dotNetReference!, CreateOptionsPayload(options));
                _lastVirtualAnchor = null;
            }
            else if (!hasElementAnchor && anchorSelectorChanged && hasAnchorSelector)
            {
                await PopperInterop.RegisterPopperContentBySelector(AnchorSelector!, _element, _arrow, _dotNetReference!, CreateOptionsPayload(options));
                _lastVirtualAnchor = null;
            }
            else
            {
                await PopperInterop.UpdatePopperContent(_element, _arrow, CreateOptionsPayload(options));
                _lastVirtualAnchor = null;
            }

            if (_disposed.Read())
                return;

            _lastOptions = options;
            _lastHadArrow = hasArrow;
            _lastHadElementAnchor = hasElementAnchor;
            _lastElementAnchor = currentAnchor;
            _lastArrow = _arrow;
            _lastAnchorSelector = AnchorSelector;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        try
        {
            if (_registrationTask is not null)
                await _registrationTask;

            if (_registered.Value)
                await PopperInterop.UnregisterPopperContent(_element);
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _registered.Value = false;
            // Unregistration cancels scheduled work and drains dispatched callbacks.
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    private async Task Register(bool hasExplicitAnchor, bool hasAnchorSelector, bool hasVirtualAnchor,
        (string Side, double SideOffset, string Align, double AlignOffset, double ArrowPadding, bool AvoidCollisions, double CollisionPadding, string CollisionBoundarySelectors, string Sticky, bool HideWhenDetached, string Dir, string UpdatePositionStrategy) options,
        bool hasArrow)
    {
        _dotNetReference ??= DotNetObjectReference.Create<object>(this);

        if (hasVirtualAnchor)
        {
            await PopperInterop.RegisterVirtualPopperContent(_element, _arrow, _dotNetReference, Popper!.VirtualAnchorX, Popper.VirtualAnchorY, CreateOptionsPayload(options));
            _lastVirtualAnchor = (Popper.VirtualAnchorX, Popper.VirtualAnchorY);
        }
        else if (hasExplicitAnchor || Popper?.HasAnchor == true)
        {
            ElementReference anchor = hasExplicitAnchor ? Anchor : Popper!.AnchorElement;
            await PopperInterop.RegisterPopperContent(anchor, _element, _arrow, _dotNetReference, CreateOptionsPayload(options));
            _lastVirtualAnchor = null;
        }
        else if (hasAnchorSelector)
        {
            await PopperInterop.RegisterPopperContentBySelector(AnchorSelector!, _element, _arrow, _dotNetReference, CreateOptionsPayload(options));
            _lastVirtualAnchor = null;
        }

        if (_disposed.Read())
        {
            await PopperInterop.UnregisterPopperContent(_element);
            return;
        }

        _registered.Value = true;
        _lastOptions = options;
        _lastHadArrow = hasArrow;
        _lastHadElementAnchor = hasExplicitAnchor || Popper?.HasAnchor == true;
        _lastElementAnchor = hasExplicitAnchor ? Anchor : Popper?.AnchorElement ?? default;
        _lastArrow = _arrow;
        _lastAnchorSelector = AnchorSelector;
    }

    internal void RegisterArrow(ElementReference element)
    {
        if (_disposed.Read() || _arrow.Equals(element))
            return;

        _arrow = element;
        _ = RequestRender();
    }

    [JSInvokable]
    public async Task HandlePositionChanged(string side, string align, double left, double top, double availableWidth, double availableHeight, double anchorWidth, double anchorHeight, double? arrowX, double? arrowY, bool shouldHideArrow, bool hidden, string transformOriginX, string transformOriginY, string? zIndex = null)
    {
        if (_disposed.Read())
            return;

        bool unchanged = _isPositioned && _left == left && _top == top && _placedSide == side && _placedAlign == align && _availableWidth == availableWidth && _availableHeight == availableHeight && _anchorWidth == anchorWidth && _anchorHeight == anchorHeight && _arrowX == arrowX && _arrowY == arrowY && _hideArrow == shouldHideArrow && _hidden == hidden && _transformOriginX == transformOriginX && _transformOriginY == transformOriginY && _zIndex == zIndex;

        if (unchanged)
            return;

        bool newlyPlaced = !_isPositioned || _left != left || _top != top || _placedSide != side || _placedAlign != align;

        _placedSide = side;
        _placedAlign = align;
        _left = left;
        _top = top;
        _availableWidth = availableWidth;
        _availableHeight = availableHeight;
        _anchorWidth = anchorWidth;
        _anchorHeight = anchorHeight;
        _arrowX = arrowX;
        _arrowY = arrowY;
        _hideArrow = shouldHideArrow;
        _hidden = hidden;
        _isPositioned = true;
        _positionStyle = null;
        _transformOriginX = transformOriginX;
        _transformOriginY = transformOriginY;
        _zIndex = zIndex;

        await RequestRender();

        if (!newlyPlaced)
            return;

        if (OnPlacementChanged.HasDelegate)
            await OnPlacementChanged.InvokeAsync(new BradixPopperPlacementEventArgs { Side = side, Align = align });

        if (OnPlaced.HasDelegate)
            await OnPlaced.InvokeAsync();
    }

    private string BuildContentStyle()
    {
        return BradixStringCache.MergeStyle(_positionStyle ??= BuildPositionStyle(), Style, ref _mergedStyleCache0)!;
    }

    private string BuildPositionStyle()
    {
        return "position: fixed; left: var(--bradix-popper-left, 0px); top: var(--bradix-popper-top, 0px); min-width: max-content; visibility: var(--bradix-popper-visibility, hidden); pointer-events: var(--bradix-popper-pointer-events, none); z-index: var(--bradix-popper-z-index, auto);";
    }

    private (string Side, double SideOffset, string Align, double AlignOffset, double ArrowPadding, bool AvoidCollisions, double CollisionPadding, string CollisionBoundarySelectors, string Sticky, bool HideWhenDetached, string Dir, string UpdatePositionStrategy) CurrentOptions => (Side.Value, SideOffset, Align.Value, AlignOffset, ArrowPadding, AvoidCollisions, CollisionPadding, CreateBoundarySelectorKey(), NormalizeSticky(Sticky), HideWhenDetached, Direction == "rtl" ? "rtl" : "ltr", UpdatePositionStrategy.Value);

    private static string NormalizeSticky(string? sticky) => string.Equals(sticky, "always", StringComparison.OrdinalIgnoreCase) ? "always" : "partial";

    private string CreateBoundarySelectorKey()
    {
        if (string.IsNullOrWhiteSpace(CollisionBoundarySelector) && CollisionBoundarySelectors is null)
            return _boundarySelectorKey = string.Empty;

        if (BoundarySelectorsMatch())
            return _boundarySelectorKey;

        using var selectors = new PooledStringBuilder();

        if (!string.IsNullOrWhiteSpace(CollisionBoundarySelector))
            selectors.Append(CollisionBoundarySelector);

        if (CollisionBoundarySelectors is not null)
        {
            foreach (string selector in CollisionBoundarySelectors)
            {
                if (string.IsNullOrWhiteSpace(selector))
                    continue;

                if (selectors.Length > 0)
                    selectors.Append('\n');

                selectors.Append(selector);
            }
        }

        return _boundarySelectorKey = selectors.ToString();
    }

    private bool BoundarySelectorsMatch()
    {
        var offset = 0;
        if (!MatchBoundarySelector(CollisionBoundarySelector, ref offset)) return false;
        if (CollisionBoundarySelectors is not null)
        {
            for (var i = 0; i < CollisionBoundarySelectors.Count; i++)
                if (!MatchBoundarySelector(CollisionBoundarySelectors[i], ref offset)) return false;
        }
        return offset == _boundarySelectorKey.Length;
    }

    private bool MatchBoundarySelector(string? selector, ref int offset)
    {
        if (string.IsNullOrWhiteSpace(selector)) return true;
        if (offset > 0 && (offset >= _boundarySelectorKey.Length || _boundarySelectorKey[offset++] != '\n')) return false;
        if (!_boundarySelectorKey.AsSpan(offset).StartsWith(selector, StringComparison.Ordinal)) return false;
        offset += selector.Length;
        return true;
    }

    private static BradixPopperInteropOptions CreateOptionsPayload((string Side, double SideOffset, string Align, double AlignOffset, double ArrowPadding, bool AvoidCollisions, double CollisionPadding, string CollisionBoundarySelectors, string Sticky, bool HideWhenDetached, string Dir, string UpdatePositionStrategy) options)
    {
        return new BradixPopperInteropOptions
        {
            Side = options.Side,
            SideOffset = options.SideOffset,
            Align = options.Align,
            AlignOffset = options.AlignOffset,
            ArrowPadding = options.ArrowPadding,
            AvoidCollisions = options.AvoidCollisions,
            CollisionPadding = options.CollisionPadding,
            CollisionBoundarySelectors = SplitBoundarySelectorKey(options.CollisionBoundarySelectors),
            Sticky = options.Sticky,
            HideWhenDetached = options.HideWhenDetached,
            UpdatePositionStrategy = options.UpdatePositionStrategy,
            Dir = options.Dir
        };
    }

    private static string[] SplitBoundarySelectorKey(string key)
    {
        if (key.Length == 0)
            return [];

        var count = 1;

        for (var i = 0; i < key.Length; i++)
        {
            if (key[i] == '\n')
                count++;
        }

        var selectors = new string[count];
        var selectorStart = 0;
        var selectorIndex = 0;

        for (var i = 0; i <= key.Length; i++)
        {
            if (i < key.Length && key[i] != '\n')
                continue;

            selectors[selectorIndex++] = key[selectorStart..i];
            selectorStart = i + 1;
        }

        return selectors;
    }

}
