@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixPopperAnchor
<div @ref="_element"
     @attributes="AnchorAttributes">
    @ChildContent
</div>

@code {
    private string? _mergedStyleCache0;

    private ElementReference _element;
    private ValueAtomicBool _popperRegistered;
    private ValueAtomicBool _popoverRegistered;

    [CascadingParameter]
    private BradixPopper? Popper { get; set; }

    [CascadingParameter]
    private BradixPopover? Popover { get; set; }

    private Dictionary<string, object> AnchorAttributes => BuildAttributes(
        ("style", BradixStringCache.MergeStyle("display:contents;", Style, ref _mergedStyleCache0)));

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_popperRegistered.Value && Popper is not null)
        {
            Popper.RegisterAnchor(_element);
            _popperRegistered.Value = true;
        }

        if (!_popoverRegistered.Value && Popover is not null)
        {
            Popover.RegisterAnchor(_element);
            _popoverRegistered.Value = true;
        }

        return Task.CompletedTask;
    }
}
