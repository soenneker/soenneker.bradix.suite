@namespace Soenneker.Bradix

@inherits LeptonContentElement

@implements IBradixPopperAnchor
<div @ref="_element"
     @attributes="AnchorAttributes">
    @ChildContent
</div>

@code {
    private ElementReference _element;
    private bool _popperRegistered;
    private bool _popoverRegistered;

    [CascadingParameter]
    private BradixPopper? Popper { get; set; }

    [CascadingParameter]
    private BradixPopover? Popover { get; set; }

    private Dictionary<string, object> AnchorAttributes => BuildAttributes(
        ("style", MergeStyleValues("display:contents;", Style)));

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_popperRegistered && Popper is not null)
        {
            Popper.RegisterAnchor(_element);
            _popperRegistered = true;
        }

        if (!_popoverRegistered && Popover is not null)
        {
            Popover.RegisterAnchor(_element);
            _popoverRegistered = true;
        }

        return Task.CompletedTask;
    }
}
