@namespace Soenneker.Bradix

@inherits LeptonContent

@implements IBradixPopoverAnchor
<BradixDismissableLayerBranch>
    <BradixPopperAnchor>
        @ChildContent
    </BradixPopperAnchor>
</BradixDismissableLayerBranch>

@code {
    private bool _customAnchorRegistered;

    [CascadingParameter]
    private BradixPopover? Popover { get; set; }

    protected override void OnParametersSet()
    {
        if (!_customAnchorRegistered && Popover is not null)
        {
            Popover.AddCustomAnchor();
            _customAnchorRegistered = true;
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_customAnchorRegistered)
            Popover?.RemoveCustomAnchor();

        return ValueTask.CompletedTask;
    }
}
