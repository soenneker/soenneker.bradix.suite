@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@inherits BradixContent

@implements IBradixPopoverAnchor
<BradixDismissableLayerBranch>
    <BradixPopperAnchor>
        @ChildContent
    </BradixPopperAnchor>
</BradixDismissableLayerBranch>

@code {
    private ValueAtomicBool _customAnchorRegistered;

    [CascadingParameter]
    private BradixPopover? Popover { get; set; }

    protected override void OnParametersSet()
    {
        if (!_customAnchorRegistered.Value && Popover is not null)
        {
            Popover.AddCustomAnchor();
            _customAnchorRegistered.Value = true;
        }
    }

    public ValueTask DisposeAsync()
    {
        if (_customAnchorRegistered.Value)
            Popover?.RemoveCustomAnchor();

        return ValueTask.CompletedTask;
    }
}
