@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixPopoverTrigger
<BradixDismissableLayerBranch>
    @if (Popover?.HasCustomAnchor == true)
    {
        <button @ref="_button"
                @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
                @attributes="ButtonAttributes">
            @ChildContent
        </button>
    }
    else
    {
        <BradixPopperAnchor>
            <button @ref="_button"
                    @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
                    @attributes="ButtonAttributes">
                @ChildContent
            </button>
        </BradixPopperAnchor>
    }
</BradixDismissableLayerBranch>

@code {
    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    private ElementReference _button;

    [CascadingParameter]
    private BradixPopover? Popover { get; set; }

    [CascadingParameter]
    private BradixPopper? Popper { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string ResolvedTriggerId => string.IsNullOrWhiteSpace(Id) ? Popover?.DefaultTriggerId ?? string.Empty : Id;

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"),
        ("id", ResolvedTriggerId),
        ("aria-haspopup", "dialog"),
        ("aria-expanded", Popover?.CurrentOpen == true ? "true" : "false"),
        ("aria-controls", Popover?.CurrentOpen == true ? Popover.ContentId : null),
        ("data-state", Popover?.CurrentOpen == true ? "open" : "closed"),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? BradixAttributeValues.True : null));

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Popover?.RegisterTrigger(_button, ResolvedTriggerId);
            if (Popover?.HasCustomAnchor != true)
                Popper?.RegisterAnchor(_button);
        }

        if (Popover?.HasCustomAnchor != true && Popper is not null && !Popper.HasAnchor && !Popper.HasVirtualAnchor)
            Popper.RegisterAnchor(_button);

        return Task.CompletedTask;
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);

        if (!Disabled && Popover is not null)
            await Popover.ToggleOpen();
    }
}
