@namespace Soenneker.Bradix

@using Soenneker.Blazor.Utils.Ids

@inherits BradixIdentifiableContentElement

@implements IBradixMenu

@inject IKeyboardModeInterop KeyboardModeInterop
@inject IControlsInterop ControlsInterop
<BradixPopper @ref="_popper">
    <CascadingValue Name="BradixMenuRoot" Value="RootMenu">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</BradixPopper>

@code {
    private readonly BradixCollectionRegistry<IBradixMenuRovingItem> _items = new();
    private readonly BradixTypeaheadBuffer _typeahead = new();
    private BradixPopper? _popper;
    private bool _initialized;
    private bool _focusFirstItemOnOpen;
    private bool _focusContentOnOpen = true;
    private bool? _lastControlledOpen;
    private bool _uncontrolledOpen;

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [CascadingParameter(Name = "BradixMenuRoot")]
    private BradixMenu? RootMenuCandidate { get; set; }

    [Parameter]
    public bool? Open { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnOpenChange { get; set; }

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public bool Modal { get; set; } = true;

    public string? BaseId { get; private set; }

    internal bool CurrentOpen => Open ?? _uncontrolledOpen;

    internal string ContentId => BlazorIdGenerator.Child(BaseId!, "content");

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal BradixMenu RootMenu => RootMenuCandidate ?? this;

    internal string? CurrentTabStopId { get; private set; }

    internal bool IsTypeaheadActive => !string.IsNullOrEmpty(_typeahead.CurrentSearch);

    internal ElementReference TriggerElement { get; private set; }

    internal bool HasTrigger { get; private set; }

    internal ElementReference ContentElement { get; private set; }

    internal bool HasContentElement { get; private set; }

    protected override void OnInitialized()
    {
        BaseId ??= BlazorIdGenerator.New("bradix-menu");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            _uncontrolledOpen = DefaultOpen;
            _initialized = true;
        }

        if (!Open.HasValue)
        {
            _lastControlledOpen = null;
            return;
        }

        bool controlledOpen = Open.Value;

        if (_lastControlledOpen == controlledOpen)
            return;

        if (controlledOpen && !_focusFirstItemOnOpen && _focusContentOnOpen)
            _focusFirstItemOnOpen = await KeyboardModeInterop.IsKeyboardInteractionMode();

        if (!controlledOpen)
        {
            ResetTypeahead();
            _focusFirstItemOnOpen = false;
            _focusContentOnOpen = true;
        }

        _lastControlledOpen = controlledOpen;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (HasTrigger && _popper is not null && !_popper.HasAnchor && !_popper.HasVirtualAnchor)
            _popper.RegisterAnchor(TriggerElement);
    }

    internal bool IsCurrentTabStop(IBradixMenuRovingItem item)
    {
        return string.Equals(CurrentTabStopId, item.TabStopId, StringComparison.Ordinal);
    }

    internal void RegisterItem(IBradixMenuRovingItem item)
    {
        _items.Register(item.TabStopId, item);
        EnsureCurrentTabStopId();

        if (CurrentOpen && _focusFirstItemOnOpen)
            _ = InvokeAsync(FocusFirstItem);
        else
            _ = InvokeAsync(StateHasChanged);
    }

    internal void UnregisterItem(IBradixMenuRovingItem item)
    {
        _items.Unregister(item.TabStopId);
        EnsureCurrentTabStopId();
        _ = InvokeAsync(StateHasChanged);
    }

    internal void SetCurrentTabStop(string? tabStopId)
    {
        if (string.Equals(CurrentTabStopId, tabStopId, StringComparison.Ordinal))
            return;

        CurrentTabStopId = tabStopId;
        _ = InvokeAsync(StateHasChanged);
    }

    internal void ClearCurrentTabStop()
    {
        SetCurrentTabStop(null);
    }

    internal async Task<bool> HandleItemNavigation(IBradixMenuRovingItem item, string key, bool loop)
    {
        int enabledCount = CountEnabledItems(item, out int currentIndex);
        if (enabledCount == 0 || currentIndex < 0)
            return false;

        if (!BradixRovingFocusNavigator.TryGetTargetIndex(key, "vertical", ResolvedDirection, currentIndex, enabledCount, loop, out int targetIndex))
            return false;

        IBradixMenuRovingItem? target = GetEnabledItemAt(targetIndex);
        if (target is null)
            return false;

        CurrentTabStopId = target.TabStopId;
        await target.Focus();
        await InvokeAsync(StateHasChanged);
        return true;
    }

    internal async Task HandleTypeahead(IBradixMenuRovingItem? currentItem, string key)
    {
        string search = _typeahead.Append(key);
        IBradixMenuRovingItem? nextItem = FindNextTypeaheadItem(search, currentItem);

        if (nextItem is null)
            return;

        CurrentTabStopId = nextItem.TabStopId;
        await nextItem.Focus();
        await InvokeAsync(StateHasChanged);
    }

    internal void ResetTypeahead()
    {
        _typeahead.Reset();
    }

    public void SetFocusFirstItemOnOpen(bool value)
    {
        _focusFirstItemOnOpen = value;
    }

    public void SetFocusContentOnOpen(bool value)
    {
        _focusContentOnOpen = value;
    }

    internal bool ConsumeFocusFirstItemOnOpen()
    {
        bool shouldFocusFirstItemOnOpen = _focusFirstItemOnOpen;
        _focusFirstItemOnOpen = false;
        return shouldFocusFirstItemOnOpen;
    }

    internal bool ConsumeFocusContentOnOpen()
    {
        bool shouldFocusContentOnOpen = _focusContentOnOpen;
        _focusContentOnOpen = true;
        return shouldFocusContentOnOpen;
    }

    internal async Task FocusFirstItem()
    {
        IBradixMenuRovingItem? first = GetFirstEnabledItem();
        if (first is null)
        {
            _focusFirstItemOnOpen = true;
            return;
        }

        CurrentTabStopId = first.TabStopId;
        _focusFirstItemOnOpen = false;
        await FocusItem(first);
        await InvokeAsync(StateHasChanged);
    }

    internal async Task FocusLastItem()
    {
        IBradixMenuRovingItem? last = GetLastEnabledItem();
        if (last is null)
            return;

        CurrentTabStopId = last.TabStopId;
        _focusFirstItemOnOpen = false;
        await FocusItem(last);
        await InvokeAsync(StateHasChanged);
    }

    public void RegisterTrigger(ElementReference element)
    {
        TriggerElement = element;
        HasTrigger = true;

        if (_popper is not null && !_popper.HasAnchor && !_popper.HasVirtualAnchor)
            _popper.RegisterAnchor(element);

        _ = InvokeAsync(StateHasChanged);
    }

    internal void RegisterAnchor(ElementReference element)
    {
        _popper?.RegisterAnchor(element);
        _ = InvokeAsync(StateHasChanged);
    }

    internal void RegisterContent(ElementReference element)
    {
        ContentElement = element;
        HasContentElement = true;
    }

    internal void ClearContent(ElementReference element)
    {
        if (!HasContentElement || !string.Equals(ContentElement.Id, element.Id, StringComparison.Ordinal))
            return;

        ContentElement = default;
        HasContentElement = false;
    }

    public async Task FocusTrigger()
    {
        if (!HasTrigger)
            return;

        try
        {
            await ControlsInterop.FocusElementPreventScroll(TriggerElement);
            await ControlsInterop.FocusElementDeferred(TriggerElement);
        }
        catch
        {
        }
    }

    private async Task FocusItem(IBradixMenuRovingItem item)
    {
        if (HasContentElement)
        {
            bool focused = await ControlsInterop.FocusFirstMatchingDescendant(ContentElement, $"[data-bradix-roving-item-id='{item.TabStopId}']");

            if (focused)
                return;
        }

        await item.Focus();
    }

    internal void RegisterVirtualAnchor(double x, double y)
    {
        _popper?.RegisterVirtualAnchor(x, y);
    }

    public async Task SetOpen(bool open)
    {
        if (CurrentOpen == open)
            return;

        if (open && !_focusFirstItemOnOpen && _focusContentOnOpen)
            _focusFirstItemOnOpen = await KeyboardModeInterop.IsKeyboardInteractionMode();

        if (Open is null)
            _uncontrolledOpen = open;

        if (!open)
        {
            ResetTypeahead();
            _focusFirstItemOnOpen = false;
            _focusContentOnOpen = true;
        }

        if (OpenChanged.HasDelegate)
            await OpenChanged.InvokeAsync(open);

        if (OnOpenChange.HasDelegate)
            await OnOpenChange.InvokeAsync(open);

        await InvokeAsync(StateHasChanged);
    }

    public Task ToggleOpen()
    {
        return SetOpen(!CurrentOpen);
    }

    private IBradixMenuRovingItem? GetFirstEnabledItem()
    {
        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            if (!entry.Value.IsDisabled)
                return entry.Value;
        }

        return null;
    }

    private IBradixMenuRovingItem? GetLastEnabledItem()
    {
        IBradixMenuRovingItem? last = null;

        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            if (!entry.Value.IsDisabled)
                last = entry.Value;
        }

        return last;
    }

    private void EnsureCurrentTabStopId()
    {
        IBradixMenuRovingItem? first = null;

        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            if (entry.Value.IsDisabled)
                continue;

            first ??= entry.Value;

            if (CurrentTabStopId is not null && string.Equals(entry.Value.TabStopId, CurrentTabStopId, StringComparison.Ordinal))
                return;
        }

        if (first is null)
        {
            CurrentTabStopId = null;
            return;
        }

        CurrentTabStopId = first.TabStopId;
    }

    private int CountEnabledItems(IBradixMenuRovingItem? current, out int currentIndex)
    {
        currentIndex = -1;
        int count = 0;

        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            if (entry.Value.IsDisabled)
                continue;

            if (ReferenceEquals(entry.Value, current))
                currentIndex = count;

            count++;
        }

        return count;
    }

    private IBradixMenuRovingItem? GetEnabledItemAt(int targetIndex)
    {
        int index = 0;

        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            if (entry.Value.IsDisabled)
                continue;

            if (index == targetIndex)
                return entry.Value;

            index++;
        }

        return null;
    }

    private IBradixMenuRovingItem? FindNextTypeaheadItem(string search, IBradixMenuRovingItem? currentItem)
    {
        int enabledCount = CountEnabledItems(currentItem, out int currentIndex);
        if (enabledCount == 0 || string.IsNullOrEmpty(search))
            return null;

        string normalizedSearch = BradixTypeaheadMatcher.NormalizeSearch(search);
        int startIndex = Math.Max(currentIndex, 0);
        bool excludeCurrentItem = normalizedSearch.Length == 1 && currentItem is not null;
        IBradixMenuRovingItem? nextItem = FindNextTypeaheadItemInRange(normalizedSearch, currentItem, excludeCurrentItem, startIndex, enabledCount)
                                      ?? FindNextTypeaheadItemInRange(normalizedSearch, currentItem, excludeCurrentItem, 0, startIndex);

        return currentItem is not null && ReferenceEquals(nextItem, currentItem) ? null : nextItem;
    }

    private IBradixMenuRovingItem? FindNextTypeaheadItemInRange(string normalizedSearch, IBradixMenuRovingItem? currentItem, bool excludeCurrentItem, int startIndex,
        int endIndex)
    {
        int index = 0;

        foreach (KeyValuePair<string, IBradixMenuRovingItem> entry in _items)
        {
            IBradixMenuRovingItem item = entry.Value;
            if (item.IsDisabled)
                continue;

            if (index >= startIndex && index < endIndex)
            {
                if ((!excludeCurrentItem || !ReferenceEquals(item, currentItem)) &&
                    (item.TextValue ?? string.Empty).StartsWith(normalizedSearch, StringComparison.OrdinalIgnoreCase))
                {
                    return item;
                }
            }

            index++;
        }

        return null;
    }
}
