@namespace Soenneker.Bradix

@inherits BradixIdentifiableContentElement

@implements IBradixMenuRadioGroup
<CascadingValue Value="RadioGroupContext">
    <BradixMenuGroup Id="@Id"
                     Class="@Class"
                     Style="@Style"
                     AdditionalAttributes="@AdditionalAttributes">
        @ChildContent
    </BradixMenuGroup>
</CascadingValue>

@code {
    private bool _initialized;
    private string? _uncontrolledValue;
    private BradixMenuRadioGroupContext? _radioGroupContext;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnValueChange { get; set; }

    private string? CurrentValue => Value ?? _uncontrolledValue;

    private BradixMenuRadioGroupContext RadioGroupContext
    {
        get
        {
            string? currentValue = CurrentValue;

            if (_radioGroupContext is null || !string.Equals(_radioGroupContext.CurrentValue, currentValue, StringComparison.Ordinal) ||
                _radioGroupContext.Disabled != Disabled)
            {
                _radioGroupContext = new BradixMenuRadioGroupContext
                {
                    CurrentValue = currentValue,
                    Disabled = Disabled,
                    SetValue = SetValue
                };
            }

            return _radioGroupContext;
        }
    }

    protected override void OnParametersSet()
    {
        if (_initialized)
            return;

        _uncontrolledValue = DefaultValue;
        _initialized = true;
    }

    private async Task SetValue(string value)
    {
        if (string.Equals(CurrentValue, value, StringComparison.Ordinal))
            return;

        bool isControlled = ValueChanged.HasDelegate;

        if (!isControlled)
            _uncontrolledValue = value;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);

        if (OnValueChange.HasDelegate)
            await OnValueChange.InvokeAsync(value);

        await InvokeAsync(StateHasChanged);
    }
}
