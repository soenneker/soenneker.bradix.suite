@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Atomics.ValueBools

@inherits BradixContentElement

@implements IBradixTooltipTrigger

@inject ITooltipInterop TooltipInterop
<button @ref="_triggerElement"
        @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
        @onpointerenter="(_cachedHandlePointerMoveDelegate ??= HandlePointerMove)"
        @onpointerleave="(_cachedHandlePointerLeaveDelegate ??= HandlePointerLeave)"
        @onmouseenter="(_cachedHandleMouseEnterDelegate ??= HandleMouseEnter)"
        @onmouseleave="(_cachedHandleMouseLeaveDelegate ??= HandleMouseLeave)"
        @onpointerdown="(_cachedHandlePointerDownDelegate ??= HandlePointerDown)"
        @onpointerup="(_cachedHandlePointerUpDelegate ??= HandlePointerUp)"
        @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
        @onblur="(_cachedHandleBlurDelegate ??= HandleBlur)"
        @attributes="TriggerAttributes">
    @ChildContent
</button>

@implements IHandleEvent

@code {
    private System.Func<Task>? _cachedHandleClickDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerMoveDelegate;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerLeaveDelegate;
    private System.Func<Task>? _cachedHandleMouseEnterDelegate;
    private System.Func<Task>? _cachedHandleMouseLeaveDelegate;
    private System.Action<PointerEventArgs>? _cachedHandlePointerDownDelegate;
    private System.Action<PointerEventArgs>? _cachedHandlePointerUpDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<FocusEventArgs, Task>? _cachedHandleBlurDelegate;

    // State changes render through the owning context or the explicit focus handlers.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    private ValueAtomicBool _disposed;
    private Task? _registrationTask;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _hasPointerMoveOpened;
    private ValueAtomicBool _pointerDown;
    private ElementReference _triggerElement;
    private DotNetObjectReference<BradixTooltipTrigger>? _dotNetReference;

    [CascadingParameter]
    private BradixTooltip? Tooltip { get; set; }

    private Dictionary<string, object> TriggerAttributes => BuildAttributes(
        ("type", "button"),
        ("aria-describedby", Tooltip?.CurrentOpen == true ? Tooltip.ContentId : null),
        ("data-state", Tooltip?.StateAttribute));

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Tooltip is null || _disposed.Read()) return Task.CompletedTask;
        Tooltip.RegisterTrigger(_triggerElement);
        _dotNetReference = DotNetObjectReference.Create(this);
        return _registrationTask = RegisterTrigger();
    }

    private async Task RegisterTrigger()
    {
        await TooltipInterop.RegisterTooltipTrigger(_triggerElement, _dotNetReference!);
        _registered.Value = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue()) return;
        try
        {
            if (_registrationTask is not null) await _registrationTask;
            if (_registered.Value) await TooltipInterop.UnregisterTooltipTrigger(_triggerElement);
        }
        finally
        {
            _registered.Value = false;
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    private Task HandlePointerMove(PointerEventArgs args)
    {
        if (args.PointerType == "touch" || Tooltip is null || _hasPointerMoveOpened.Value || Tooltip.ShouldBlockTriggerHoverOpen)
            return Task.CompletedTask;

        _hasPointerMoveOpened.Value = true;
        return Tooltip.HandleTriggerEnter();
    }

    private Task HandleMouseEnter()
    {
        return HandleMouseMove();
    }

    private Task HandleMouseMove()
    {
        if (Tooltip is null || _hasPointerMoveOpened.Value || Tooltip.ShouldBlockTriggerHoverOpen)
            return Task.CompletedTask;

        _hasPointerMoveOpened.Value = true;
        return Tooltip.HandleTriggerEnter();
    }

    private Task HandleMouseLeave()
    {
        _hasPointerMoveOpened.Value = false;

        if (Tooltip is null)
            return Task.CompletedTask;

        return Tooltip.HandleTriggerLeave();
    }

    private Task HandlePointerLeave(PointerEventArgs args)
    {
        _hasPointerMoveOpened.Value = false;

        if (Tooltip is null)
            return Task.CompletedTask;

        return Tooltip.HandleTriggerLeave();
    }

    private void HandlePointerDown(PointerEventArgs args)
    {
        _pointerDown.Value = true;

        if (Tooltip is not null)
            _ = Tooltip.Close();
    }

    private void HandlePointerUp(PointerEventArgs args)
    {
        _pointerDown.Value = false;
    }

    private Task HandleFocus(FocusEventArgs _)
    {
        return Tooltip is null
            ? Task.CompletedTask
            : Tooltip.HandleTriggerFocus(_pointerDown.Value);
    }

    private Task HandleBlur(FocusEventArgs _)
    {
        return Tooltip is null
            ? Task.CompletedTask
            : Tooltip.HandleTriggerBlur();
    }

    private Task HandleClick()
    {
        _pointerDown.Value = false;

        return Tooltip is null
            ? Task.CompletedTask
            : Tooltip.HandleTriggerClick();
    }

    [JSInvokable]
    public Task HandleDocumentPointerUp()
    {
        _pointerDown.Value = false;
        return Task.CompletedTask;
    }
}
