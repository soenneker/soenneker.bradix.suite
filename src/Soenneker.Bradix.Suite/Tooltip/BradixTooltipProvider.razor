@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using System.Threading

@inherits BradixContent
@implements IBradixTooltipProvider
<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    private CancellationTokenSource? _skipDelayTokenSource;
    private BradixTooltip? _openTooltip;
    private ValueAtomicBool _isOpenDelayed = new(true);
    private ValueAtomicBool _isPointerInTransit;

    [Parameter]
    public int DelayDuration { get; set; } = 700;

    [Parameter]
    public int SkipDelayDuration { get; set; } = 300;

    [Parameter]
    public bool DisableHoverableContent { get; set; }

    internal bool IsOpenDelayed
    {
        get => _isOpenDelayed.Read();
        private set => _isOpenDelayed.Write(value);
    }

    internal bool IsPointerInTransit
    {
        get => _isPointerInTransit.Read();
        private set => _isPointerInTransit.Write(value);
    }

    internal async Task NotifyOpen(BradixTooltip tooltip)
    {
        CancelSkipDelayTimer();
        IsOpenDelayed = false;

        var previous = _openTooltip;
        _openTooltip = tooltip;
        IsPointerInTransit = false;
        if (previous is not null && !ReferenceEquals(previous, tooltip))
            await previous.CloseFromProvider();
    }

    internal void NotifyClose(BradixTooltip tooltip)
    {
        if (!ReferenceEquals(_openTooltip, tooltip)) return;
        _openTooltip = null;
        IsPointerInTransit = false;
        StartSkipDelayTimer();
    }

    internal void SetPointerInTransit(BradixTooltip tooltip, bool inTransit)
    {
        // Grace-area callbacks can arrive after a click closes their tooltip.
        // Only the current owner may change the provider's transit state.
        if (ReferenceEquals(_openTooltip, tooltip))
            IsPointerInTransit = inTransit && tooltip.CurrentOpen;
    }

    internal bool ShouldBlockTriggerHoverOpen(BradixTooltip tooltip)
    {
        return IsPointerInTransit && (_openTooltip is null || ReferenceEquals(_openTooltip, tooltip));
    }

    public ValueTask DisposeAsync()
    {
        CancelSkipDelayTimer();
        _openTooltip = null;
        return ValueTask.CompletedTask;
    }

    private void StartSkipDelayTimer()
    {
        CancelSkipDelayTimer();
        if (SkipDelayDuration == 0)
        {
            IsOpenDelayed = true;
            return;
        }
        _skipDelayTokenSource = new CancellationTokenSource();
        _ = ResetDelayedOpen(_skipDelayTokenSource.Token);
    }

    private async Task ResetDelayedOpen(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(SkipDelayDuration, cancellationToken);
            if (!cancellationToken.IsCancellationRequested) IsOpenDelayed = true;
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void CancelSkipDelayTimer()
    {
        _skipDelayTokenSource?.Cancel();
        _skipDelayTokenSource?.Dispose();
        _skipDelayTokenSource = null;
    }
}
