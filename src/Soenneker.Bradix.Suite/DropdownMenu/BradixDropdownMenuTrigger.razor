@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixIdentifiableContentElement

@implements IBradixDropdownMenuTrigger
@implements IHandleEvent

@inject IDelegatedInteractionInterop DelegatedInteractionInterop
@inject IPopperInterop PopperInterop
<BradixDismissableLayerBranch>
    <BradixMenuAnchor>
        <button @ref="_button"
                @onpointerdown="(_cachedHandlePointerDownDelegate ??= HandlePointerDown)"
                @onclick="(_cachedHandleClickDelegate ??= HandleClick)"
                @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
                @attributes="ButtonAttributes">
            @ChildContent
        </button>
    </BradixMenuAnchor>
</BradixDismissableLayerBranch>

@code {
    private Func<Task>? _focusAfterKeyboardOpen;
    private System.Func<PointerEventArgs, Task>? _cachedHandlePointerDownDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;
    private System.Func<MouseEventArgs, Task>? _cachedHandleClickDelegate;

    // The root owns open state and notifies the trigger through its cascade.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? argument) => callback.InvokeAsync(argument);

    private static readonly string[] PreventDefaultKeys = ["Enter", " ", "Spacebar", "ArrowDown"];

    private ElementReference _button;
    private string _pointerType = string.Empty;
    private ValueAtomicBool _delegatedInteractionRegistered;
    private ValueAtomicBool _disposed;
    private DotNetObjectReference<object>? _dotNetReference;

    [CascadingParameter]
    private BradixDropdownMenu? DropdownMenu { get; set; }

    [CascadingParameter]
    private BradixMenu? Menu { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<ElementReference> OnElementReferenceCaptured { get; set; }

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"),
        ("id", DropdownMenu?.TriggerId),
        ("aria-haspopup", "menu"),
        ("aria-expanded", DropdownMenu?.CurrentOpen == true ? "true" : "false"),
        ("aria-controls", DropdownMenu?.ContentId),
        ("data-state", DropdownMenu?.CurrentOpen == true ? "open" : "closed"),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? BradixAttributeValues.True : null));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;
        if (firstRender)
        {
            Menu?.RegisterTrigger(_button);
            DropdownMenu?.RegisterTrigger(_button);

            if (OnElementReferenceCaptured.HasDelegate)
                await OnElementReferenceCaptured.InvokeAsync(_button);

            if (_disposed.Read())
                return;

            _dotNetReference ??= DotNetObjectReference.Create<object>(this);
            try
            {
                await DelegatedInteractionInterop.RegisterDelegatedInteraction(_button, _dotNetReference, new BradixDelegatedInteractionOptions
                {
                    Pointerdown = new BradixDelegatedEventOptions
                    {
                        CurrentTargetOnly = false,
                        Filter = "primaryMousePointerDown",
                        PreventDefault = true
                    },
                    Keydown = new BradixDelegatedEventOptions
                    {
                        CurrentTargetOnly = true,
                        PreventDefaultKeys = PreventDefaultKeys
                    }
                });
            }
            catch (ObjectDisposedException) when (_disposed.Read())
            {
                // Navigation can dispose the callback while the JavaScript module is loading.
                return;
            }
            if (_disposed.Read())
                await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_button);
            else
                _delegatedInteractionRegistered.Value = true;

            // Load the positioning dependency while the trigger is available,
            // rather than making the first open wait for its scripts.
            if (!_disposed.Read()) await PopperInterop.Initialize();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_delegatedInteractionRegistered.Value)
            {
                _delegatedInteractionRegistered.Value = false;
                await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_button);
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    private async Task HandlePointerDown(PointerEventArgs args)
    {
        _pointerType = args.PointerType ?? string.Empty;
        Menu?.SetFocusFirstItemOnOpen(false);

        if (!Disabled && DropdownMenu is not null && args.Button == 0 && !args.CtrlKey
            && (_pointerType.Length == 0 || _pointerType == "mouse"))
            await DropdownMenu.ToggleOpen();

    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(args);
        if (DropdownMenu is not null && args.Detail == 0)
        {
            await OpenFromKeyboard(toggle: true);
            return;
        }
        if (DropdownMenu is not null && (_pointerType == "touch" || _pointerType == "pen"))
        {
            Menu?.SetFocusFirstItemOnOpen(false);
            await DropdownMenu.ToggleOpen();
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.IsComposing) return Task.CompletedTask;
        if (Disabled || DropdownMenu is null)
            return Task.CompletedTask;

        return args.Key switch
        {
            "Enter" => OpenFromKeyboard(toggle: true),
            " " => OpenFromKeyboard(toggle: true),
            "Spacebar" => OpenFromKeyboard(toggle: true),
            "ArrowDown" => OpenFromKeyboard(toggle: false),
            _ => Task.CompletedTask
        };
    }

    private async Task OpenFromKeyboard(bool toggle)
    {
        _pointerType = string.Empty;
        Menu?.SetFocusFirstItemOnOpen(true);

        if (toggle)
            await DropdownMenu!.ToggleOpen();
        else
            await DropdownMenu!.SetOpen(true);

        Menu?.SetFocusFirstItemOnOpen(true);

        await InvokeAsync(_focusAfterKeyboardOpen ??= FocusAfterKeyboardOpen);
    }

    private async Task FocusAfterKeyboardOpen()
    {
        await Task.Yield();
        if (Menu?.CurrentOpen == true)
            await Menu.FocusFirstItem();
    }
}
