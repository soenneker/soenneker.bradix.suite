@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits LeptonIdentifiableContentElement

@implements IBradixDropdownMenuTrigger

@inject IDelegatedInteractionInterop DelegatedInteractionInterop
<BradixDismissableLayerBranch>
    <BradixMenuAnchor>
        <button @ref="_button"
                @onpointerdown="HandlePointerDown"
                @onpointerdown:preventDefault="PreventTriggerFocusOnOpen"
                @onkeydown="HandleKeyDown"
                @attributes="ButtonAttributes">
            @ChildContent
        </button>
    </BradixMenuAnchor>
</BradixDismissableLayerBranch>

@code {
    private static readonly string[] PreventDefaultKeys = ["Enter", " ", "Spacebar", "ArrowDown"];

    private ElementReference _button;
    private bool _delegatedInteractionRegistered;
    private DotNetObjectReference<object>? _dotNetReference;

    [CascadingParameter]
    private BradixDropdownMenu? DropdownMenu { get; set; }

    [CascadingParameter]
    private BradixMenu? Menu { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public EventCallback<ElementReference> OnElementReferenceCaptured { get; set; }

    // Match Radix trigger semantics: when opening from pointerdown, keep focus
    // off the trigger so the menu content can claim it without competition.
    private bool PreventTriggerFocusOnOpen => !Disabled && DropdownMenu?.CurrentOpen != true;

    private Dictionary<string, object> ButtonAttributes => BuildAttributes(
        ("type", "button"),
        ("id", DropdownMenu?.TriggerId),
        ("aria-haspopup", "menu"),
        ("aria-expanded", DropdownMenu?.CurrentOpen == true ? "true" : "false"),
        ("aria-controls", DropdownMenu?.ContentId),
        ("data-state", DropdownMenu?.CurrentOpen == true ? "open" : "closed"),
        ("data-disabled", Disabled ? string.Empty : null),
        ("disabled", Disabled ? true : null));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Menu?.RegisterTrigger(_button);
            DropdownMenu?.RegisterTrigger(_button);

            if (OnElementReferenceCaptured.HasDelegate)
                await OnElementReferenceCaptured.InvokeAsync(_button);

            _dotNetReference ??= DotNetObjectReference.Create<object>(this);
            await DelegatedInteractionInterop.RegisterDelegatedInteraction(_button, _dotNetReference, new
            {
                keydown = new
                {
                    currentTargetOnly = true,
                    preventDefaultKeys = PreventDefaultKeys
                }
            });
            _delegatedInteractionRegistered = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_delegatedInteractionRegistered)
            await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_button);

        _dotNetReference?.Dispose();
    }

    private async Task HandlePointerDown(PointerEventArgs args)
    {
        Menu?.SetFocusFirstItemOnOpen(false);

        if (!Disabled && DropdownMenu is not null && args.Button == 0 && !args.CtrlKey)
            await DropdownMenu.ToggleOpen();

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(new MouseEventArgs
            {
                Button = args.Button,
                CtrlKey = args.CtrlKey,
                ShiftKey = args.ShiftKey,
                AltKey = args.AltKey,
                MetaKey = args.MetaKey,
                PageX = args.PageX,
                PageY = args.PageY
            });
        }
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Disabled || DropdownMenu is null)
            return Task.CompletedTask;

        return args.Key switch
        {
            "Enter" => OpenFromKeyboard(toggle: true),
            " " => OpenFromKeyboard(toggle: true),
            "Spacebar" => OpenFromKeyboard(toggle: true),
            "ArrowDown" => OpenFromKeyboard(toggle: false),
            _ => Task.CompletedTask
        };
    }

    private async Task OpenFromKeyboard(bool toggle)
    {
        Menu?.SetFocusFirstItemOnOpen(true);

        if (toggle)
            await DropdownMenu!.ToggleOpen();
        else
            await DropdownMenu!.SetOpen(true);

        Menu?.SetFocusFirstItemOnOpen(true);

        await InvokeAsync(async () =>
        {
            await Task.Yield();

            if (Menu?.CurrentOpen == true)
                await Menu.FocusFirstItem();
        });
    }
}
