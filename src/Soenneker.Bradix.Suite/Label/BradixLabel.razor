@namespace Soenneker.Bradix

@using Microsoft.JSInterop
@using Soenneker.Atomics.ValueBools

@inherits BradixComponent

@implements IBradixLabel

@inject ILabelInterop LabelInterop
<label @ref="_element"
       @attributes="LabelAttributes" >
    @ChildContent
</label>

@code {
    private ElementReference _element;
    private DotNetObjectReference<object>? _dotNetReference;
    private Task? _registrationTask;
    private bool _registered;
    private ValueAtomicBool _disposed;

    [Parameter]
    public string? For { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnMouseDown { get; set; }

    private Dictionary<string, object> LabelAttributes => BuildAttributes(("for", For));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed.Read())
            return;

        _registrationTask ??= Register();
        await _registrationTask;
    }

    private async Task Register()
    {
        _dotNetReference ??= DotNetObjectReference.Create<object>(this);
        await LabelInterop.RegisterLabelTextSelectionGuard(_element, _dotNetReference);

        if (_disposed.Read())
        {
            await LabelInterop.UnregisterLabelTextSelectionGuard(_element);
            return;
        }

        _registered = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;

        try
        {
            if (_registrationTask is not null)
                await _registrationTask;

            if (_registered)
                await LabelInterop.UnregisterLabelTextSelectionGuard(_element);
        }
        catch (JSDisconnectedException)
        {
        }

        _registered = false;

        if (_dotNetReference is not null)
            _ = DisposeReferenceLater(_dotNetReference);

        _dotNetReference = null;
    }

    [JSInvokable]
    public Task HandleMouseDownFromJs(BradixDelegatedMouseEvent args)
    {
        if (_disposed.Read())
            return Task.CompletedTask;

        return OnMouseDown.HasDelegate
            ? OnMouseDown.InvokeAsync(new MouseEventArgs
            {
                Detail = args.Detail,
                Button = args.Button,
                CtrlKey = args.CtrlKey,
                ShiftKey = args.ShiftKey,
                AltKey = args.AltKey,
                MetaKey = args.MetaKey
            })
            : Task.CompletedTask;
    }

    private static async Task DisposeReferenceLater(DotNetObjectReference<object> dotNetReference)
    {
        await Task.Delay(5000);
        dotNetReference.Dispose();
    }
}
