@namespace Soenneker.Bradix

@inherits BradixContentElement

@implements IBradixProgress
<CascadingValue Value="this">
    <div @attributes="ProgressAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private BradixDoubleAttribute _maxAttribute;
    private BradixDoubleAttribute _valueAttribute;
    private string? _valueLabel;
    private long _valueLabelBits;
    private System.Globalization.CultureInfo? _valueLabelCulture;
    internal object MaxAttribute => _maxAttribute.Get(ResolvedMax);
    internal object? ValueAttribute => ResolvedValue is double value ? _valueAttribute.Get(value) : null;

    private const int DefaultMax = 100;

    [Parameter]
    public double? Value { get; set; }

    [Parameter]
    public double Max { get; set; } = DefaultMax;

    [Parameter]
    public Func<double, double, string>? GetValueLabel { get; set; }

    internal double ResolvedMax => IsValidMax(Max) ? Max : DefaultMax;

    internal double? ResolvedValue => IsValidValue(Value, ResolvedMax) ? Value : null;

    internal string State => ResolvedValue is null
        ? "indeterminate"
        : ResolvedValue == ResolvedMax
            ? "complete"
            : "loading";

    private string? ValueLabel
    {
        get
        {
            if (ResolvedValue is not double value) return null;
            string? custom = GetValueLabel?.Invoke(value, ResolvedMax);
            if (custom is not null) return custom;
            double percentage = Math.Round((value / ResolvedMax) * 100);
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            long bits = BitConverter.DoubleToInt64Bits(percentage);
            if (!culture.IsReadOnly) return $"{percentage}%";
            if (_valueLabel is null || _valueLabelBits != bits || !ReferenceEquals(_valueLabelCulture, culture))
            {
                _valueLabelBits = bits;
                _valueLabelCulture = culture;
                _valueLabel = $"{percentage}%";
            }
            return _valueLabel;
        }
    }

    private Dictionary<string, object> ProgressAttributes => BuildAttributes(
        ("role", "progressbar"),
        ("aria-valuemax", MaxAttribute),
        ("aria-valuemin", BradixAttributeValues.Zero),
        ("aria-valuenow", ValueAttribute),
        ("aria-valuetext", ValueLabel),
        ("data-state", State),
        ("data-value", ValueAttribute),
        ("data-max", MaxAttribute));

    private static bool IsValidMax(double max)
    {
        return !double.IsNaN(max) && max > 0;
    }

    private static bool IsValidValue(double? value, double max)
    {
        return value is double number && !double.IsNaN(number) && number >= 0 && number <= max;
    }
}
