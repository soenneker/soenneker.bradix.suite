@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using System.Globalization
@using Microsoft.JSInterop

@inherits BradixContentElement

@implements IBradixSlider

@inject IControlsInterop ControlsInterop
<CascadingValue Value="this">
    <span @ref="_element"
          @attributes="RootAttributes">
        @ChildContent
    </span>
</CascadingValue>

@code {
    private readonly List<BradixSliderThumb> _thumbs = [];
    private ValueAtomicBool _disposed;
    private bool _initialized;
    private bool _registered;
    private readonly List<double> _valuesBeforeSlideStart = [];
    private string? _multipleInputName;
    private bool _hasStepDecimalCount;
    private long _stepBits;
    private int _stepDecimalCount;
    private IReadOnlyList<double> _uncontrolledValues = [];
    private ElementReference _element;
    private DotNetObjectReference<object>? _dotNetReference;

    [CascadingParameter(Name = "BradixDirection")]
    private string? CascadedDirection { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Horizontal;

    [Parameter]
    public string? Dir { get; set; }

    [Parameter]
    public double Min { get; set; }

    [Parameter]
    public double Max { get; set; } = 100;

    [Parameter]
    public double Step { get; set; } = 1;

    [Parameter]
    public double MinStepsBetweenThumbs { get; set; }

    [Parameter]
    public IReadOnlyList<double>? Values { get; set; }

    [Parameter]
    public IEnumerable<double>? DefaultValues { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<double>> ValuesChanged { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<double>> OnValuesChange { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<double>> OnValueCommit { get; set; }

    [Parameter]
    public bool Inverted { get; set; }

    [Parameter]
    public string? Form { get; set; }

    internal int CurrentThumbIndex { get; private set; }

    internal string ResolvedDirection => BradixDirection.Resolve(Dir, CascadedDirection);

    internal IReadOnlyList<double> CurrentValues => Values ?? _uncontrolledValues;

    private Dictionary<string, object> RootAttributes => BuildAttributes(
        ("data-orientation", Orientation.Value),
        ("data-disabled", Disabled ? string.Empty : null),
        ("aria-disabled", Disabled ? "true" : "false"),
        ("dir", ResolvedDirection));

    protected override void OnParametersSet()
    {
        Max = Max < Min ? Min : Max;
        Step = Step <= 0 ? 1 : Step;
        MinStepsBetweenThumbs = Math.Max(0, MinStepsBetweenThumbs);

        if (_initialized)
            return;

        _uncontrolledValues = BradixSliderMath.NormalizeValues(DefaultValues, Min, Max);
        _initialized = true;
        CaptureValuesBeforeSlideStart();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read() || !firstRender)
            return;

        _dotNetReference = DotNetObjectReference.Create<object>(this);
        await ControlsInterop.RegisterSliderPointerBridge(_element, _dotNetReference);
        if (_disposed.Read())
        {
            await ControlsInterop.UnregisterSliderPointerBridge(_element);
            return;
        }

        _registered = true;
        await RequestRender();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        try
        {
            if (_registered)
                await ControlsInterop.UnregisterSliderPointerBridge(_element);
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    internal void RegisterThumb(BradixSliderThumb thumb)
    {
        if (_disposed.Read() || _thumbs.Contains(thumb))
            return;

        _thumbs.Add(thumb);
        _ = RequestRender();
    }

    internal void UnregisterThumb(BradixSliderThumb thumb)
    {
        if (_thumbs.Remove(thumb) && !_disposed.Read())
            _ = RequestRender();
    }

    internal int GetThumbIndex(BradixSliderThumb thumb)
    {
        return _thumbs.IndexOf(thumb);
    }

    internal double? GetThumbValue(int index)
    {
        return index >= 0 && index < CurrentValues.Count ? CurrentValues[index] : null;
    }

    internal string? GetThumbInputName(BradixSliderThumb thumb)
    {
        int index = GetThumbIndex(thumb);

        if (index < 0)
            return null;

        if (!string.IsNullOrWhiteSpace(thumb.Name))
            return thumb.Name;

        if (string.IsNullOrWhiteSpace(Name))
            return null;

        return CurrentValues.Count > 1 ? BradixStringCache.Concat(Name, "[]", ref _multipleInputName) : Name;
    }

    internal double GetPercentForValue(double value)
    {
        return BradixSliderMath.ConvertValueToPercentage(value, Min, Max);
    }

    internal double NormalizeStepValue(double value)
    {
        int decimalCount = StepDecimalCount;
        return BradixSliderMath.RoundValue(value, decimalCount);
    }

    internal string FormatStepValue(double value)
    {
        return NormalizeStepValue(value).ToString(CultureInfo.InvariantCulture);
    }

    internal async Task FocusThumb(int index)
    {
        if (index < 0 || index >= _thumbs.Count)
            return;

        await _thumbs[index].Focus();
    }

    internal void HandleThumbFocus(int index)
    {
        if (index >= 0)
            CurrentThumbIndex = index;
    }

    internal async Task HandleThumbKeyDown(int index, KeyboardEventArgs args)
    {
        if (_disposed.Read() || Disabled || index < 0 || index >= CurrentValues.Count)
            return;

        CurrentThumbIndex = index;

        if (args.Key == "Home")
        {
            await UpdateValue(Min, 0, commit: true);
            return;
        }

        if (args.Key == "End")
        {
            await UpdateValue(Max, CurrentValues.Count - 1, commit: true);
            return;
        }

        if (!IsPageKey(args.Key) && !IsArrowKey(args.Key))
            return;

        bool isSkipKey = IsPageKey(args.Key) || (args.ShiftKey && IsArrowKey(args.Key));
        double multiplier = isSkipKey ? 10 : 1;
        int direction = IsBackKey(args.Key) ? -1 : 1;
        double currentValue = CurrentValues[index];
        await UpdateValue(currentValue + (Step * multiplier * direction), index, commit: true);
    }

    [JSInvokable]
    public async Task HandlePointerStart(double xFraction, double yFraction, int thumbIndex)
    {
        if (_disposed.Read() || Disabled)
            return;

        CaptureValuesBeforeSlideStart();

        if (thumbIndex >= 0)
        {
            CurrentThumbIndex = thumbIndex;
            await FocusThumb(thumbIndex);
            return;
        }

        double nextValue = GetValueFromFractions(xFraction, yFraction);
        int closestIndex = BradixSliderMath.GetClosestValueIndex(CurrentValues, nextValue);
        CurrentThumbIndex = closestIndex;
        await UpdateValue(nextValue, closestIndex, commit: false);
    }

    [JSInvokable]
    public Task HandlePointerMove(double xFraction, double yFraction)
    {
        if (_disposed.Read() || Disabled)
            return Task.CompletedTask;

        double nextValue = GetValueFromFractions(xFraction, yFraction);
        return UpdateValue(nextValue, CurrentThumbIndex, commit: false);
    }

    [JSInvokable]
    public async Task HandlePointerEnd()
    {
        if (_disposed.Read() || Disabled || CurrentThumbIndex < 0 || CurrentThumbIndex >= CurrentValues.Count)
            return;

        double previousValue = _valuesBeforeSlideStart.Count > CurrentThumbIndex ? _valuesBeforeSlideStart[CurrentThumbIndex] : CurrentValues[CurrentThumbIndex];
        double nextValue = CurrentValues[CurrentThumbIndex];

        if (previousValue != nextValue && OnValueCommit.HasDelegate)
            await OnValueCommit.InvokeAsync(CopyValues(CurrentValues));
    }

    [JSInvokable]
    public async Task HandlePointerCancel()
    {
        if (_disposed.Read() || Disabled || CurrentThumbIndex < 0 || CurrentThumbIndex >= CurrentValues.Count)
            return;

        if (ValuesEqual(_valuesBeforeSlideStart, CurrentValues))
            return;

        double[] restoredValues = CopyValues(_valuesBeforeSlideStart);

        if (Values is null)
            _uncontrolledValues = restoredValues;

        if (ValuesChanged.HasDelegate)
            await ValuesChanged.InvokeAsync(restoredValues);

        if (OnValuesChange.HasDelegate)
            await OnValuesChange.InvokeAsync(restoredValues);

        await RequestRender();
        await FocusThumb(CurrentThumbIndex);
    }

    private async Task UpdateValue(double value, int atIndex, bool commit)
    {
        if (atIndex < 0 || atIndex >= CurrentValues.Count)
            return;

        int decimalCount = StepDecimalCount;
        double snappedValue = BradixSliderMath.RoundValue(Math.Round((value - Min) / Step) * Step + Min, decimalCount);
        double clampedValue = BradixSliderMath.Clamp(snappedValue, Min, Max);

        double[]? nextValues = BuildChangedValues(CurrentValues, clampedValue, atIndex, MinStepsBetweenThumbs * Step, out int nextIndex);
        if (nextValues is null)
            return;

        CurrentThumbIndex = nextIndex;

        if (Values is null)
            _uncontrolledValues = nextValues;

        if (ValuesChanged.HasDelegate || OnValuesChange.HasDelegate || (commit && OnValueCommit.HasDelegate))
        {
            IReadOnlyList<double> result = CopyValues(nextValues);
            if (ValuesChanged.HasDelegate)
                await ValuesChanged.InvokeAsync(result);

            if (OnValuesChange.HasDelegate)
                await OnValuesChange.InvokeAsync(result);

            if (commit && OnValueCommit.HasDelegate)
                await OnValueCommit.InvokeAsync(result);
        }

        await RequestRender();
        await FocusThumb(CurrentThumbIndex);
    }

    private double GetValueFromFractions(double xFraction, double yFraction)
    {
        double range = Max - Min;

        if (range <= 0)
            return Min;

        if (Orientation == Orientation.Horizontal)
        {
            bool slidingFromLeft = (ResolvedDirection == "ltr" && !Inverted) || (ResolvedDirection == "rtl" && Inverted);
            return slidingFromLeft
                ? Min + (xFraction * range)
                : Max - (xFraction * range);
        }

        bool slidingFromBottom = !Inverted;
        return slidingFromBottom
            ? Max - (yFraction * range)
            : Min + (yFraction * range);
    }

    private bool IsBackKey(string key)
    {
        return Orientation == Orientation.Horizontal
            ? IsHorizontalBackKey(key)
            : IsVerticalBackKey(key);
    }

    private bool IsHorizontalBackKey(string key)
    {
        bool fromLeft = (ResolvedDirection == "ltr" && !Inverted) || (ResolvedDirection == "rtl" && Inverted);

        return key switch
        {
            "Home" or "PageDown" or "ArrowDown" => true,
            "ArrowLeft" => fromLeft,
            "ArrowRight" => !fromLeft,
            _ => false
        };
    }

    private bool IsVerticalBackKey(string key)
    {
        bool fromBottom = !Inverted;

        return key switch
        {
            "Home" or "PageDown" or "ArrowLeft" => true,
            "ArrowDown" => fromBottom,
            "ArrowUp" => !fromBottom,
            _ => false
        };
    }

    private static bool IsPageKey(string key)
    {
        return key is "PageUp" or "PageDown";
    }

    private static bool IsArrowKey(string key)
    {
        return key is "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight";
    }

    private int StepDecimalCount
    {
        get
        {
            long bits = BitConverter.DoubleToInt64Bits(Step);
            if (!_hasStepDecimalCount || _stepBits != bits)
            {
                _stepBits = bits;
                _stepDecimalCount = BradixSliderMath.GetDecimalCount(Step);
                _hasStepDecimalCount = true;
            }
            return _stepDecimalCount;
        }
    }

    private void CaptureValuesBeforeSlideStart()
    {
        _valuesBeforeSlideStart.Clear();
        IReadOnlyList<double> values = CurrentValues;
        for (var i = 0; i < values.Count; i++) _valuesBeforeSlideStart.Add(values[i]);
    }

    private static double[]? BuildChangedValues(IReadOnlyList<double> current, double value, int atIndex, double minimumGap, out int nextIndex)
    {
        double[]? rented = null;
        Span<double> candidate = current.Count <= 64
            ? stackalloc double[current.Count]
            : (rented = System.Buffers.ArrayPool<double>.Shared.Rent(current.Count)).AsSpan(0, current.Count);
        try
        {
            for (var i = 0; i < candidate.Length; i++) candidate[i] = current[i];
            candidate[atIndex] = value;
            candidate.Sort();
            nextIndex = -1;
            if (minimumGap > 0)
            {
                for (var i = 1; i < candidate.Length; i++)
                    if (candidate[i] - candidate[i - 1] < minimumGap) return null;
            }
            var changed = false;
            for (var i = 0; i < candidate.Length; i++)
            {
                if (candidate[i] != current[i]) changed = true;
                if (nextIndex < 0 && candidate[i].Equals(value)) nextIndex = i;
            }
            return changed ? candidate.ToArray() : null;
        }
        finally
        {
            if (rented is not null) System.Buffers.ArrayPool<double>.Shared.Return(rented);
        }
    }

    private static double[] CopyValues(IReadOnlyList<double> values)
    {
        var copy = new double[values.Count];
        for (var i = 0; i < copy.Length; i++) copy[i] = values[i];
        return copy;
    }

    private static bool ValuesEqual(IReadOnlyList<double> left, IReadOnlyList<double> right)
    {
        if (left.Count != right.Count)
            return false;

        for (var i = 0; i < left.Count; i++)
        {
            if (left[i] != right[i])
                return false;
        }

        return true;
    }
}
