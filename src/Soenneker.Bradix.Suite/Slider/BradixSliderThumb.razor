@using Soenneker.Atomics.ValueBools
@namespace Soenneker.Bradix

@using Microsoft.JSInterop

@inherits BradixElement

@implements IBradixSliderThumb

@inject IDelegatedInteractionInterop DelegatedInteractionInterop
@inject IFormInterop FormInterop
@inject IControlsInterop ControlsInterop
@if (RenderDefaultParts)
{
<span style="@WrapperStyle">
    <span @ref="_element"
          @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
          @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
          @attributes="ThumbAttributes">
    </span>

    @if (ShouldRenderBubbleInput && Value is not null)
    {
        <input @ref="_bubbleInputElement"
               @attributes="BubbleInputAttributes" />
    }
</span>
}
else
{
    <CascadingValue Value="this">@ComposedContent</CascadingValue>
}

@code {
    protected virtual bool RenderDefaultParts => true;
    protected virtual RenderFragment? ComposedContent => null;
    internal RenderFragment RenderTrigger(IReadOnlyDictionary<string, object>? attributes = null) => @<span style="@WrapperStyle">
    <span @ref="_element"
          @onfocus="(_cachedHandleFocusDelegate ??= HandleFocus)"
          @onkeydown="(_cachedHandleKeyDownDelegate ??= HandleKeyDown)"
          @attributes="MergePartAttributes(ThumbAttributes, attributes)">
    </span>
</span>;
    internal RenderFragment RenderBubbleInput(IReadOnlyDictionary<string, object>? attributes = null) => @<input @ref="_bubbleInputElement" @attributes="MergePartAttributes(BubbleInputAttributes, attributes)" />;
    internal void ClearBubbleInput()
    {
        _bubbleInputElement = default;
        _hasSyncedBubbleInput.Value = false;
    }
    private static Dictionary<string, object> MergePartAttributes(Dictionary<string, object> defaults, IReadOnlyDictionary<string, object>? attributes)
    {
        if (attributes is not null)
            foreach (var pair in attributes) defaults[pair.Key] = pair.Value;
        return defaults;
    }

    private System.Func<FocusEventArgs, Task>? _cachedHandleFocusDelegate;
    private System.Func<KeyboardEventArgs, Task>? _cachedHandleKeyDownDelegate;

    private static readonly string[] PreventDefaultKeys = ["Home", "End", "PageUp", "PageDown", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"];

    private BradixAttributeDictionary? _bubbleAttributes;
    private BradixInvariantDoubleTextCache _minText;
    private BradixInvariantDoubleTextCache _maxText;
    private BradixInvariantDoubleTextCache _valueText;
    private string? _wrapperStyle;
    private (long Percent, string Edge, string Transform, int Direction) _wrapperStyleKey;
    private System.Globalization.CultureInfo? _wrapperStyleCulture;
    private string? _defaultLabel;
    private (int Index, int Count) _defaultLabelKey;
    private System.Globalization.CultureInfo? _defaultLabelCulture;
    private ElementReference _element;
    private ElementReference _bubbleInputElement;
    private long _lastUserChangeVersion;
    private ValueAtomicBool _hasSyncedBubbleInput;
    private bool _isFormControl = true;
    private ValueAtomicBool _formControlStateResolved;
    private double? _lastRenderedValue;
    private double? _lastSyncedBubbleValue;
    private string? _lastResolvedForm;
    private ValueAtomicBool _registered;
    private ValueAtomicBool _disposed;
    private DotNetObjectReference<object>? _dotNetReference;

    [CascadingParameter]
    internal BradixSlider Slider { get; set; } = null!;

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    private int Index => Slider.GetThumbIndex(this);

    private double? Value => Slider.GetThumbValue(Index);

    private string? FormattedValue => Value is double value ? _valueText.Get(Slider.NormalizeStepValue(value)) : null;

    private string? InputName => Slider.GetThumbInputName(this);

    private bool ShouldRenderBubbleInput => _isFormControl || !string.IsNullOrWhiteSpace(Slider.Form);

    private string? DefaultLabel
    {
        get
        {
            var key = (Index, Slider.CurrentValues.Count);
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            if (!culture.IsReadOnly) return BradixSliderMath.GetThumbLabel(key.Item1, key.Item2);
            if (_defaultLabelCulture is null || _defaultLabelKey != key || !ReferenceEquals(_defaultLabelCulture, culture))
            {
                _defaultLabelKey = key;
                _defaultLabelCulture = culture;
                _defaultLabel = BradixSliderMath.GetThumbLabel(key.Item1, key.Item2);
            }
            return _defaultLabel;
        }
    }

    private string WrapperStyle
    {
        get
        {
            if (Value is null)
            {
                return "display: none;";
            }

            double percent = Slider.GetPercentForValue(Value.Value);
            string startEdge;
            string transform;
            var direction = 1;

            if (Slider.Orientation == Orientation.Horizontal)
            {
                bool fromLeft = (Slider.ResolvedDirection == "ltr" && !Slider.Inverted) || (Slider.ResolvedDirection == "rtl" && Slider.Inverted);
                startEdge = fromLeft ? "left" : "right";
                transform = "translateX(-50%)";
                direction = fromLeft ? 1 : -1;
            }
            else
            {
                bool fromBottom = !Slider.Inverted;
                startEdge = fromBottom ? "bottom" : "top";
                transform = "translateY(50%)";
                direction = fromBottom ? 1 : -1;
            }

            var key = (BitConverter.DoubleToInt64Bits(percent), startEdge, transform, direction);
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            if (culture.IsReadOnly && _wrapperStyle is not null && _wrapperStyleKey == key && ReferenceEquals(_wrapperStyleCulture, culture))
                return _wrapperStyle;

            var percentText = percent.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var style = $"--bradix-slider-thumb-percent: {percentText}; --bradix-slider-thumb-direction: {direction}; position: absolute; {startEdge}: calc({percentText}% + var(--bradix-slider-thumb-in-bounds-offset, 0px)); transform: {transform};";
            if (culture.IsReadOnly)
            {
                _wrapperStyleKey = key;
                _wrapperStyleCulture = culture;
                _wrapperStyle = style;
            }
            return style;
        }
    }

    private Dictionary<string, object> ThumbAttributes
    {
        get
        {
            Dictionary<string, object> attributes = BuildAttributes(
                ("role", "slider"),
                ("aria-label", AriaLabel ?? DefaultLabel),
                ("aria-valuemin", _minText.Get(Slider.Min)),
                ("aria-valuenow", FormattedValue),
                ("aria-valuemax", _maxText.Get(Slider.Max)),
                ("aria-orientation", Slider.Orientation.Value),
                ("aria-disabled", Slider.Disabled ? "true" : null),
                ("data-orientation", Slider.Orientation.Value),
                ("data-disabled", Slider.Disabled ? string.Empty : null),
                ("tabindex", Slider.Disabled ? null : BradixAttributeValues.Zero),
                ("style", Value is null ? "display: none;" : null));

            if (Slider.Disabled)
                attributes["tabindex"] = BradixAttributeValues.MinusOne;

            return attributes;
        }
    }

    private Dictionary<string, object> BubbleInputAttributes
    {
        get
        {
            Dictionary<string, object> attributes = (_bubbleAttributes ??= new BradixAttributeDictionary()).Create(null, 4);
            attributes["style"] = "display:none;";
            attributes["value"] = FormattedValue ?? string.Empty;

            if (InputName is not null)
                attributes["name"] = InputName;

            if (!string.IsNullOrWhiteSpace(Slider.Form))
                attributes["form"] = Slider.Form;

            return attributes;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed.Read())
            return;

        if (!_registered.Value && !string.IsNullOrEmpty(_element.Id))
        {
            Slider.RegisterThumb(this);
            _registered.Value = true;
            _dotNetReference = DotNetObjectReference.Create<object>(this);
            await DelegatedInteractionInterop.RegisterDelegatedInteraction(_element, _dotNetReference, new BradixDelegatedInteractionOptions
            {
                Keydown = new BradixDelegatedEventOptions
                {
                    CurrentTargetOnly = true,
                    PreventDefaultKeys = PreventDefaultKeys
                }
            });
            if (_disposed.Read())
            {
                await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_element);
                return;
            }

            _lastRenderedValue = Value;
        }

        if (!_formControlStateResolved.Value || !string.Equals(_lastResolvedForm, Slider.Form, StringComparison.Ordinal))
        {
            bool isFormControl = await FormInterop.IsFormControl(_element, Slider.Form);
            if (_disposed.Read())
                return;

            _formControlStateResolved.Value = true;
            _lastResolvedForm = Slider.Form;

            if (_isFormControl != isFormControl)
            {
                _isFormControl = isFormControl;
                await RequestRender();
                return;
            }
        }

        if (ShouldRenderBubbleInput && Value is not null && !string.IsNullOrEmpty(_bubbleInputElement.Id))
        {
            double normalizedValue = Slider.NormalizeStepValue(Value.Value);

            if (!_hasSyncedBubbleInput.Value || _lastSyncedBubbleValue != normalizedValue)
            {
                bool dispatchEvent = _hasSyncedBubbleInput.Value && _lastRenderedValue != Value &&
                    _lastUserChangeVersion != Slider.UserChangeVersion && Slider.IsUserValue(Value.Value, Slider.GetThumbIndex(this));
                if (dispatchEvent) _lastUserChangeVersion = Slider.UserChangeVersion;
                await ControlsInterop.SyncSliderBubbleInputValue(_bubbleInputElement, normalizedValue, dispatchEvent);
                _lastSyncedBubbleValue = normalizedValue;
            }

            _hasSyncedBubbleInput.Value = true;
        }
        else
        {
            _hasSyncedBubbleInput.Value = false;
            _lastSyncedBubbleValue = null;
        }

        _lastRenderedValue = Value;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed.TrySetTrue())
            return;
        if (_registered.Value)
            Slider.UnregisterThumb(this);

        try
        {
            await DelegatedInteractionInterop.UnregisterDelegatedInteraction(_element);
        }
        finally
        {
            _dotNetReference?.Dispose();
            _dotNetReference = null;
        }
    }

    internal ValueTask Focus() => _element.FocusAsync();

    private Task HandleFocus(FocusEventArgs _)
    {
        Slider.HandleThumbFocus(Index);
        return Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.IsComposing) return Task.CompletedTask;
        return Slider.HandleThumbKeyDown(Index, args);
    }
}
