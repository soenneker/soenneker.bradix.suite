<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="FixtureHost.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Playwrights.Extensions.TestPages" Version="4.0.112" />
<PackageReference Include="Soenneker.Playwrights.Tests.Unit" Version="4.0.390" />
<PackageReference Include="TUnit" Version="1.76.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
</Project>

