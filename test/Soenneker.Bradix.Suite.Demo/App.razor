<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>

        <LayoutView Layout="@typeof(MainLayout)">
            <BradixSeoHead Title="Page not found | Bradix" Description="This page could not be found. Browse the Bradix Blazor primitive documentation." NoIndex="true" />
            <section class="stack">
                <div class="card stack stack--compact" role="alert">
                    <p class="eyebrow">Not found</p>
                    <h1>That page does not exist.</h1>
                    <p class="lede">Use the sidebar catalog to jump back into the component library and continue exploring the Bradix suite.</p>
                    <NavLink class="demo-link" href="@DemoCatalog.Overview.Href" Match="NavLinkMatch.All">Return to overview</NavLink>
                </div>
            </section>
        </LayoutView>
    </NotFound>
</Router>
