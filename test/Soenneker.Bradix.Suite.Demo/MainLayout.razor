@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IThemeInterop Theme

<Div Class="@(_showTests ? "bradix-docs show-test-scenarios" : "bradix-docs")">
    <Anchor Href="#main-content" Class="skip-link">Skip to content</Anchor>
    <header class="bradix-header">
        <Anchor Href="/" Class="bradix-brand"><Span Class="bradix-mark" aria-hidden="true">b.</Span> Bradix <Span Class="brand-caption">/ primitives</Span></Anchor>
        <Div Class="bradix-header-actions">
            <HeaderSearch />
            <Anchor Href="https://github.com/soenneker/soenneker.bradix.suite" Class="header-link">GitHub ↗</Anchor>
            <Button Variant="ButtonVariant.Ghost" OnClick="ToggleTheme" aria-label="Toggle theme">@(_isDark ? "Light" : "Dark")</Button>
            <Button Variant="ButtonVariant.Outline" Class="mobile-menu" OnClick="ToggleMenu" aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="component-navigation">Components</Button>
        </Div>
    </header>
    <Div Class="bradix-frame">
        <aside id="component-navigation" class="@(_menuOpen ? "bradix-sidebar is-open" : "bradix-sidebar")" aria-label="Component navigation">
            <nav aria-label="Bradix primitives">
                <NavLink href="/" Match="NavLinkMatch.All" class="bradix-nav-link">Overview</NavLink>
                @foreach (DemoPageGroup group in DemoCatalog.Groups)
                {
                    <Div Class="bradix-nav-group">
                        <H3>@group.Title</H3>
                        @foreach (DemoPageLink demoPage in group.Pages)
                        {
                            <NavLink href="@demoPage.Href" class="bradix-nav-link">@demoPage.Title</NavLink>
                        }
                    </Div>
                }
            </nav>
            <Paragraph Class="sidebar-note">Built with <Anchor Href="https://quark.soenneker.com">Quark Suite ↗</Anchor></Paragraph>
        </aside>
        <main id="main-content" class="bradix-main" tabindex="-1">
            @if (_currentPage is not null && _currentPage.Route != "/")
            {
                <Div Class="bradix-page-heading">
                    <Span Class="docs-kicker">COMPONENTS</Span>
                    <H1>Blazor @_currentPage.Title</H1>
                    <Paragraph>@_currentPage.Description</Paragraph>
                </Div>
            }
            @Body
            <footer class="bradix-footer">Bradix · Blazor primitives based on <Anchor Href="https://www.radix-ui.com/primitives">Radix UI</Anchor>.</footer>
        </main>
    </Div>
</Div>

@code {
    private DemoPageLink? _currentPage;
    private bool _menuOpen;
    private bool _isDark;
    private bool _showTests;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        UpdatePage();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _isDark = await Theme.Initialize();
        StateHasChanged();
    }

    private async Task ToggleTheme() { _isDark = await Theme.Toggle(); }
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _menuOpen = false;
        UpdatePage();
        InvokeAsync(StateHasChanged);
    }
    private void UpdatePage()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        _currentPage = DemoCatalog.Find(DemoCatalog.NormalizeRoute(path));
        _showTests = path.Contains("testScenarios=true", StringComparison.OrdinalIgnoreCase);
    }
    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
