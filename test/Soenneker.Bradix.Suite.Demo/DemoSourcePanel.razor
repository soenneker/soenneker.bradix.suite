@inject HttpClient Http

@if (!string.IsNullOrWhiteSpace(_source))
{
    <section class="demo-source" aria-labelledby="demo-source-heading">
        <header class="demo-source__header">
            <div class="demo-source__tabs" role="tablist" aria-label="Example source files">
                <span class="demo-source__tab" aria-selected="true" role="tab">@_fileName</span>
            </div>
            <span class="demo-source__copy" aria-label="Copy source code">Copy</span>
        </header>

        <pre class="demo-source__pre"><code>@_source</code></pre>
        <div class="demo-source__expand" aria-hidden="true">
            <span>Expand code</span>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Route { get; set; }

    private string? _source;
    private string? _fileName;
    private string? _loadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        string normalizedRoute = DemoCatalog.NormalizeRoute(Route);

        if (normalizedRoute == "/" || string.Equals(_loadedRoute, normalizedRoute, StringComparison.Ordinal))
            return;

        _loadedRoute = normalizedRoute;
        _source = null;
        _fileName = GetFileName(normalizedRoute);

        try
        {
            string source = await Http.GetStringAsync($"_sources/{_fileName}.txt");
            _source = NormalizeSource(source);
        }
        catch (HttpRequestException)
        {
            _source = null;
        }
    }

    private static string GetFileName(string route)
    {
        string normalized = DemoCatalog.NormalizeRoute(route);

        if (_routeFileNames.TryGetValue(normalized, out string? fileName))
            return fileName;

        string pageName = string.Concat(normalized.Trim('/').Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(static segment => char.ToUpperInvariant(segment[0]) + segment[1..]));

        return $"{pageName}.razor";
    }

    private static readonly IReadOnlyDictionary<string, string> _routeFileNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["/accessibleicons"] = "AccessibleIcons.razor",
        ["/accordions"] = "Accordions.razor",
        ["/alertdialogs"] = "AlertDialogs.razor",
        ["/aspectratios"] = "AspectRatios.razor",
        ["/avatars"] = "Avatars.razor",
        ["/checkboxes"] = "Checkboxes.razor",
        ["/collapsibles"] = "Collapsibles.razor",
        ["/collections"] = "Collections.razor",
        ["/contextmenus"] = "ContextMenus.razor",
        ["/dialogs"] = "Dialogs.razor",
        ["/dismissablelayers"] = "DismissableLayers.razor",
        ["/dropdownmenus"] = "DropdownMenus.razor",
        ["/focusguards"] = "FocusGuards.razor",
        ["/focusscopes"] = "FocusScopes.razor",
        ["/forms"] = "Forms.razor",
        ["/hovercards"] = "HoverCards.razor",
        ["/labels"] = "Labels.razor",
        ["/menubars"] = "Menubars.razor",
        ["/menus"] = "Menus.razor",
        ["/navigationmenus"] = "NavigationMenus.razor",
        ["/navigationmenuinline"] = "NavigationMenuInline.razor",
        ["/navigationmenuminimal"] = "NavigationMenuMinimal.razor",
        ["/navigationmenuuncontrolled"] = "NavigationMenuUncontrolled.razor",
        ["/onetimepasswordfields"] = "OneTimePasswordFields.razor",
        ["/popovers"] = "Popovers.razor",
        ["/poppers"] = "Poppers.razor",
        ["/portals"] = "Portals.razor",
        ["/presences"] = "Presences.razor",
        ["/progresses"] = "Progresses.razor",
        ["/radiogroups"] = "RadioGroups.razor",
        ["/removescrolls"] = "RemoveScrolls.razor",
        ["/scrollareas"] = "ScrollAreas.razor",
        ["/selects"] = "Selects.razor",
        ["/separators"] = "Separators.razor",
        ["/sliders"] = "Sliders.razor",
        ["/slots"] = "Slots.razor",
        ["/switches"] = "Switches.razor",
        ["/tabs"] = "Tabs.razor",
        ["/toasts"] = "Toasts.razor",
        ["/toggles"] = "Toggles.razor",
        ["/togglegroups"] = "ToggleGroups.razor",
        ["/toolbars"] = "Toolbars.razor",
        ["/tooltips"] = "Tooltips.razor",
        ["/visuallyhidden"] = "VisuallyHidden.razor"
    };

    private static string NormalizeSource(string source)
    {
        source = source.Replace("\r\n", "\n", StringComparison.Ordinal);
        List<string> lines = source.Split('\n').ToList();

        lines.RemoveAll(static line =>
            line.StartsWith("@page ", StringComparison.Ordinal) ||
            line.StartsWith("<PageTitle>", StringComparison.Ordinal));

        while (lines.Count > 0 && string.IsNullOrWhiteSpace(lines[0]))
        {
            lines.RemoveAt(0);
        }

        string text = string.Join('\n', lines).TrimEnd();
        const string wrapper = "<section class=\"website-demo-page\">";
        int codeIndex = text.IndexOf("\n@code", StringComparison.Ordinal);
        string markup = codeIndex >= 0 ? text[..codeIndex] : text;
        string code = codeIndex >= 0 ? text[codeIndex..] : "";

        if (markup.TrimStart().StartsWith(wrapper, StringComparison.Ordinal))
        {
            List<string> markupLines = markup.Split('\n').ToList();
            int wrapperIndex = markupLines.FindIndex(static line => line.Trim() == wrapper);

            if (wrapperIndex >= 0)
            {
                markupLines.RemoveAt(wrapperIndex);
                int firstCardIndex = markupLines.FindIndex(static line => line.Contains("website-demo-card", StringComparison.Ordinal));
                int closingIndex = firstCardIndex >= 0 ? FindSectionClose(markupLines, firstCardIndex) : markupLines.FindLastIndex(static line => line.Trim() == "</section>");

                if (closingIndex >= 0)
                {
                    markupLines = markupLines
                        .Take(closingIndex + 1)
                        .ToList();
                }

                for (int i = 0; i < markupLines.Count; i++)
                {
                    if (markupLines[i].StartsWith("    ", StringComparison.Ordinal))
                    {
                        markupLines[i] = markupLines[i][4..];
                    }
                }

                markup = string.Join('\n', markupLines).Trim();
            }
        }

        return string.IsNullOrWhiteSpace(code)
            ? markup
            : $"{markup}\n{code.TrimEnd()}";
    }

    private static int FindSectionClose(IReadOnlyList<string> lines, int startIndex)
    {
        int depth = 0;

        for (int i = startIndex; i < lines.Count; i++)
        {
            string line = lines[i];

            if (line.Contains("<section", StringComparison.Ordinal))
                depth++;

            if (line.Contains("</section>", StringComparison.Ordinal))
                depth--;

            if (depth == 0)
                return i;
        }

        return -1;
    }
}
