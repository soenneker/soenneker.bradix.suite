<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <QuarkSuiteVersion>4.0.1425</QuarkSuiteVersion>
        <UseLocalQuarkProject Condition="'$(UseLocalQuarkProject)' == ''">false</UseLocalQuarkProject>
        <LocalQuarkProject Condition="'$(LocalQuarkProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\Quark\soenneker.quark.suite\src\Soenneker.Quark.Suite\Soenneker.Quark.Suite.csproj</LocalQuarkProject>
        <TailwindGeneratorBuildEnabled>true</TailwindGeneratorBuildEnabled>
        <TailwindManifestPath Condition="'$(UseLocalQuarkProject)' != 'true'">$(NuGetPackageRoot)soenneker.quark.suite/$(QuarkSuiteVersion)/tailwind/quark-suite-tailwind-manifest.txt</TailwindManifestPath>
        <TailwindManifestPath Condition="'$(UseLocalQuarkProject)' == 'true'">$([System.IO.Path]::GetDirectoryName('$(LocalQuarkProject)'))\tailwind\quark-suite-tailwind-manifest.txt</TailwindManifestPath>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <RazorSitemapBaseUrl>https://bradix.soenneker.com/</RazorSitemapBaseUrl>
        <RazorSitemapOutputPath>wwwroot/sitemap.xml</RazorSitemapOutputPath>
        <RazorSitemapIncludeUnannotatedPages>true</RazorSitemapIncludeUnannotatedPages>
        <RazorSitemapEnabled>true</RazorSitemapEnabled>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <BlazorCacheBootResources>false</BlazorCacheBootResources>
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Gen.Razor.Sitemaps" Version="4.0.125">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Serilog.Sinks.Browser.Blazor" Version="4.0.408" />
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="4.0.255" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Quark.Suite" Version="4.0.1432" Condition="'$(UseLocalQuarkProject)' != 'true'" />
        <ProjectReference Include="$(LocalQuarkProject)" Condition="'$(UseLocalQuarkProject)' == 'true'" />
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind" Version="4.0.259" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Manifest" Version="4.0.247" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Quark.Gen.Themes" Version="4.0.250" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Utils.AutoBogus" Version="4.0.964" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Bradix.Suite\Soenneker.Bradix.Suite.csproj" />
    </ItemGroup>

    <Target Name="CopyDemoRazorSources" BeforeTargets="ResolveProjectStaticWebAssets">
        <ItemGroup>
            <DemoRazorSource Include="Pages\**\*.razor" />
        </ItemGroup>
        <RemoveDir Directories="wwwroot\_sources" />
        <Copy SourceFiles="@(DemoRazorSource)" DestinationFiles="@(DemoRazorSource->'wwwroot\_sources\%(RecursiveDir)%(Filename)%(Extension).txt')" SkipUnchangedFiles="true" />
        <ItemGroup>
            <Content Include="wwwroot\_sources\**\*.razor.txt" />
        </ItemGroup>
    </Target>
</Project>