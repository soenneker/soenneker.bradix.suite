<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Serilog.Sinks.Browser.Blazor" Version="4.0.314" />
        <PackageReference Include="Soenneker.Utils.AutoBogus" Version="4.0.895" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Bradix.Suite\Soenneker.Bradix.Suite.csproj" />
    </ItemGroup>

    <Target Name="CopyDemoRazorSources" BeforeTargets="ResolveProjectStaticWebAssets">
        <ItemGroup>
            <DemoRazorSource Include="Pages\**\*.razor" />
        </ItemGroup>
        <RemoveDir Directories="wwwroot\_sources" />
        <Copy SourceFiles="@(DemoRazorSource)"
              DestinationFiles="@(DemoRazorSource->'wwwroot\_sources\%(RecursiveDir)%(Filename)%(Extension).txt')"
              SkipUnchangedFiles="true" />
        <ItemGroup>
            <Content Include="wwwroot\_sources\**\*.razor.txt" />
        </ItemGroup>
    </Target>
</Project>
