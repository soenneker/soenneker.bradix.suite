@page "/accessibleicons"


<BradixSeoHead Title="Accessible Blazor Icons &amp; Screen Reader Labels | Bradix" Description="Give Blazor icons accessible text labels with Bradix AccessibleIcon. Explore a labeled close icon and the Razor markup for screen reader support." CanonicalPath="/accessibleicons" />

<section class="website-demo-page">
    <DemoExample File="AccessibleIcons.razor" Index="0" Title="Close icon with an accessible label">
    <section class="card website-demo-card stack stack--compact">
        <p class="state-line"><strong>Panel:</strong> @(_panelClosed ? "Closed" : "Open")</p>
            <button type="button"
                    class="primitive__trigger icon-button"
                    @onclick="TogglePanel">
                <BradixAccessibleIcon Label="Close panel">
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
                        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </BradixAccessibleIcon>
            </button>
    </section>
    </DemoExample>
</section>

@code {
    private bool _panelClosed;
    private bool _warningAcknowledged;

    private Task TogglePanel()
    {
        _panelClosed = !_panelClosed;
        return Task.CompletedTask;
    }

    private Task ToggleWarning()
    {
        _warningAcknowledged = !_warningAcknowledged;
        return Task.CompletedTask;
    }
}
