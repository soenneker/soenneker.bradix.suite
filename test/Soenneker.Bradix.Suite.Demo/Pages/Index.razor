@page "/"
@using Soenneker.Bradix.Suite.Demo

<PageTitle>Bradix Component Library</PageTitle>

<section class="overview-page">
    <header class="overview-hero">
        <div class="overview-hero__content">
            <p class="eyebrow">Bradix Suite</p>
            <h1>Bradix primitives</h1>
            <p class="overview-hero__lede">Modern Blazor components for the interaction work that usually gets messy: focus, layering, keyboard behavior, portals, and composed state.</p>

            <div class="overview-hero__actions" aria-label="Featured component demos">
                <NavLink href="/popovers" class="demo-link">Explore overlays</NavLink>
                <NavLink href="/forms" class="demo-link demo-link--subtle">Build forms</NavLink>
                <NavLink href="/navigationmenus" class="demo-link demo-link--subtle">Shape navigation</NavLink>
            </div>
        </div>

        <dl class="overview-proof" aria-label="Bradix library summary">
            <div>
                <dt>@DemoCatalog.ComponentCount</dt>
                <dd>primitives</dd>
            </div>
            <div>
                <dt>5</dt>
                <dd>focused families</dd>
            </div>
            <div>
                <dt>0</dt>
                <dd>design lock-in</dd>
            </div>
        </dl>
    </header>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Use the hard parts without carrying the complexity.</h2>
            <p>Bradix keeps the primitives small and composable while handling the browser details that make production UI brittle.</p>
        </header>

        <div class="overview-value-grid">
            <article class="overview-value">
                <h3>Accessible by default</h3>
                <p>Roving focus, labels, dismissal, modal behavior, and keyboard interactions are built into the primitive instead of rebuilt per feature.</p>
            </article>
            <article class="overview-value">
                <h3>Unstyled composition</h3>
                <p>Bring your own markup, tokens, and layout while keeping the behavior contract stable across the suite.</p>
            </article>
            <article class="overview-value">
                <h3>Blazor-first ergonomics</h3>
                <p>State, events, portals, and JS interop are packaged around normal Razor usage so app code stays direct.</p>
            </article>
        </div>
    </section>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Start with a real interaction.</h2>
            <p>These demos cover the pieces most likely to reveal whether a component library is solid.</p>
        </header>

        <div class="overview-entry-grid">
            <NavLink href="/dialogs" class="overview-entry">
                <span>Dialog</span>
                <span>Modal focus, dismissal, and layered content.</span>
            </NavLink>
            <NavLink href="/popovers" class="overview-entry">
                <span>Popover</span>
                <span>Floating content with collision-aware positioning.</span>
            </NavLink>
            <NavLink href="/selects" class="overview-entry">
                <span>Select</span>
                <span>Keyboard selection without native styling limits.</span>
            </NavLink>
            <NavLink href="/checkboxes" class="overview-entry">
                <span>Checkbox</span>
                <span>Form-ready state with accessible indicators.</span>
            </NavLink>
            <NavLink href="/tabs" class="overview-entry">
                <span>Tabs</span>
                <span>Controlled and uncontrolled panels with roving focus.</span>
            </NavLink>
            <NavLink href="/navigationmenus" class="overview-entry">
                <span>Navigation Menu</span>
                <span>Structured app and website navigation patterns.</span>
            </NavLink>
        </div>
    </section>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Organized around the jobs your UI has to do.</h2>
        </header>

        <div class="overview-category-grid">
            @foreach (DemoPageGroup group in DemoCatalog.Groups)
            {
                <NavLink href="@group.Pages[0].Href" class="overview-category">
                    <span>@group.Title</span>
                    <span>@group.Description</span>
                    <strong>@group.Pages.Count demos</strong>
                </NavLink>
            }
        </div>
    </section>
</section>
