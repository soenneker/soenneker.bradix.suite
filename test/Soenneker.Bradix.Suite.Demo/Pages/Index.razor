@page "/"

<PageTitle>Bradix — Accessible Blazor primitives</PageTitle>
<Div Class="bradix-hero">
    <Span Class="docs-kicker">THE FOUNDATION FOR YOUR DESIGN SYSTEM</Span>
    <H1>Great interfaces.<br />Start with the primitives.</H1>
    <Paragraph>Accessible, unstyled components for Blazor, based on Radix UI primitives. Bring your own design. Bradix takes care of the behavior.</Paragraph>
    <Div Class="hero-actions">
        <Anchor Href="/accordions" Class="primary-link">Explore components <Span aria-hidden="true">→</Span></Anchor>
        <Anchor Href="#installation" Class="secondary-link">Get started</Anchor>
    </Div>
</Div>
<Div Class="feature-grid">
    <Div><Span Class="feature-number">01</Span><H3>Accessible by design</H3><Paragraph>Keyboard navigation, focus management, and ARIA semantics built into the patterns that need them.</Paragraph></Div>
    <Div><Span Class="feature-number">02</Span><H3>Unstyled. On purpose.</H3><Paragraph>Your classes, your tokens, your visual language. A flexible foundation for a design system that feels like you.</Paragraph></Div>
    <Div><Span Class="feature-number">03</Span><H3>Compose with Razor</H3><Paragraph>Small, predictable parts with controlled and uncontrolled state. Adopt one primitive or build with the whole suite.</Paragraph></Div>
</Div>
<Section Class="getting-started">
    <H2>Based on Radix UI. Made for Blazor.</H2>
    <Paragraph>Bradix adapts the component patterns and behavior of <Anchor Href="https://www.radix-ui.com/primitives">Radix UI Primitives</Anchor> to Blazor: composable parts, keyboard navigation, focus management, and controlled or uncontrolled state. You work with Razor components and C# callbacks while keeping full control over styling.</Paragraph>
    <Paragraph>Bradix is an independent project, not an official Radix UI port.</Paragraph>
</Section>
<Section Id="installation" Class="getting-started">
    <H2>Up and running</H2>
    <Paragraph>Install the package, register the suite, and import the components.</Paragraph>
    <CodeViewer Text="@InstallCode" Language="shell" MinLines="1" MaxLines="3" />
    <CodeViewer Text="@SetupCode" Language="csharp" MinLines="2" MaxLines="5" />
    <CodeViewer Text="@ImportCode" Language="razor" MinLines="1" MaxLines="3" />
</Section>
<Section Class="component-directory">
    <Div Class="directory-heading"><H2>Find your building blocks</H2><Paragraph>Live examples. Real Razor. Ready to make your own.</Paragraph></Div>
    @foreach (DemoPageGroup group in DemoCatalog.Groups)
    {
        <H3>@group.Title</H3>
        <Div Class="component-grid">
            @foreach (DemoPageLink demoPage in group.Pages)
            {
                <Anchor Href="@demoPage.Href" Class="component-card"><Strong>@demoPage.Title <Span aria-hidden="true">↗</Span></Strong><Paragraph>@demoPage.Description</Paragraph></Anchor>
            }
        </Div>
    }
</Section>
@code {
    private const string InstallCode = "dotnet add package Soenneker.Bradix.Suite";
    private const string SetupCode = "builder.Services.AddBradixSuiteAsScoped();";
    private const string ImportCode = "@using Soenneker.Bradix";
}
