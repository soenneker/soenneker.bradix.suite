@page "/"
@using Soenneker.Bradix.Suite.Demo

<PageTitle>Bradix Component Library</PageTitle>

<section class="overview-page">
    <header class="overview-hero">
        <div class="overview-hero__content">
            <p class="eyebrow">Overview</p>
            <h1>Bradix primitives</h1>
            <p class="overview-hero__lede">A low-level Blazor component library for building accessible design systems and web apps.</p>
            <p>Bradix primitives focus on behavior, accessibility, composition, and predictable Razor APIs. Use them as the base layer of a design system, or adopt a primitive one at a time.</p>
        </div>
    </header>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Vision</h2>
            <p>Common UI patterns like dialogs, menus, tabs, selects, sliders, and tooltips need consistent keyboard behavior, focus management, roles, and state. Bradix provides those primitives without prescribing your design system.</p>
        </header>
    </section>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Key features</h2>
        </header>

        <div class="overview-feature-list">
            <article>
                <h3>Accessible</h3>
                <p>Components handle roles, aria attributes, focus management, dismissal, and keyboard navigation where the pattern requires it.</p>
            </article>
            <article>
                <h3>Unstyled</h3>
                <p>Primitives ship with behavior, not a visual system. Bring your own classes, tokens, layout, and component wrappers.</p>
            </article>
            <article>
                <h3>Composable</h3>
                <p>Parts expose normal Razor parameters and event callbacks so you can assemble primitives around your app structure.</p>
            </article>
            <article>
                <h3>Controlled or uncontrolled</h3>
                <p>Use internal state for simple cases, or pass explicit state and callbacks when application logic needs control.</p>
            </article>
            <article>
                <h3>Incremental</h3>
                <p>Adopt one primitive at a time. The suite is organized so behavior can be reused without forcing broad UI rewrites.</p>
            </article>
        </div>
    </section>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Install</h2>
        </header>

        <pre class="overview-code"><code>dotnet add package Soenneker.Bradix.Suite</code></pre>
        <pre class="overview-code"><code>@@using Soenneker.Bradix</code></pre>
    </section>

    <section class="overview-section">
        <header class="overview-section__header">
            <h2>Components</h2>
        </header>

        <div class="overview-component-list">
            @foreach (DemoPageGroup group in DemoCatalog.Groups)
            {
                <section>
                    <h3>@group.Title</h3>
                    <div>
                        @foreach (DemoPageLink demoPage in group.Pages)
                        {
                            <NavLink href="@demoPage.Href">@demoPage.Title</NavLink>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
</section>
