@page "/dismissablelayers"


<BradixSeoHead Title="Blazor Dismissable Layer &amp; Outside Click Handling | Bradix" Description="Manage dismissable content in Blazor with Bradix DismissableLayer. Explore outside-interaction dismissal and C# callbacks for custom overlay components." CanonicalPath="/dismissablelayers" />

<section class="website-demo-page">
    <DemoExample File="DismissableLayers.razor" Index="0" Title="Dismiss content on outside interaction">
    <section class="card website-demo-card stack stack--compact">
        <p class="state-line">Dismissed: <strong>@_dismissed</strong></p>
            <BradixDismissableLayer Class="portal-surface"
                                    OnDismiss="HandleDismiss">
                <p>Outside pointer, outside focus, or escape can dismiss this layer.</p>
            </BradixDismissableLayer>
    </section>
    </DemoExample>
</section>

@code {
    private bool _dismissed;

    private Task HandleDismiss()
    {
        _dismissed = true;
        return Task.CompletedTask;
    }
}
