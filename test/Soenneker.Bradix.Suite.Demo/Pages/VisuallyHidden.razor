@page "/visuallyhidden"


<BradixSeoHead Title="Blazor Visually Hidden Text for Screen Readers | Bradix" Description="Add screen-reader text without displaying it visually in Blazor. Explore Bradix VisuallyHidden for accessible descriptions alongside icons and controls." CanonicalPath="/visuallyhidden" />

<section class="website-demo-page">
    <DemoExample File="VisuallyHidden.razor" Index="0" Title="Screen-reader text without visible content">
    <section class="card website-demo-card stack stack--compact">
            <button type="button" class="primitive__trigger icon-button">
                <BradixVisuallyHidden>Save the file</BradixVisuallyHidden>
                <span aria-hidden="true">S</span>
            </button>
    </section>
    </DemoExample>
</section>

@code {
    private readonly IReadOnlyDictionary<string, object> _labelAttributes = new Dictionary<string, object>
    {
        ["for"] = "hidden-search-label",
        ["class"] = "visually-hidden__label"
    };
}
