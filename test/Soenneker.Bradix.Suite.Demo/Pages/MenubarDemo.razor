@page "/menubar"

<PageTitle>Menubar</PageTitle>

<section class="website-demo-page">
    <section class="card website-demo-card" data-testid="bradix-menubar-demo">
        <BradixMenubar Class="menubar-demo__root" Value="@_currentMenu" ValueChanged="HandleCurrentMenuChanged">
                <BradixMenubarMenu Value="file">
                    <BradixMenubarTrigger Class="menubar-demo__trigger">File</BradixMenubarTrigger>
                    <BradixMenubarPortal>
                        <BradixMenubarContent Class="menu-surface" SideOffset="4">
                            <BradixMenubarItem TextValue="New Tab" OnSelect='@(() => SetSelection("New Tab"))'>New Tab <span class="menu-demo__shortcut">⌘ T</span></BradixMenubarItem>
                            <BradixMenubarItem TextValue="New Window" OnSelect='@(() => SetSelection("New Window"))'>New Window <span class="menu-demo__shortcut">⌘ N</span></BradixMenubarItem>
                            <BradixMenubarItem TextValue="New Incognito Window" Disabled>New Incognito Window</BradixMenubarItem>
                            <BradixMenubarSeparator />
                            <BradixMenubarSub>
                                <BradixMenubarSubTrigger TextValue="Share">Share</BradixMenubarSubTrigger>
                                <BradixMenubarPortal>
                                    <BradixMenubarSubContent Class="menu-surface" SideOffset="2">
                                        <BradixMenubarItem TextValue="Copy link" OnSelect='@(() => SetSelection("Copy link"))'>Copy link</BradixMenubarItem>
                                        <BradixMenubarItem TextValue="Email" OnSelect='@(() => SetSelection("Email"))'>Email</BradixMenubarItem>
                                    </BradixMenubarSubContent>
                                </BradixMenubarPortal>
                            </BradixMenubarSub>
                            <BradixMenubarSeparator />
                            <BradixMenubarItem TextValue="Print" OnSelect='@(() => SetSelection("Print"))'>Print... <span class="menu-demo__shortcut">⌘ P</span></BradixMenubarItem>
                        </BradixMenubarContent>
                    </BradixMenubarPortal>
                </BradixMenubarMenu>

                <BradixMenubarMenu Value="edit">
                    <BradixMenubarTrigger Class="menubar-demo__trigger">Edit</BradixMenubarTrigger>
                    <BradixMenubarPortal>
                        <BradixMenubarContent Class="menu-surface" SideOffset="4">
                            <BradixMenubarSub>
                                <BradixMenubarSubTrigger TextValue="Share">Share</BradixMenubarSubTrigger>
                                <BradixMenubarPortal>
                                    <BradixMenubarSubContent Class="menu-surface" SideOffset="4">
                                        <BradixMenubarItem TextValue="Copy link" OnSelect='@(() => SetSelection("Copy link"))'>Copy link</BradixMenubarItem>
                                        <BradixMenubarItem TextValue="Email" OnSelect='@(() => SetSelection("Email"))'>Email</BradixMenubarItem>
                                    </BradixMenubarSubContent>
                                </BradixMenubarPortal>
                            </BradixMenubarSub>
                            <BradixMenubarCheckboxItem Checked="@_lineNumbers"
                                                       CheckedChanged="HandleLineNumbersChanged"
                                                       CloseOnSelect="false">
                                <span>Show line numbers</span>
                                <BradixMenubarItemIndicator>
                                    <span>[x]</span>
                                </BradixMenubarItemIndicator>
                            </BradixMenubarCheckboxItem>
                            <BradixMenubarCheckboxItem Checked="@_wordWrap"
                                                       CheckedChanged="HandleWordWrapChanged"
                                                       CloseOnSelect="false">
                                <span>Word wrap</span>
                                <BradixMenubarItemIndicator>
                                    <span>[x]</span>
                                </BradixMenubarItemIndicator>
                            </BradixMenubarCheckboxItem>
                        </BradixMenubarContent>
                    </BradixMenubarPortal>
                </BradixMenubarMenu>

                <BradixMenubarMenu Value="view">
                    <BradixMenubarTrigger Class="menubar-demo__trigger">View</BradixMenubarTrigger>
                    <BradixMenubarPortal>
                        <BradixMenubarContent Class="menu-surface" SideOffset="4">
                            <BradixMenubarLabel>Sort by</BradixMenubarLabel>
                            <BradixMenubarRadioGroup Value="@_sort" ValueChanged="HandleSortChanged">
                                <BradixMenubarRadioItem Value="name" CloseOnSelect="false">
                                    <span>Name</span>
                                    <BradixMenubarItemIndicator>
                                        <span>(o)</span>
                                    </BradixMenubarItemIndicator>
                                </BradixMenubarRadioItem>
                                <BradixMenubarRadioItem Value="date" CloseOnSelect="false">
                                    <span>Date modified</span>
                                    <BradixMenubarItemIndicator>
                                        <span>(o)</span>
                                    </BradixMenubarItemIndicator>
                                </BradixMenubarRadioItem>
                            </BradixMenubarRadioGroup>
                            <BradixMenubarSeparator />
                            <BradixMenubarItem TextValue="Zoom in" OnSelect='@(() => SetSelection("Zoom in"))'>Zoom in</BradixMenubarItem>
                        </BradixMenubarContent>
                    </BradixMenubarPortal>
                </BradixMenubarMenu>

                <BradixMenubarMenu Value="profiles">
                    <BradixMenubarTrigger Class="menubar-demo__trigger">Profiles</BradixMenubarTrigger>
                    <BradixMenubarPortal>
                        <BradixMenubarContent Class="menu-surface" SideOffset="4">
                            <BradixMenubarRadioGroup Value="@_sort" ValueChanged="HandleSortChanged">
                                <BradixMenubarRadioItem Value="andy" CloseOnSelect="false">
                                    <span>Andy</span>
                                    <BradixMenubarItemIndicator>
                                        <span>(o)</span>
                                    </BradixMenubarItemIndicator>
                                </BradixMenubarRadioItem>
                                <BradixMenubarRadioItem Value="benoit" CloseOnSelect="false">
                                    <span>Benoît</span>
                                    <BradixMenubarItemIndicator>
                                        <span>(o)</span>
                                    </BradixMenubarItemIndicator>
                                </BradixMenubarRadioItem>
                                <BradixMenubarRadioItem Value="luis" CloseOnSelect="false">
                                    <span>Luis</span>
                                    <BradixMenubarItemIndicator>
                                        <span>(o)</span>
                                    </BradixMenubarItemIndicator>
                                </BradixMenubarRadioItem>
                            </BradixMenubarRadioGroup>
                        </BradixMenubarContent>
                    </BradixMenubarPortal>
                </BradixMenubarMenu>
            </BradixMenubar>
    </section>

    <section class="card website-demo-card" data-testid="bradix-menubar-rtl-demo">
        <BradixMenubar Dir="rtl" Class="menubar-demo__root">
            <BradixMenubarMenu Value="file-rtl">
                <BradixMenubarTrigger Class="menubar-demo__trigger">ملف</BradixMenubarTrigger>
                <BradixMenubarPortal>
                    <BradixMenubarContent Class="menu-surface" SideOffset="4">
                        <BradixMenubarItem TextValue="علامة تبويب جديدة">علامة تبويب جديدة</BradixMenubarItem>
                    </BradixMenubarContent>
                </BradixMenubarPortal>
            </BradixMenubarMenu>

            <BradixMenubarMenu Value="view-rtl">
                <BradixMenubarTrigger Class="menubar-demo__trigger">عرض</BradixMenubarTrigger>
                <BradixMenubarPortal>
                    <BradixMenubarContent Class="menu-surface" SideOffset="4">
                        <BradixMenubarItem TextValue="إظهار الشريط الجانبي">إظهار الشريط الجانبي</BradixMenubarItem>
                    </BradixMenubarContent>
                </BradixMenubarPortal>
            </BradixMenubarMenu>
        </BradixMenubar>
    </section>

</section>

@code {
    private string? _currentMenu;
    private string? _selection;
    private BradixCheckboxCheckedState _lineNumbers = BradixCheckboxCheckedState.Checked;
    private BradixCheckboxCheckedState _wordWrap = BradixCheckboxCheckedState.Unchecked;
    private string _sort = "name";

    private Task HandleCurrentMenuChanged(string? value)
    {
        _currentMenu = value;
        return Task.CompletedTask;
    }

    private Task SetSelection(string value)
    {
        _selection = value;
        return Task.CompletedTask;
    }

    private Task HandleLineNumbersChanged(BradixCheckboxCheckedState state)
    {
        _lineNumbers = state;
        return Task.CompletedTask;
    }

    private Task HandleWordWrapChanged(BradixCheckboxCheckedState state)
    {
        _wordWrap = state;
        return Task.CompletedTask;
    }

    private Task HandleSortChanged(string? value)
    {
        _sort = value ?? _sort;
        return Task.CompletedTask;
    }
}
