@page "/passwordtogglefields"

<BradixSeoHead Title="Password Toggle Field | Bradix" Description="Accessible password visibility controls for Blazor." CanonicalPath="/passwordtogglefields" />

<section class="website-demo-page">
    <DemoExample File="PasswordToggleFields.razor" Index="0" Title="Password visibility">
        <section class="card website-demo-card">
            <h2>Password visibility</h2>
            <form @onsubmit:preventDefault>
                <BradixPasswordToggleField>
                    <label for="password-demo">Password</label>
                    <BradixPasswordToggleFieldInput Id="password-demo" Name="password" />
                    <BradixPasswordToggleFieldToggle Id="password-toggle">
                        <BradixPasswordToggleFieldSlot>
                            <Visible>Hide password</Visible>
                            <Hidden>Show password</Hidden>
                        </BradixPasswordToggleFieldSlot>
                    </BradixPasswordToggleFieldToggle>
                </BradixPasswordToggleField>
                <button type="reset">Reset</button>
                <button type="submit">Submit</button>
            </form>
        </section>
    </DemoExample>
</section>
