@page "/avatars"

<PageTitle>Avatar</PageTitle>

<section class="website-demo-page">
    <section class="card website-demo-card">
        <div class="website-demo-row">
            <div class="avatar-demo__case">
                <BradixAvatar Id="avatar-loaded" Class="avatar-demo__root">
                    <BradixAvatarImage Class="avatar-demo__image"
                                       Src="@LoadedAvatarSrc"
                                       Alt="Colm Tuite" />
                    <BradixAvatarFallback Class="avatar-demo__fallback" DelayMs="600">CT</BradixAvatarFallback>
                </BradixAvatar>
            </div>

            <div class="avatar-demo__case">
                <BradixAvatar Id="avatar-pedro" Class="avatar-demo__root">
                    <BradixAvatarImage Class="avatar-demo__image"
                                       Src="@PedroAvatarSrc"
                                       Alt="Pedro Duarte" />
                    <BradixAvatarFallback Class="avatar-demo__fallback" DelayMs="600">JD</BradixAvatarFallback>
                </BradixAvatar>
            </div>

            <div class="avatar-demo__case">
                <BradixAvatar Id="avatar-primary-fallback" Class="avatar-demo__root">
                    <BradixAvatarFallback Class="avatar-demo__fallback">PD</BradixAvatarFallback>
                </BradixAvatar>
            </div>

            <div class="avatar-demo__case avatar-demo__case--test-only">
                <BradixAvatar Id="avatar-delayed" Class="avatar-demo__root">
                    <BradixAvatarFallback Class="avatar-demo__fallback" DelayMs="600">DL</BradixAvatarFallback>
                </BradixAvatar>
            </div>

            <div class="avatar-demo__case avatar-demo__case--test-only">
                <BradixAvatar Id="avatar-broken" Class="avatar-demo__root">
                    <BradixAvatarFallback Class="avatar-demo__fallback" DelayMs="600">BR</BradixAvatarFallback>
                </BradixAvatar>
            </div>

            <div class="avatar-demo__case avatar-demo__case--test-only">
                <BradixAvatar Id="avatar-fallback-only" Class="avatar-demo__root">
                    <BradixAvatarFallback Class="avatar-demo__fallback">PD</BradixAvatarFallback>
                </BradixAvatar>
            </div>
        </div>
    </section>
</section>

@code {
    private const string LoadedAvatarSrc = "https://images.unsplash.com/photo-1492633423870-43d1cd2775eb?&w=128&h=128&dpr=2&q=80";
    private const string PedroAvatarSrc = "https://images.unsplash.com/photo-1511485977113-f34c92461ad9?ixlib=rb-1.2.1&w=128&h=128&dpr=2&q=80";
}
