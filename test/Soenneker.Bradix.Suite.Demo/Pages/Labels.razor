@page "/labels"


<BradixSeoHead Title="Blazor Form Labels for Inputs &amp; Checkboxes | Bradix" Description="Associate accessible labels with Blazor text inputs and checkboxes. See Bradix Label examples using the For attribute to connect labels to form controls." CanonicalPath="/labels" />

<section class="website-demo-page">
    <DemoExample File="Labels.razor" Index="0" Title="Label a text input">
    <section class="card website-demo-card">
        <div class="website-demo-row website-demo-row--padded">
            <BradixLabel Class="label-demo__label" For="firstName">First name</BradixLabel>
            <input class="label-demo__input"
                   type="text"
                   id="firstName"
                   value="Pedro Duarte" />
        </div>
    </section>
    </DemoExample>

    <DemoExample File="Labels.razor" Index="1" Title="Label a checkbox">
    <section class="card website-demo-card">
        <div class="website-demo-row website-demo-row--padded">
            <input id="newsletter"
                   type="checkbox" />
            <BradixLabel Class="label-demo__label" For="newsletter">Email me product updates</BradixLabel>
        </div>
    </section>
    </DemoExample>
</section>
