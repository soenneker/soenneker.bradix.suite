@page "/focusguards"


<BradixSeoHead Title="Blazor Focus Guards for Keyboard Navigation | Bradix" Description="Use Bradix FocusGuards to add focus sentinels around Blazor content. Explore the keyboard-navigation building block used by overlay and portal components." CanonicalPath="/focusguards" />

<section class="website-demo-page">
    <DemoExample File="FocusGuards.razor" Index="0" Title="Focus sentinels around content">
    <section class="card website-demo-card stack stack--compact">
            <button class="primitive__trigger" type="button" @onclick="@(() => _mounted = !_mounted)">
                Toggle guards
            </button>
            <p class="state-line">Mounted: <strong>@_mounted</strong></p>

            @if (_mounted)
            {
                <BradixFocusGuards>
                    <div class="stack stack--compact">
                        <button class="primitive__trigger" type="button">First focus target</button>
                        <button class="primitive__trigger" type="button">Second focus target</button>
                    </div>
                </BradixFocusGuards>
            }
    </section>
    </DemoExample>
</section>

@code {
    private bool _mounted = true;
}
