@page "/removescrolls"


<BradixSeoHead Title="Blazor Body Scroll Lock for Modals &amp; Overlays | Bradix" Description="Lock background scrolling in Blazor while keeping overlay content scrollable. Explore Bradix RemoveScroll with pinch-zoom support and scrollable form content." CanonicalPath="/removescrolls" />

<section class="website-demo-page">
    <DemoExample File="RemoveScrolls.razor" Index="0" Title="Lock background scroll with scrollable content">
    <section class="card website-demo-card stack stack--compact">
            <button class="primitive__trigger" type="button" @onclick="@(() => _mounted = !_mounted)">
                Toggle scroll lock
            </button>
            <p class="state-line">Mounted: <strong>@_mounted</strong></p>

            @if (_mounted)
            {
                <BradixRemoveScroll AllowPinchZoom>
                    <div class="remove-scroll-surface stack stack--compact">
                        <p class="state-line">The page body is scroll-locked while this subtree is mounted.</p>
                        <textarea aria-label="Scrollable field content" class="text-input" rows="4">Scrollable field content</textarea>
                    </div>
                </BradixRemoveScroll>
            }
    </section>
    </DemoExample>
</section>

@code {
    private bool _mounted = true;
}
