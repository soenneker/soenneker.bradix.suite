<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- bUnit WaitForAssertion(Action) requires sync delegates; async lambdas used with awaited TUnit assertions are flagged as async-void. -->
        <NoWarn>$(NoWarn);TUnit0031</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.11.3" />
        <PackageReference Include="TUnit" Version="1.75.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Bradix.Suite\Soenneker.Bradix.Suite.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.JSInterop" Version="10.0.13" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Test" Version="4.0.340" />
        <PackageReference Include="Soenneker.Blazor.MockJsRuntime" Version="4.0.361" />
    </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Soenneker.Utils.File" Version="4.0.2315" />
  </ItemGroup>
</Project>

