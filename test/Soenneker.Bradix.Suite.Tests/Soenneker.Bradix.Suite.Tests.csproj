<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- bUnit WaitForAssertion(Action) requires sync delegates; async lambdas used with awaited TUnit assertions are flagged as async-void. -->
        <NoWarn>$(NoWarn);TUnit0031</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="bunit" Version="2.13.3" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Bradix.Suite\Soenneker.Bradix.Suite.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.JSInterop" Version="11.0.0-rc.3.26522.148" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.Test" Version="11.0.345" />
        <PackageReference Include="Soenneker.Blazor.MockJsRuntime" Version="11.0.365" />
    </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Soenneker.Utils.File" Version="11.0.2328" />
  </ItemGroup>
    <ItemGroup Condition="'$(UseLocalLeptonProject)' == 'true'">
        <ProjectReference Include="..\..\..\..\Lepton\soenneker.lepton.suite\src\Soenneker.Lepton.Gen.Parameters\Soenneker.Lepton.Gen.Parameters.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
</Project>

