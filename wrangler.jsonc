{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "soenneker-bradix-suite",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./artifacts/cloudflare-workers/wwwroot",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "bradix.soenneker.com",
      "custom_domain": true
    }
  ]
}
